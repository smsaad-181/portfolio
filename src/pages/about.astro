---
/**
 * About page — /about/
 * Portrait + three-paragraph bio (who / what I build / what I'm looking for),
 * availability, experience as impact bullets, compact education and
 * certifications, and a link to the Skills page (/skills/).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getProfile } from "../lib/profile";
import { getSkillGroups } from "../lib/skills";
import { pageUrl } from "../lib/urls";
import { personJsonLd, toJsonLd } from "../lib/jsonld";
import { formatTag } from "../lib/tags";
import { formatMonthYear } from "../lib/dates";

const profile = await getProfile();
const { data } = profile;
const experiences = (await getCollection("experience")).sort((a, b) => {
  if (a.data.current !== b.data.current) return a.data.current ? -1 : 1;
  return new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();
});
const educations = (await getCollection("education")).sort((a, b) => b.data.year - a.data.year);
const certs = await getCollection("certifications");
const skillCount = (await getSkillGroups()).reduce((n, g) => n + g.skills.length, 0);

const portraitFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/profile/portrait.{png,webp,avif,jpg,jpeg}", { eager: true });
const portrait = Object.values(portraitFiles)[0]?.default;
const person = await personJsonLd(portrait);

const fmt = formatMonthYear;
const links = [
  data.socialLinks.linkedin && { name: "linkedin" as const, label: "LinkedIn", href: data.socialLinks.linkedin },
  data.socialLinks.github && { name: "github" as const, label: "GitHub", href: data.socialLinks.github },
  data.socialLinks.oshwlab && { name: "oshwlab" as const, label: "OSHWLab", href: data.socialLinks.oshwlab },
].filter((l): l is { name: "linkedin" | "github" | "oshwlab"; label: string; href: string } => Boolean(l));
const bio = data.bio?.length ? data.bio : [data.summary];
---

<BaseLayout title="About" description={`About ${data.name}, ${data.title} in ${data.location}. ${data.summary}`}>
  <script is:inline slot="head" type="application/ld+json" set:html={toJsonLd(person)} />

  <!-- ── Intro ─────────────────────────────────────────────────────────── -->
  <section class="intro" aria-labelledby="about-title">
    <div class="container intro__inner">
      <div class="intro__text">
        <p class="section-label">// about me</p>
        <h1 class="intro__title" id="about-title">{data.name}</h1>
        <p class="intro__role">{data.title} · {data.location}</p>
        {data.availability && (
          <p class="availability"><span class="availability__dot" aria-hidden="true"></span>{data.availability}</p>
        )}
        <div class="intro__bio">
          {bio.map((para) => <p>{para}</p>)}
        </div>
        <ul class="intro__links" role="list" aria-label="Profiles and email">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="pill-link">
                <Icon name={l.name} size={16} />{l.label}<span class="sr-only"> (opens in new tab)</span>
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${data.email}`} class="pill-link"><Icon name="email" size={16} />{data.email}</a>
          </li>
        </ul>
      </div>
      {portrait && (
        <div class="intro__portrait">
          <div class="intro__glow" aria-hidden="true"></div>
          <Image src={portrait} alt={`${data.name}, ${data.title}`} widths={[320, 480, 640, 800]} sizes="(max-width: 900px) 280px, 400px" quality={80} class="intro__photo" loading="eager" fetchpriority="high" />
        </div>
      )}
    </div>
  </section>

  <!-- ── Experience ─────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="experience-heading">
    <div class="container">
      <SectionHeading label="// career" title="Experience" id="experience-heading" />
      <div class="roles">
        {experiences.map((exp) => (
          <article class="role" aria-labelledby={`role-${exp.id}`}>
            <header class="role__head">
              <div>
                <h3 class="role__title" id={`role-${exp.id}`}>{exp.data.role}</h3>
                <p class="role__company">{exp.data.company}</p>
              </div>
              <p class="role__dates">
                <time datetime={exp.data.startDate}>{fmt(exp.data.startDate)}</time>
                {exp.data.current ? <Fragment> – <span class="role__now">Present</span></Fragment> : exp.data.endDate && <Fragment> – <time datetime={exp.data.endDate}>{fmt(exp.data.endDate)}</time></Fragment>}
              </p>
            </header>
            <ul class="role__bullets">
              {exp.data.bullets.map((b) => <li>{b}</li>)}
            </ul>
            {exp.data.tags.length > 0 && (
              <ul class="role__tags" role="list" aria-label="Technologies">
                {exp.data.tags.map((t) => <li>{formatTag(t)}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Education & certifications ─────────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="education-heading">
    <div class="container edu">
      <div>
        <SectionHeading label="// background" title="Education" id="education-heading" />
        <ol class="edu__list" role="list">
          {educations.map((e) => (
            <li class="edu__item">
              <span class="edu__year">{e.data.year}</span>
              <div>
                <p class="edu__degree">{e.data.degree}</p>
                <p class="edu__meta">{e.data.institute}{e.data.group && ` · ${e.data.group}`}</p>
              </div>
              {e.data.result && <span class="edu__result">{e.data.result}</span>}
            </li>
          ))}
        </ol>
      </div>
      {certs.length > 0 && (
        <div>
          <h3 class="edu__subhead">Certifications & training</h3>
          <ul class="certs" role="list">
            {certs.map((c) => (
              <li class="cert">
                <span class="cert__name">{c.data.name}</span>
                {c.data.issuer && <span class="cert__issuer">{c.data.issuer}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- ── Skills moved to their own page ───────────────────────────────── -->
  <section class="section section--compact" aria-label="Skills">
    <div class="container">
      <a href={pageUrl("/skills/")} class="skills-link" data-reveal>
        <span class="skills-link__label">// toolbox</span>
        <span class="skills-link__title">Skills &amp; tools</span>
        <span class="skills-link__text">{skillCount} tools, languages and protocols, from EasyEDA and ESP32 to Modbus, MQTT and LoRaWAN.</span>
        <span class="skills-link__cta">See all skills <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Intro ─────────────────────────────────────────────────────────────── */
  .intro {
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(ellipse 55% 70% at 100% 0%, var(--hero-glow-blue), transparent 70%),
      radial-gradient(ellipse 45% 60% at 0% 100%, var(--hero-glow-pink), transparent 70%);
  }

  .intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  .intro__title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.1;
    margin: var(--space-2) 0 var(--space-2);
    background: var(--gradient-name);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }

  .intro__role {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-surface);
    font-size: var(--fs-14);
    font-weight: 500;
  }

  .availability__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-completed);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-completed) 20%, transparent);
  }

  .intro__bio p {
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 62ch;
    margin: 0 0 var(--space-4);
  }

  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .intro__links li + li {
    margin-top: 0;
  }

  .pill-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-size: var(--fs-14);
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .pill-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .intro__portrait {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .intro__glow {
    position: absolute;
    inset: 10% 8% 0;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 30%, transparent), transparent 65%);
    /* soft via the radial gradient alone (no blur filter: costly on phones) */
    z-index: 0;
  }

  .intro__photo {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    height: auto;
    -webkit-mask-image: linear-gradient(to bottom, var(--text-primary) 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, var(--text-primary) 82%, transparent 100%);
  }

  /* ── Sections ──────────────────────────────────────────────────────────── */
  .section {
    padding-block: var(--space-16);
  }

  .section--alt {
    background: var(--bg-surface);
    border-block: 1px solid var(--border-subtle);
  }

  /* Experience */
  .roles {
    display: grid;
    gap: var(--space-6);
  }

  .role {
    padding: var(--space-6) var(--space-8);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--bg-surface);
  }

  .role__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .role__title {
    font-size: var(--fs-18);
    font-weight: 600;
    margin: 0;
  }

  .role__company {
    margin: var(--space-1) 0 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
  }

  .role__dates {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .role__now {
    color: var(--status-completed);
    font-weight: 600;
  }

  .role__bullets {
    margin: 0 0 var(--space-4);
    max-width: 42rem;
    padding-left: 1.2em;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .role__bullets li + li {
    margin-top: var(--space-1);
  }

  .role__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role__tags li {
    margin: 0;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Education & certifications */
  .edu {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-12);
  }

  .edu__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .edu__list li + li {
    margin-top: 0;
  }

  .edu__item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-base);
  }

  .edu__year {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }

  .edu__degree {
    margin: 0;
    font-weight: 600;
  }

  .edu__meta {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .edu__result {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-primary);
    white-space: nowrap;
  }

  .edu__subhead {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: var(--space-6) 0 var(--space-4);
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .certs li + li {
    margin-top: 0;
  }

  .cert {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-base);
  }

  .cert__name {
    display: block;
    font-weight: 500;
  }

  .cert__issuer {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  /* Link to the Skills page */
  .section--compact {
    padding-block: var(--space-12);
  }

  .skills-link {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 60% 120% at 100% 0%, var(--accent-glow), transparent 70%),
      var(--bg-surface);
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .skills-link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    color: var(--text-primary);
  }

  .skills-link__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .skills-link__title {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .skills-link__text {
    color: var(--text-secondary);
  }

  .skills-link__cta {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .intro__inner,
    .edu {
      grid-template-columns: 1fr;
    }

    .intro__portrait {
      order: -1;
    }

    .intro__photo {
      max-width: 260px;
    }
  }

  @media (max-width: 640px) {
    .role {
      padding: var(--space-4);
    }

    .edu__item {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .edu__result {
      grid-column: 2;
    }
  }
</style>
