# build output
dist/
.astro/

# dependencies
node_modules/

# env — every .env* file is ignored except the committed template
.env*
!.env.example

# editor/OS
.DS_Store
.vscode/*
!.vscode/extensions.json

# Claude Code — personal settings stay local (agents/skills are committed)
.claude/settings.local.json

# Design-review screenshots (npm run screenshots) — regenerate, do not commit
docs/screenshots/

# Local copy of the build tracker (regenerated by Claude) — not part of the site
docs/tracker.html

# 3D conversion tools (installed on demand, see scripts/pcb3d/README.md)
scripts/pcb3d/pcbtools/

# Lighthouse CI reports (CI artifact)
.lighthouseci/
