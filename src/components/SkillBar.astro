---
/**
 * SkillBar.astro
 * Renders a single skill entry with an optional proficiency dot-scale (1–5).
 */
export interface Props {
  name: string;
  proficiency?: number | undefined;
}

const { name, proficiency } = Astro.props;
const dots = proficiency ?? 0;
---

<div class="skill-bar">
  <span class="skill-bar__name">{name}</span>
  {proficiency !== undefined && (
    <span class="skill-bar__dots" aria-label={`Proficiency: ${dots} out of 5`}>
      {Array.from({ length: 5 }, (_, i) => (
        <span
          class:list={["skill-bar__dot", { "skill-bar__dot--filled": i < dots }]}
          aria-hidden="true"
        ></span>
      ))}
    </span>
  )}
</div>

<style>
  .skill-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: border-color 0.15s, color 0.15s;
  }

  .skill-bar:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--text-primary);
  }

  .skill-bar__name {
    font-family: var(--font-mono);
  }

  .skill-bar__dots {
    display: flex;
    gap: 3px;
    flex-shrink: 0;
  }

  .skill-bar__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg-overlay);
    border: 1px solid var(--border);
    transition: background 0.15s, border-color 0.15s;
  }

  .skill-bar__dot--filled {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
