---
/**
 * TagChip.astro
 * Renders a single tag as a small pill. Content stores tags lowercase;
 * formatTag() restores acronyms and part numbers ("iot" → "IoT",
 * "esp32" → "ESP32", "pcb design" → "PCB Design").
 */
import { formatTag } from "../lib/tags";

export interface Props {
  tag: string;
  /** If provided, wraps the chip in a link. */
  href?: string;
}

const { tag, href } = Astro.props;
const displayTag = formatTag(tag);
---

{href ? (
  <a href={href} class="tag-chip tag-chip--link">
    {displayTag}
  </a>
) : (
  <span class="tag-chip">
    {displayTag}
  </span>
)}

<style>
  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2);
    min-height: 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
    text-decoration: none;
  }

  .tag-chip--link:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-glow);
    cursor: pointer;
  }
</style>
