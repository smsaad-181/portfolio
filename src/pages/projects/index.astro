---
/**
 * Projects index — /projects/
 * Page head → "Featured": the first 4 projects (Saad's `order`) as large
 * cards → "All projects": an index table of every published project
 * (Project · Board/MCU · Tags · Versions · →). On phones the table rows
 * stack into compact blocks (no sideways scroll).
 *
 * The Board/MCU cell comes from the project's own `specs` entry labelled
 * "MCU" (shortened to the part name, the full value in sr-only text);
 * without one it stays blank. Each row has one tab stop (the title link,
 * stretched over the row); the arrow is decoration.
 * No status text anywhere (Saad removed the status labels, 27 Nov 2026).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import TagChip from "@components/TagChip.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { getPublishedProjects } from "../../lib/projects";
import { projectUrl } from "../../lib/urls";

const projects = await getPublishedProjects();
const featured = projects.slice(0, 4);

/** "ESP32-S3-WROOM-1-N8R8 (8 MB flash, 8 MB PSRAM)" → "ESP32-S3-WROOM-1-N8R8".
 *  Several parts ("A (V1.0) · B (V1.2)") keep each part name. */
function shortMcu(value: string): string {
  return value
    .split("·")
    .map((part) => part.split("(")[0]!.split(",")[0]!.trim())
    .filter(Boolean)
    .join(" · ");
}

const rows = projects.map((p) => {
  const mcu = p.data.specs.find((s) => s.label.trim().toLowerCase() === "mcu")?.value;
  return {
    title: p.data.title,
    href: projectUrl(p),
    mcu: mcu ? shortMcu(mcu) : "",
    // The full spec, for screen readers when the cell shows a shortened name
    // (a title tooltip would sit under the row's link overlay).
    mcuExtra: mcu && shortMcu(mcu) !== mcu ? mcu : "",
    tags: p.data.tags.slice(0, 3),
    versions: p.data.versions.length > 1 ? p.data.versions.length : 0,
  };
});
---

<BaseLayout
  title="Projects"
  description="Hardware engineering projects — PCB design, embedded systems, IoT builds, and firmware deep-dives."
>
  <header class="page-head container">
    <p class="section-label">// portfolio</p>
    <h1 class="page-title">Projects</h1>
    <p class="page-lead">
      Boards I designed in EasyEDA. Every project has an interactive 3D board.
    </p>
  </header>

  <section class="projects-block container" aria-labelledby="featured-heading">
    <div class="block-head">
      <SectionHeading label="// selected" title="Featured" id="featured-heading" />
      <a href="#all-heading" class="link-arrow block-head__jump">All {projects.length} projects <span class="link-arrow__icon" aria-hidden="true">↓</span></a>
    </div>
    <ul class="projects-grid projects-grid--featured" role="list">
      {featured.map((project, i) => (
        <li class="project-item">
          <ProjectCard
            title={project.data.title}
            href={projectUrl(project)}
            summary={project.data.summary}
            coverImage={project.data.coverImage}
            tags={project.data.tags}
            versions={project.data.versions.map((v) => v.label)}
            priority={i < 2}
            headingLevel={3}
            variant="feature"
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="projects-block projects-block--index container" aria-labelledby="all-heading">
    <SectionHeading label={`// index · ${projects.length} projects`} title="All projects" id="all-heading" />

    <table class="data-table index-table">
      <caption class="sr-only">All {projects.length} projects with their board or microcontroller, technologies and number of board versions</caption>
      <thead>
        <tr>
          <th scope="col">Project</th>
          <th scope="col">Board / MCU</th>
          <th scope="col">Tags</th>
          <th scope="col" class="index-table__num">Versions</th>
          <th scope="col"><span class="sr-only">Link</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="index-table__project">
              <a href={r.href} class="index-table__link">{r.title}</a>
            </th>
            <td class:list={["index-table__mcu", { "index-table__cell--empty": !r.mcu }]}>{r.mcu && <><span class="index-table__key" aria-hidden="true">MCU</span><span aria-hidden={r.mcuExtra ? "true" : undefined}>{r.mcu}</span>{r.mcuExtra && <span class="sr-only">{r.mcuExtra}</span>}</>}</td>
            <td class="index-table__tags">
              <span class="index-table__chips">
                {r.tags.map((t) => <TagChip tag={t} />)}
              </span>
            </td>
            <td class:list={["index-table__num", { "index-table__cell--empty": r.versions === 0 }]}>{r.versions > 0 && <span class="index-table__versions">{r.versions}<span class="index-table__versions-word"> versions</span></span>}</td>
            <td class="index-table__go" aria-hidden="true">
              <span class="index-table__arrow">→</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>

<style>
  /* Tighter head than other pages so the first featured titles show above
     the fold at 1366 × 768. */
  .page-head {
    padding-bottom: var(--space-6);
  }

  /* Featured heading with the "All N projects ↓" jump link on its right */
  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 var(--space-6);
    margin-bottom: var(--space-8);
  }

  .block-head > :global(.section-heading) {
    margin-bottom: 0;
  }

  .block-head__jump {
    flex-shrink: 0;
  }

  .projects-block {
    padding-bottom: var(--space-24);
  }

  /* Featured: two large cards per row (one on phones) */
  .projects-grid--featured {
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(440px, 100%), 1fr));
    row-gap: var(--space-8);
  }

  /* Wide feature plates: a flatter box keeps the titles near the fold
     (renders are contained, never cropped). */
  .projects-grid--featured :global(.project-card__plate) {
    aspect-ratio: 2 / 1;
  }

  /* ── Index table ─────────────────────────────────────────────────────── */
  /* Text lines up with the container edges: no padding on the outer cells. */
  .index-table :is(th, td):first-child {
    padding-left: 0;
  }

  .index-table :is(th, td):last-child {
    padding-right: 0;
  }

  /* Hover: a soft accent band inside the table, title and arrow turn pink */
  .index-table tbody tr:hover {
    background: transparent;
  }

  .index-table tbody tr:hover > * {
    background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
  }

  .index-table__project {
    padding: var(--space-4);
    text-align: left;
    font-family: var(--font-body);
    font-size: var(--fs-16);
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .index-table tbody tr {
    position: relative;
  }

  .index-table__link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .index-table__link:hover {
    color: var(--accent);
  }

  /* The whole row is a click target for the mouse (one tab stop: the title). */
  .index-table__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .index-table__link:focus-visible {
    outline: none;
  }

  .index-table__link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .index-table__mcu {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .index-table__key {
    display: none;
  }

  .index-table__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .index-table__num {
    text-align: right;
    white-space: nowrap;
  }

  .index-table__versions {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-primary);
  }

  .index-table__versions-word {
    color: var(--text-muted);
  }

  .index-table__go {
    width: 1%;
    text-align: right;
  }

  .index-table__arrow {
    display: inline-block;
    color: var(--text-muted);
    font-size: var(--fs-18);
    transition: color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .index-table tbody tr:hover .index-table__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .index-table tbody tr:hover .index-table__link {
    color: var(--accent);
  }

  @media (min-width: 1100px) {
    .index-table__chips {
      flex-wrap: nowrap;
    }
  }

  @media (max-width: 640px) {
    .projects-block {
      padding-bottom: var(--space-16);
    }
  }

  @media (max-width: 900px) {
    .index-table__mcu {
      font-size: var(--fs-12);
    }
  }

  /* ── Phones: each row becomes a compact stacked block ────────────────── */
  @media (max-width: 640px) {
    .index-table,
    .index-table tbody,
    .index-table tr,
    .index-table th,
    .index-table td {
      display: block;
    }

    .index-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .index-table tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--border-subtle);
    }

    .index-table tbody th,
    .index-table tbody td {
      padding: 0;
      border: 0;
    }

    .index-table__project { grid-column: 1; grid-row: 1; }
    .index-table__go { grid-column: 2; grid-row: 1; width: auto; }
    .index-table__mcu { grid-column: 1 / -1; font-size: var(--fs-12); }
    .index-table__tags { grid-column: 1 / -1; }
    .index-table__num {
      grid-column: 1 / -1;
      text-align: left;
    }

    .index-table__key {
      display: inline;
      margin-right: var(--space-2);
      color: var(--text-muted);
      letter-spacing: var(--tracking-label);
    }

    .index-table__cell--empty {
      display: none;
    }

    .index-table__versions {
      font-size: var(--fs-12);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
  }
</style>
