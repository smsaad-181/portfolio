---
/**
 * ParticleField.astro — the site-wide animated background (Saad's choice,
 * 21 Nov 2026): small dots drift slowly and link with thin lines when they
 * are close, like a connected IoT network; dots near the pointer link to it.
 *
 * One fixed <canvas> behind every page (BaseLayout). Colours come from the
 * --particle-* tokens, so it follows the light/dark theme. Light on purpose:
 * starts after the page has loaded, fewer dots on small screens, capped pixel
 * ratio, paused when the tab is hidden, a still frame for reduced motion.
 */
---

<canvas class="particle-field" aria-hidden="true" data-particles></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-particles]");
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    type P = { x: number; y: number; vx: number; vy: number; r: number; c: number };
    let W = 0, H = 0, dpr = 1, parts: P[] = [], raf = 0, running = false;
    let colours: string[] = [], line = "", maxDist = 140;
    const mouse = { x: -9999, y: -9999 };

    const readColours = () => {
      const cs = getComputedStyle(document.documentElement);
      colours = ["--particle-1", "--particle-2", "--particle-3"].map((v) => cs.getPropertyValue(v).trim() || "#c86bff");
      line = cs.getPropertyValue("--particle-line").trim() || "200, 107, 255";
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = window.innerWidth; H = window.innerHeight;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      maxDist = W < 700 ? 110 : 140;
      // ~1 dot per 16 000 px² (fewer on phones), between 24 and 80.
      const want = Math.max(24, Math.min(80, Math.round((W * H) / (W < 700 ? 22000 : 16000))));
      while (parts.length < want) parts.push(spawn());
      parts.length = want;
    };

    const spawn = (): P => ({
      x: Math.random() * W, y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35,
      r: 1 + Math.random() * 1.6, c: Math.floor(Math.random() * 3),
    });

    const draw = (move: boolean) => {
      ctx.clearRect(0, 0, W, H);
      for (const p of parts) {
        if (move) {
          p.x += p.vx; p.y += p.vy;
          if (p.x < -10) p.x = W + 10; else if (p.x > W + 10) p.x = -10;
          if (p.y < -10) p.y = H + 10; else if (p.y > H + 10) p.y = -10;
        }
      }
      // Links between close dots (and to the pointer).
      ctx.lineWidth = 0.8;
      for (let i = 0; i < parts.length; i++) {
        const a = parts[i]!;
        for (let j = i + 1; j < parts.length; j++) {
          const b = parts[j]!;
          const dx = a.x - b.x, dy = a.y - b.y, d2 = dx * dx + dy * dy;
          if (d2 > maxDist * maxDist) continue;
          const alpha = (1 - Math.sqrt(d2) / maxDist) * 0.35;
          ctx.strokeStyle = `rgba(${line}, ${alpha.toFixed(3)})`;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        }
        const mx = a.x - mouse.x, my = a.y - mouse.y, m2 = mx * mx + my * my, md = maxDist * 1.3;
        if (m2 < md * md) {
          ctx.strokeStyle = `rgba(${line}, ${((1 - Math.sqrt(m2) / md) * 0.5).toFixed(3)})`;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
        }
      }
      for (const p of parts) {
        ctx.fillStyle = colours[p.c]!;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
      }
    };

    const loop = () => { draw(true); raf = requestAnimationFrame(loop); };
    const start = () => {
      if (running || still.matches || document.hidden) { if (still.matches) draw(false); return; }
      running = true; raf = requestAnimationFrame(loop);
    };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    const init = () => {
      readColours(); resize(); draw(false); start();
      canvas.classList.add("is-on");
      window.addEventListener("resize", () => { resize(); if (!running) draw(false); }, { passive: true });
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
      still.addEventListener("change", () => { stop(); start(); });
      window.addEventListener("pointermove", (e) => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
      document.addEventListener("pointerleave", () => { mouse.x = mouse.y = -9999; });
      // Re-read colours when the theme toggle changes data-theme.
      new MutationObserver(() => { readColours(); if (!running) draw(false); })
        .observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    };

    // Start after the page has loaded and the browser is idle (no effect on first paint).
    const later = () => ("requestIdleCallback" in window ? requestIdleCallback(init, { timeout: 1500 }) : setTimeout(init, 300));
    if (document.readyState === "complete") later(); else window.addEventListener("load", later, { once: true });
  }
</script>

<style>
  .particle-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .particle-field.is-on {
    opacity: var(--particle-opacity, 1);
  }

  @media print {
    .particle-field { display: none; }
  }
</style>
