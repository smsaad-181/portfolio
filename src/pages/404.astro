---
/**
 * 404 page — required for GitHub Pages fallback.
 * noindex prevents this from appearing in search results.
 * Same page head as every inner page, a small terminal card, and two ways
 * back (Home, Projects).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { pageUrl } from "../lib/urls";
---

<BaseLayout
  title="Page Not Found"
  description="The page you were looking for doesn't exist."
  noindex={true}
>
  <section class="page-head not-found" aria-labelledby="nf-title">
    <div class="container">
      <p class="section-label">// error 404 · page not found</p>
      <h1 class="page-title" id="nf-title">Nothing here</h1>
      <p class="page-lead">The page you were looking for doesn't exist or has been moved.</p>

      <div class="card terminal" aria-hidden="true">
        <div class="terminal__bar"><span></span><span></span><span></span></div>
        <div class="terminal__body">
          <p><span class="t-prompt">$</span> <span class="t-cmd">ls ./requested-page</span></p>
          <p class="t-err">ls: cannot access './requested-page': No such file or directory</p>
          <p><span class="t-prompt">$</span> <span class="t-cursor">_</span></p>
        </div>
      </div>

      <div class="not-found__actions">
        <a href={pageUrl("/")} class="btn btn--primary">Back to home</a>
        <a href={pageUrl("/projects/")} class="btn btn--secondary">Browse projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100dvh - var(--nav-height) - 200px);
    padding-bottom: var(--space-24);
  }

  .terminal {
    max-width: 38rem;
    margin-top: var(--space-8);
    padding: 0;
    overflow: hidden;
  }

  .terminal__bar {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
  }

  .terminal__bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }

  .terminal__body {
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    line-height: 1.8;
  }

  .terminal__body p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .t-prompt { color: var(--accent); }
  .t-cmd { color: var(--text-primary); }
  .t-err { color: var(--status-error); padding-left: 1ch; }
  .t-cursor {
    display: inline-block;
    color: var(--accent);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .t-cursor { animation: none; }
  }

  :global(:root.motion-paused) .t-cursor { animation: none; }

  .not-found__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  @media (max-width: 640px) {
    .not-found {
      padding-bottom: var(--space-16);
    }

    .terminal__body {
      padding: var(--space-4);
      font-size: var(--fs-12);
    }
  }
</style>
