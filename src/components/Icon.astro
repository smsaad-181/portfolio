  name:
    | "linkedin" | "github" | "oshwlab" | "email" | "copy" | "check" | "send" | "pin" | "download" | "print"
    | "chip" | "code" | "exchange" | "cloud" | "wrench" | "briefcase" | "cap" | "award" | "user" | "arrow"
    | "phone" | "envelope" | "linkedin-box" | "pcb" | "database";
