---
/**
 * About page — /about/
 * Page head (name, role, availability, profiles) with the graduation photo in
 * a gradient ring, the bio as one readable column, experience as a timeline,
 * education and certifications side by side, and a link to /skills/.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import Icon from "@components/Icon.astro";
import PublicImage from "@components/PublicImage.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import photo from "../assets/profile/hero-photo.jpg";
import { getProfile } from "../lib/profile";
import { getSkillGroups } from "../lib/skills";
import { pageUrl } from "../lib/urls";
import { personJsonLd, toJsonLd } from "../lib/jsonld";
import { formatTag } from "../lib/tags";
import { formatMonthYear } from "../lib/dates";

const profile = await getProfile();
const { data } = profile;
const experiences = (await getCollection("experience")).sort((a, b) => {
  if (a.data.current !== b.data.current) return a.data.current ? -1 : 1;
  return new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();
});
const educations = (await getCollection("education")).sort((a, b) => b.data.year - a.data.year);
const certs = await getCollection("certifications");
const skillCount = (await getSkillGroups()).reduce((n, g) => n + g.skills.length, 0);

const person = await personJsonLd(photo);

const fmt = formatMonthYear;
const links = [
  data.socialLinks.linkedin && { name: "linkedin" as const, label: "LinkedIn", href: data.socialLinks.linkedin },
  data.socialLinks.github && { name: "github" as const, label: "GitHub", href: data.socialLinks.github },
  data.socialLinks.oshwlab && { name: "oshwlab" as const, label: "OSHWLab", href: data.socialLinks.oshwlab },
].filter((l): l is { name: "linkedin" | "github" | "oshwlab"; label: string; href: string } => Boolean(l));
const bio = data.bio?.length ? data.bio : [data.summary];
---

<BaseLayout title="About" description={`About ${data.name}, ${data.title} in ${data.location}. ${data.summary}`}>
  <script is:inline slot="head" type="application/ld+json" set:html={toJsonLd(person)} />

  <!-- ── Page head ─────────────────────────────────────────────────────── -->
  <section class="page-head about-head" aria-labelledby="about-title">
    <div class="container about-head__inner">
      <div class="about-head__text">
        <p class="section-label">// about me</p>
        <h1 class="page-title" id="about-title">{data.name}</h1>
        <ul class="meta-row about-head__meta" role="list">
          <li>{data.title}</li>
          <li>{data.location}</li>
        </ul>
        {data.availability && (
          <p class="availability"><span class="availability__dot" aria-hidden="true"></span>{data.availability}</p>
        )}
        <ul class="about-head__links" role="list" aria-label="Profiles and email">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="pill-link">
                <Icon name={l.name} size={16} />{l.label}<span class="sr-only"> (opens in new tab)</span>
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${data.email}`} class="pill-link"><Icon name="email" size={16} />{data.email}</a>
          </li>
        </ul>
      </div>
      <div class="about-head__photo">
        <div class="ring">
          <Image
            src={photo}
            alt={`${data.name}, ${data.title}`}
            widths={[200, 280, 400, 560]}
            sizes="(max-width: 900px) 200px, 280px"
            quality={82}
            class="ring__photo"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bio ───────────────────────────────────────────────────────────── -->
  <section class="section section--first" aria-labelledby="bio-heading">
    <div class="container split">
      <SectionHeading label="// bio" title="Who I am" id="bio-heading" />
      <div class="bio">
        {bio.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- ── Experience ─────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="experience-heading">
    <div class="container split">
      <SectionHeading label="// career" title="Experience" id="experience-heading" />
      <ol class="timeline" role="list">
        {experiences.map((exp) => (
          <li class="timeline__item">
            <span class:list={["timeline__dot", { "timeline__dot--now": exp.data.current }]} aria-hidden="true"></span>
            <article aria-labelledby={`role-${exp.id}`}>
              <p class="timeline__dates">
                <time datetime={exp.data.startDate}>{fmt(exp.data.startDate)}</time>
                {exp.data.current ? <Fragment> – <span class="timeline__now">Present</span></Fragment> : exp.data.endDate && <Fragment> – <time datetime={exp.data.endDate}>{fmt(exp.data.endDate)}</time></Fragment>}
              </p>
              <h3 class="timeline__role" id={`role-${exp.id}`}>{exp.data.role}</h3>
              <p class="timeline__company">{exp.data.company}</p>
              <ul class="timeline__bullets">
                {exp.data.bullets.map((b) => <li>{b}</li>)}
              </ul>
              {exp.data.tags.length > 0 && (
                <ul class="chips" role="list" aria-label="Technologies">
                  {exp.data.tags.map((t) => <li>{formatTag(t)}</li>)}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Education & certifications ─────────────────────────────────────── -->
  <section class="section" aria-labelledby="education-heading">
    <div class="container split">
      <SectionHeading label="// background" title="Education & certifications" id="education-heading" />
      <div class="edu">
        <div class="edu__col">
          <h3 class="edu__head">Education</h3>
          <ol class="stack" role="list">
            {educations.map((e) => (
              <li class="card edu__item">
                <span class="edu__mark" aria-hidden={e.data.logo ? undefined : "true"}>
                  {e.data.logo ? (
                    <PublicImage src={e.data.logo.src} alt={e.data.logo.alt} widths={[40, 80]} sizes="40px" class="edu__logo" />
                  ) : (
                    <Icon name="cap" size={18} />
                  )}
                </span>
                <div class="edu__body">
                  <p class="edu__degree">{e.data.degree}</p>
                  <p class="edu__meta">{e.data.institute}{e.data.group && ` · ${e.data.group}`}</p>
                  <ul class="meta-row edu__facts" role="list">
                    <li>{e.data.year}</li>
                    {e.data.result && <li>{e.data.result}</li>}
                  </ul>
                </div>
              </li>
            ))}
          </ol>
        </div>
        {certs.length > 0 && (
          <div class="edu__col">
            <h3 class="edu__head">Certifications &amp; training</h3>
            <ul class="stack" role="list">
              {certs.map((c) => (
                <li class="card edu__item edu__item--cert">
                  <span class="edu__mark" aria-hidden="true"><Icon name="award" size={18} /></span>
                  <div class="edu__body">
                    <p class="edu__degree">{c.data.name}</p>
                    {c.data.issuer && <p class="edu__meta">{c.data.issuer}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ── Link to the Skills page ───────────────────────────────────────── -->
  <section class="section section--last" aria-label="Skills">
    <div class="container">
      <a href={pageUrl("/skills/")} class="card card--feature toolbox" data-reveal>
        <span class="toolbox__text">
          <span class="section-label">// toolbox</span>
          <span class="toolbox__title">Skills &amp; tools</span>
          <span class="toolbox__desc">{skillCount} tools, languages and protocols, from EasyEDA and ESP32 to Modbus, MQTT and LoRaWAN.</span>
        </span>
        <span class="link-arrow">See all skills <span class="link-arrow__icon" aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Page head ─────────────────────────────────────────────────────────── */
  .about-head__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-12);
    align-items: center;
  }

  .about-head__meta {
    margin-top: var(--space-4);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-surface);
    font-size: var(--fs-14);
    font-weight: 500;
    color: var(--text-primary);
  }

  .availability__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-completed);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-completed) 20%, transparent);
  }

  .about-head__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .pill-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-size: var(--fs-14);
    font-weight: 500;
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .pill-link:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  /* Photo in a gradient ring (same look as the Home hero) */
  .about-head__photo {
    padding: var(--space-4);
  }

  .ring {
    width: 280px;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 4px;
    background: var(--gradient-accent);
    box-shadow:
      0 0 0 10px color-mix(in srgb, var(--accent-2) 10%, transparent),
      0 24px 70px -20px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .ring__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--bg-base);
    background: var(--bg-elevated);
  }

  /* ── Sections: heading column + content column on wide screens ─────────── */
  .section {
    padding-block: var(--space-24) 0;
  }

  .section--first {
    padding-top: var(--space-12);
    border-top: 1px solid var(--border-subtle);
  }

  .section--last {
    padding-bottom: var(--space-24);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .split > :global(.section-heading) {
    margin-bottom: 0;
  }

  @media (min-width: 1000px) {
    .split > :global(.section-heading) {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-8));
    }
  }

  /* Bio */
  .bio {
    max-width: 38rem;
  }

  .bio p {
    margin: 0;
    font-size: var(--fs-18);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .bio p:first-child {
    color: var(--text-primary);
  }

  .bio p + p {
    margin-top: var(--space-6);
  }

  /* Experience timeline */
  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 var(--space-8);
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: var(--space-2);
    bottom: var(--space-2);
    width: 1px;
    background: var(--border);
  }

  .timeline__item {
    position: relative;
  }

  .timeline__item + .timeline__item {
    margin-top: var(--space-12);
  }

  .timeline__dot {
    position: absolute;
    left: calc(-1 * var(--space-8));
    top: 0.35rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 2px solid var(--text-muted);
  }

  .timeline__dot--now {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .timeline__dates {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .timeline__now {
    color: var(--accent);
    font-weight: 600;
  }

  .timeline__role {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-20);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .timeline__company {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-16);
    color: var(--text-secondary);
  }

  .timeline__bullets {
    max-width: 38rem;
    margin: var(--space-4) 0 0;
    padding-left: 1.1em;
    color: var(--text-secondary);
    line-height: var(--lh-body);
  }

  .timeline__bullets li::marker {
    color: var(--text-muted);
  }

  .timeline__bullets li + li {
    margin-top: var(--space-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--text-secondary);
  }

  /* Education & certifications: two aligned columns of cards */
  .edu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    align-items: start;
  }

  .edu__head {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stack {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .edu__item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
  }

  .edu__item--cert {
    align-items: center;
  }

  .edu__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--accent);
    overflow: hidden;
  }

  .edu__mark:has(:global(.edu__logo)) {
    background: var(--logo-tile-bg);
    border: 1px solid var(--logo-tile-border);
  }

  .edu__mark :global(.edu__logo) {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .edu__body {
    min-width: 0;
  }

  .edu__degree {
    margin: 0;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
  }

  .edu__meta {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .edu__facts {
    margin-top: var(--space-2);
  }

  /* Skills link card */
  .toolbox {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding: var(--space-8);
    color: var(--text-primary);
  }

  .toolbox:hover {
    color: var(--text-primary);
  }

  .toolbox__text {
    display: grid;
    max-width: 38rem;
  }

  .toolbox__text .section-label {
    margin-bottom: var(--space-2);
  }

  .toolbox__title {
    font-size: var(--fs-22);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .toolbox__desc {
    margin-top: var(--space-2);
    color: var(--text-secondary);
  }

  .toolbox:hover :global(.link-arrow__icon) {
    transform: translateX(3px);
  }

  @media (max-width: 999px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 900px) {
    .about-head__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .about-head__photo {
      order: -1;
      justify-self: start;
      padding: var(--space-2);
    }

    .ring {
      width: 176px;
    }

    .edu {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .section {
      padding-top: var(--space-16);
    }

    .section--first {
      padding-top: var(--space-12);
    }

    .section--last {
      padding-bottom: var(--space-16);
    }

    .bio p {
      font-size: var(--fs-16);
    }

    /* Role and city on their own lines (no dangling "·" at a line start) */
    .about-head__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }

    .about-head__meta > * + *::before {
      content: none;
    }

    .availability {
      border-radius: var(--radius-md);
    }

    .about-head__links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about-head__links li:last-child {
      grid-column: 1 / -1;
    }

    .pill-link {
      width: 100%;
      justify-content: center;
      gap: var(--space-1);
      padding-inline: var(--space-2);
      overflow-wrap: normal;
    }

    .about-head__links li:last-child .pill-link {
      overflow-wrap: anywhere;
    }

    .pill-link :global(svg) {
      flex: none;
    }
  }

  @media (max-width: 359px) {
    .about-head__links {
      grid-template-columns: minmax(0, 1fr);
    }

    .timeline {
      padding-left: var(--space-6);
    }

    .timeline__dot {
      left: calc(-1 * var(--space-6));
    }

    .toolbox {
      padding: var(--space-6);
    }
  }
</style>
