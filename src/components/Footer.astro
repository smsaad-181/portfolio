---
/**
 * Footer.astro
 * Minimal footer aligned to the page container: wordmark + tagline and the
 * social links on top, a hairline, then copyright and the "Pause animations"
 * control. Social links are hardcoded here so the footer renders even before
 * the profile collection is loaded on a given page.
 */
import Wordmark from "@components/Wordmark.astro";

const year = new Date().getFullYear();

const socialLinks = [
  {
    label: "GitHub",
    href: "https://github.com/smsaad-181",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/sultan-mahmud-saad",
  },
  {
    label: "OSHWLab",
    href: "https://oshwlab.com/smsaad181",
  },
  {
    label: "Email",
    href: "mailto:smsaad181@gmail.com",
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__logo">
          <Wordmark compact={false} />
        </span>
        <p class="footer__tagline">Embedded Engineer · PCB Designer · IoT</p>
      </div>

      <nav class="footer__social" aria-label="Social links">
        <ul role="list">
          {socialLinks.map((link) => {
            const external = !link.href.startsWith("mailto");
            return (
              <li>
                <a
                  href={link.href}
                  class="footer__social-link"
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  aria-label={external ? `${link.label} (opens in new tab)` : link.label}
                >
                  {link.label}
                  <svg class="footer__arrow" viewBox="0 0 12 12" aria-hidden="true">
                    {external ? (
                      <path d="M3.5 8.5l5-5M4.5 3.5h4v4" />
                    ) : (
                      <path d="M2 6h7.5M6.5 3l3 3-3 3" />
                    )}
                  </svg>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {year} Sultan Mahmud Saad. Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.
      </p>

      <!-- WCAG 2.2.2: a way to stop the looping background + hero motion.
           Remembered per visitor; BaseLayout's head script applies it before paint. -->
      <button type="button" class="footer__motion" data-motion-toggle hidden>
        Pause animations
      </button>
    </div>
  </div>
</footer>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
  const root = document.documentElement;
  // The label says what a press does (no aria-pressed: that would announce a
  // second, conflicting state). Shown only with JS, where it works.
  const sync = () => {
    if (!btn) return;
    btn.textContent = root.classList.contains("motion-paused") ? "Play animations" : "Pause animations";
  };
  sync();
  if (btn) btn.hidden = false;
  btn?.addEventListener("click", () => {
    const pause = !root.classList.contains("motion-paused");
    root.classList.toggle("motion-paused", pause);
    if (pause) root.classList.remove("tilt-on");
    try { localStorage.setItem("motion", pause ? "paused" : "on"); } catch {}
    document.dispatchEvent(new Event("motion-toggle"));
    sync();
  });
</script>

<style>
  .footer {
    margin-top: var(--space-24);
    border-top: 1px solid var(--border-subtle);
    padding-block: var(--space-12) var(--space-8);
    background: var(--bg-base);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-8);
  }

  /* ── Top row: brand left, links right ── */
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6) var(--space-8);
  }

  .footer__logo {
    display: inline-flex;
    margin-bottom: var(--space-2);
  }

  .footer__tagline {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
    text-wrap: balance;
    /* not uppercased: "IoT" must keep its casing */
  }

  .footer__social ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.25rem;
    font-size: var(--fs-14);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .footer__arrow {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .footer__social-link:hover {
    color: var(--text-primary);
  }

  .footer__social-link:hover .footer__arrow {
    color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__social-link:hover .footer__arrow {
      transform: translate(1px, -1px);
    }
  }

  /* ── Bottom row: hairline, copyright left, motion control right ── */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .footer__copy {
    margin: 0;
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .footer__copy a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease), text-decoration-color var(--dur-fast) var(--ease);
  }

  .footer__copy a:hover {
    color: var(--text-primary);
    text-decoration-color: currentColor;
  }

  .footer__motion {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: var(--fs-14);
    line-height: 1;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .footer__motion[hidden] {
    display: none;
  }

  .footer__motion:hover {
    color: var(--text-primary);
    border-color: var(--accent);
    background: var(--accent-glow);
  }

  /* Nothing moves for reduced-motion visitors: no control needed. */
  @media (prefers-reduced-motion: reduce) {
    .footer__motion { display: none; }
  }

  /* Phones: stacked, every link and the button a 44 px target. */
  @media (max-width: 40em) {
    .footer {
      margin-top: var(--space-16);
      padding-block: var(--space-8) var(--space-6);
    }

    .footer__inner {
      gap: var(--space-6);
    }

    .footer__top {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__social ul {
      display: grid;
      grid-template-columns: repeat(2, max-content);
      gap: 0 var(--space-8);
    }

    .footer__social-link,
    .footer__motion {
      min-height: 44px;
    }

    .footer__bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
