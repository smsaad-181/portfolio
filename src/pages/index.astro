---
/**
 * Homepage — /
 * Hero in Saad's chosen style: "Hello, I'm", gradient name, role pill, bio
 * with underlined highlights, flowing line-art and glows, and his cut-out
 * portrait on the right fading into the page, the protocols/MCUs he works
 * with, labelled profile links and real counts. Then "About me", "What I do"
 * (3 areas with their tools and example projects), the first 6 projects in
 * Saad's order (`order`), an experience/education timeline and the CV CTA.
 * Sections animate in on scroll ([data-reveal], BaseLayout).
 *
 * Portrait: src/assets/profile/portrait.{png,webp,jpg} — a transparent-
 * background cut-out looks best. Optimised by Astro's <Image />.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ResumeButton from "@components/ResumeButton.astro";
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getPublishedProjects } from "../lib/projects";
import { getProfile } from "../lib/profile";
import { getSkillGroups } from "../lib/skills";
import { personJsonLd, toJsonLd } from "../lib/jsonld";
import { pageUrl, projectUrl, publicFileExists } from "../lib/urls";

const profile = await getProfile();
const published = await getPublishedProjects();
// Home shows the first 6 projects in Saad's order (Projects page = all).
const featured = published.slice(0, 6);
const skillGroups = await getSkillGroups();
const skillCount = skillGroups.reduce((n, g) => n + g.skills.length, 0);
const currentJob = (await getCollection("experience")).find((e) => e.data.current);
const education = (await getCollection("education")).sort((a, b) => b.data.year - a.data.year);
const certifications = (await getCollection("certifications")).map((c) => c.data.name);
const boardCount = published.reduce((n, p) => n + p.data.models.filter((m) => publicFileExists(m.src)).length, 0);
// Real counts from the content unless Saad has entered his own stats.
const stats = profile.data.stats?.length
  ? profile.data.stats
  : [
      { value: String(published.length), label: "PCB projects" },
      { value: String(boardCount), label: "boards in interactive 3D" },
      { value: String(skillCount), label: "tools & protocols" },
    ];
const about = profile.data.about ?? [];
const sinceYear = currentJob ? new Date(currentJob.data.startDate).getFullYear() : null;
const social = [
  profile.data.socialLinks.linkedin && { label: "LinkedIn", href: profile.data.socialLinks.linkedin, icon: "linkedin" },
  profile.data.socialLinks.github && { label: "GitHub", href: profile.data.socialLinks.github, icon: "github" },
  profile.data.socialLinks.oshwlab && { label: "OSHWLab", href: profile.data.socialLinks.oshwlab, icon: "oshwlab" },
  { label: "Email", href: `mailto:${profile.data.email}`, icon: "email" },
].filter((l): l is { label: string; href: string; icon: string } => Boolean(l));
const ICONS: Record<string, string> = {
  linkedin: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.6 4.77 6v5.46h-4v-4.84c0-1.15-.02-2.64-1.6-2.64-1.62 0-1.86 1.26-1.86 2.56v4.92h-4v-11Z",
  github: "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z",
  oshwlab: "M7 3h10v2h2v2h2v2h-2v2h2v2h-2v2h2v2h-2v2h-2v2H7v-2H5v-2H3v-2h2v-2H3v-2h2V9H3V7h2V5h2V3Zm2 4v10h6V7H9Z",
  email: "M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.3-8-5.3ZM5.2 7 12 11.5 18.8 7H5.2Z",
};

// Portrait — first match wins.
const portraitFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/profile/portrait.{png,webp,avif,jpg,jpeg}",
  { eager: true }
);
const portrait = Object.values(portraitFiles)[0]?.default;
const person = await personJsonLd(portrait);

const initials = profile.data.name
  .split(" ")
  .map((w) => w.charAt(0))
  .join("")
  .slice(0, 2)
  .toUpperCase();




// Flowing line-art for the hero background: a family of cubic curves whose
// four points each drift by a fixed step per line, which reads as silk/waves.
type Pt = [x: number, y: number, dx: number, dy: number];
function wavePaths(count: number, p0: Pt, c1: Pt, c2: Pt, p3: Pt): string[] {
  const at = (p: Pt, i: number) => `${(p[0] + p[2] * i).toFixed(1)} ${(p[1] + p[3] * i).toFixed(1)}`;
  return Array.from({ length: count }, (_, i) =>
    `M${at(p0, i)} C${at(c1, i)} ${at(c2, i)} ${at(p3, i)}`
  );
}
const wavesTop = wavePaths(42, [120, -40, 7, 0], [100, 280, 5, -4], [540, 400, -3, -7], [680, 60, 0, 6]);
const wavesBottom = wavePaths(42, [-60, 140, 0, 6], [260, 20, 3, 5], [160, 560, 7, -3], [560, 620, 5, 0]);
const city = profile.data.location.split(",")[0];
const fmtMonth = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });

// Tech he works with daily — straight from his profile summary.
const focus = ["ESP32", "Arduino", "ATmega", "I²C", "SPI", "UART", "Modbus", "MQTT", "LoRaWAN"];

// "What I do": three areas, each with tools from the skills collection and
// two example projects. Wording only restates facts from the profile bio and
// the project write-ups.
const toolsOf = (...cats: string[]) =>
  skillGroups.filter((g) => cats.includes(g.category)).flatMap((g) => g.skills.map((s) => s.skill.data.name)).slice(0, 6);
const bySlug = (slug: string) => published.find((p) => p.id === slug);
const areas = [
  {
    icon: "chip" as const,
    title: "PCB design",
    text: "Schematics and PCB layouts in EasyEDA Pro, from power regulation and input protection to USB-C programming circuits.",
    tools: toolsOf("hardware & pcb"),
    examples: ["lora-gps-tracker", "home-automation"].map(bySlug).filter((p) => p !== undefined),
  },
  {
    icon: "code" as const,
    title: "Embedded firmware",
    text: "Firmware for ESP32 and Arduino-based boards: sensors over I²C, SPI and UART, settings kept in flash and web dashboards served by the board itself.",
    tools: toolsOf("embedded & firmware"),
    examples: ["vehicle-motion-analyzer", "home-automation"].map(bySlug).filter((p) => p !== undefined),
  },
  {
    icon: "cloud" as const,
    title: "IoT systems",
    text: "Connected devices over Wi-Fi, LoRa, Modbus and MQTT, with Node-RED or on-device dashboards for data and control.",
    tools: toolsOf("protocols", "iot & platforms"),
    examples: ["lora-gps-tracker", "acqua-node"].map(bySlug).filter((p) => p !== undefined),
  },
];
---

<BaseLayout
  title="Sultan Mahmud — Hardware Engineer"
  fullTitle
  description={profile.data.summary}
>
  <script is:inline slot="head" type="application/ld+json" set:html={toJsonLd(person)} />

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero__bg" aria-hidden="true">
      <svg class="hero__waves hero__waves--top" viewBox="0 0 600 500" preserveAspectRatio="none">
        <defs>
          <linearGradient id="wave-top" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" style="stop-color: var(--hero-wave-a)" />
            <stop offset="100%" style="stop-color: var(--hero-wave-b)" />
          </linearGradient>
        </defs>
        <g fill="none" stroke="url(#wave-top)" stroke-width="0.8">
          {wavesTop.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
        </g>
      </svg>
      <svg class="hero__waves hero__waves--bottom" viewBox="0 0 600 500" preserveAspectRatio="none">
        <defs>
          <linearGradient id="wave-bottom" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" style="stop-color: var(--hero-wave-c)" />
            <stop offset="100%" style="stop-color: var(--hero-wave-d)" />
          </linearGradient>
        </defs>
        <g fill="none" stroke="url(#wave-bottom)" stroke-width="0.8">
          {wavesBottom.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
        </g>
      </svg>
    </div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="hero__greeting hero-in" style="--in: 0">Hello, I'm</p>
        <h1 class="hero__name" id="hero-name">{profile.data.name}</h1>

        <p class="hero__badge hero-in" style="--in: 1">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="hero__badge-icon">
            <rect x="6" y="6" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="9.5" y="9.5" width="5" height="5" rx="0.8" fill="currentColor" />
            <path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          {profile.data.title}
        </p>

        <p class="hero__bio hero-in" style="--in: 2">
          I design PCBs, write embedded firmware and build IoT products, taking
          an idea from the <span class="u">first schematic</span> to a
          <span class="u">working board</span>.
        </p>

        <ul class="hero__focus hero-in" style="--in: 3" role="list" aria-label="Works with">
          {focus.map((f) => <li>{f}</li>)}
        </ul>

        {currentJob && (
          <p class="hero__now hero-in" style="--in: 4">
            <span class="hero__now-dot" aria-hidden="true"></span>
            <span>{currentJob.data.role} at <strong>{currentJob.data.company}</strong> · {city}</span>
          </p>
        )}
        {profile.data.availability && (
          <p class="hero__avail hero-in" style="--in: 4">
            <Icon name="briefcase" size={16} />
            <span>{profile.data.availability}</span>
          </p>
        )}

        <div class="hero__actions hero-in" style="--in: 5">
          <a href={pageUrl("/about/")} class="btn btn--primary">
            <Icon name="user" size={18} /> About me
          </a>
          <ResumeButton variant="secondary" />
        </div>

        <ul class="hero__social hero-in" style="--in: 6" role="list" aria-label="Contact and profiles">
          {social.map((l) => (
            <li>
              <a
                href={l.href}
                class={`hero__social-link hero__social-link--${l.icon}`}
                aria-label={l.href.startsWith("mailto") ? `Email ${profile.data.email}` : `${l.label} (opens in new tab)`}
                target={l.href.startsWith("mailto") ? undefined : "_blank"}
                rel={l.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
              >
                <span class="hero__social-icon"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={ICONS[l.icon]} /></svg></span>
                <span class="hero__social-label">{l.label}</span>
              </a>
            </li>
          ))}
        </ul>

        {stats.length > 0 && (
          <dl class="hero__stats hero-in" style="--in: 7">
            {stats.map((s) => (
              <div class="hero__stat">
                <dt>{s.label}</dt>
                <dd data-count={/^\d+$/.test(s.value) ? s.value : undefined}>{s.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="hero__portrait">
        <div class="hero__portrait-glow" aria-hidden="true"></div>
        {portrait ? (
          <Image
            src={portrait}
            alt={`${profile.data.name}, ${profile.data.title}`}
            widths={[400, 560, 800, 1120]}
            sizes="(max-width: 900px) 340px, 560px"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="hero__photo"
          />
        ) : (
          <div class="hero__monogram" role="img" aria-label={profile.data.name}>
            <span>{initials}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ── About me (from Saad's GitHub profile) ────────────────────────────── -->
  {about.length > 0 && (
    <section class="section" aria-labelledby="about-heading">
      <div class="container about">
        <div class="about__intro" data-reveal="left">
          <SectionHeading label="// about me" title="Hardware, end to end" id="about-heading" />
          <p class="about__text">{profile.data.summary}</p>
          {currentJob && (
            <div class="about__role">
              <p class="about__role-label">Current role{sinceYear && ` · since ${sinceYear}`}</p>
              <p class="about__role-title">{currentJob.data.role}</p>
              <p class="about__role-company">{currentJob.data.company}</p>
            </div>
          )}
          <a href={pageUrl("/about/")} class="about__more">More about me <span aria-hidden="true">→</span></a>
        </div>
        <ul class="about__cards" role="list" data-reveal-stagger>
          {about.map((a, i) => (
            <li class="about__card" data-reveal>
              <span class="about__card-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="about__card-title">{a.label}</h3>
              <p class="about__card-text">{a.value}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ── What I do ───────────────────────────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="do-heading">
    <div class="container">
      <div data-reveal>
        <SectionHeading
          label="// what I do"
          title="From schematic to working product"
          id="do-heading"
          description="Three areas I work across, the tools I use for each, and projects that show them."
        />
      </div>
      <ul class="areas" role="list" data-reveal-stagger>
        {areas.map((a, i) => (
          <li class="area" data-reveal>
            <div class="area__top">
              <span class="area__icon"><Icon name={a.icon} size={24} /></span>
              <span class="area__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="area__title">{a.title}</h3>
            <p class="area__text">{a.text}</p>
            {a.tools.length > 0 && (
              <ul class="area__tools" role="list" aria-label={`${a.title} tools`}>
                {a.tools.map((t) => <li>{t}</li>)}
              </ul>
            )}
            {a.examples.length > 0 && (
              <div class="area__examples">
                <span class="area__examples-label">See it in</span>
                {a.examples.map((p) => <a href={projectUrl(p)}>{p.data.title}</a>)}
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Projects (first 6 in Saad's order) ──────────────────────────────── -->
  {featured.length > 0 && (
    <section class="section" aria-labelledby="featured-heading">
      <div class="container">
        <div data-reveal>
          <SectionHeading
            label="// selected work"
            title="Projects"
            id="featured-heading"
            description="Boards I designed in EasyEDA. Every project has an interactive 3D board where you can identify each placed part; stacked cards hold several board versions."
          />
        </div>
        <div class="projects-grid" data-reveal-stagger>
          {featured.map((project) => (
            <ProjectCard
              title={project.data.title}
              href={projectUrl(project)}
              summary={project.data.summary}
              coverImage={project.data.coverImage}
              tags={project.data.tags}
              status={project.data.status}
              versions={project.data.versions.map((v) => v.label)}
            />
          ))}
        </div>
        <div class="projects-cta">
          <a href={pageUrl("/projects/")} class="btn btn--secondary">
            All {published.length} projects →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── Experience & education timeline ─────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="journey-heading">
    <div class="container">
      <div data-reveal>
        <SectionHeading label="// journey" title="Experience & education" id="journey-heading" />
      </div>
      <ol class="timeline" role="list">
        {currentJob && (
          <li class="timeline__item" data-reveal>
            <span class="timeline__dot"><Icon name="briefcase" size={18} /></span>
            <div class="timeline__card">
              <p class="timeline__when">{fmtMonth(currentJob.data.startDate)} — Present</p>
              <h3 class="timeline__title">{currentJob.data.role}</h3>
              <p class="timeline__where">{currentJob.data.company}</p>
              <ul class="timeline__points">
                {currentJob.data.bullets.slice(0, 3).map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </li>
        )}
        {education.map((e) => (
          <li class="timeline__item" data-reveal>
            <span class="timeline__dot"><Icon name="cap" size={18} /></span>
            <div class="timeline__card">
              <p class="timeline__when">{e.data.year}</p>
              <h3 class="timeline__title">{e.data.degree}</h3>
              <p class="timeline__where">{e.data.institute}</p>
              <p class="timeline__result">{e.data.group} · {e.data.result}</p>
            </div>
          </li>
        ))}
        {certifications.length > 0 && (
          <li class="timeline__item" data-reveal>
            <span class="timeline__dot"><Icon name="award" size={18} /></span>
            <div class="timeline__card">
              <p class="timeline__when">Training</p>
              <h3 class="timeline__title">Certifications</h3>
              <ul class="timeline__certs" role="list">
                {certifications.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </li>
        )}
      </ol>
      <p class="timeline__more" data-reveal><a href={pageUrl("/about/")} class="about__more">Full background on About <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- ── Resume CTA ─────────────────────────────────────────────────────── -->
  <section class="section cta-section" aria-label="Resume download">
    <div class="container cta-inner" data-reveal="zoom">
      <div>
        <p class="section-label">// work with me</p>
        <h2 class="cta-title">Looking to collaborate or hire?</h2>
        <p class="cta-body">
          I'm open to hardware engineering roles and IoT product development projects.
          Grab my CV or reach out directly.
        </p>
      </div>
      <div class="cta-actions">
        <ResumeButton variant="primary" />
        <a href={pageUrl("/contact/")} class="btn btn--secondary">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Sections ────────────────────────────────────────────────────────── */
  .section {
    padding-block: var(--space-24);
  }

  /* Below-the-fold sections: the browser skips their style and layout until
     they scroll near (big saving on phones; content stays in the a11y tree). */
  .section {
    content-visibility: auto;
    contain-intrinsic-size: auto 720px;
  }

  .section--alt {
    /* slightly see-through so the particle background shows faintly */
    background: color-mix(in srgb, var(--bg-surface) 80%, transparent);
    border-block: 1px solid var(--border-subtle);
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Slide under the transparent sticky nav so the art fills the top edge */
    margin-top: calc(-1 * var(--nav-height));
    padding-top: var(--nav-height);
    min-height: min(100dvh, 820px);
    display: flex;
    align-items: stretch;
    background:
      radial-gradient(ellipse 60% 70% at 0% 100%, var(--hero-glow-pink), transparent 70%),
      radial-gradient(ellipse 55% 60% at 100% 0%, var(--hero-glow-blue), transparent 70%);
    /* no solid colour: the page (and its particle background) shows through */
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__waves {
    position: absolute;
    will-change: transform; /* own compositor layer: the slow drift doesn't repaint the page */
    opacity: var(--hero-wave-opacity);
  }

  .hero__waves--top {
    top: -6%;
    right: -4%;
    width: 58%;
    height: 80%;
    animation: drift 18s ease-in-out infinite alternate;
  }

  .hero__waves--bottom {
    bottom: -14%;
    left: -6%;
    width: 50%;
    height: 75%;
    opacity: calc(var(--hero-wave-opacity) * 0.8);
    animation: drift 22s ease-in-out infinite alternate-reverse;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__waves--top,
    .hero__waves--bottom {
      animation: none;
    }
  }

  @keyframes drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to   { transform: translate3d(-14px, 10px, 0) rotate(-1.5deg); }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  .hero__content {
    padding-block: var(--space-12);
  }

  .hero__greeting {
    font-size: clamp(var(--fs-22), 3vw, 2rem);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 0;
  }

  .hero__name {
    font-size: clamp(var(--fs-40), 5.5vw, 4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-6);
    background: var(--gradient-name);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.9rem 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--accent-2) 45%, transparent);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    font-size: var(--fs-16);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }

  .hero__badge-icon {
    width: 16px;
    height: 16px;
    color: var(--accent);
  }

  .hero__bio {
