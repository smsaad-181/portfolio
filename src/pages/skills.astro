---
/**
 * Skills — /skills/
 * Every skill from the skills collection, grouped like Saad's CV (order in
 * lib/skills.ts), each with its official logo (SkillLogo) or a badge.
 * Saad asked for the plain list: no "used in N projects".
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import Icon from "@components/Icon.astro";
import SkillLogo from "@components/SkillLogo.astro";
import { getSkillGroups } from "../lib/skills";
import { pageUrl } from "../lib/urls";

const groups = await getSkillGroups();
const total = groups.reduce((n, g) => n + g.skills.length, 0);

type IconName = "chip" | "code" | "exchange" | "cloud" | "wrench" | "pcb" | "database";
const ICON: Record<string, IconName> = {
  "embedded systems": "chip",
  languages: "code",
  "protocols & connectivity": "exchange",
  "pcb & 3d design": "pcb",
  "iot platforms": "cloud",
  "developer tools": "wrench",
  "web & data": "database",
};
const BLURB: Record<string, string> = {
  "embedded systems": "Microcontrollers, boards and the RTOS I build firmware on.",
  languages: "What I write firmware and tools in.",
  "protocols & connectivity": "Buses and radios between sensors, boards and the cloud.",
  "pcb & 3d design": "Schematic capture, PCB layout and 3D design.",
  "iot platforms": "Brokers and dashboards for connected devices.",
  "developer tools": "Editors, toolchains and version control.",
  "web & data": "Front-ends and databases for device data.",
};
---

<BaseLayout
  title="Skills"
  description="Hardware, embedded firmware, protocols and IoT platforms Sultan Mahmud Saad works with — EasyEDA, ESP32, I²C, SPI, UART, Modbus, MQTT, LoRaWAN, Node-RED and more."
>
  <section class="page-header">
    <div class="container">
      <SectionHeading
        label="// toolbox"
        title="Skills & tools"
        level={1}
        description={`${total} tools, languages and protocols, grouped by area.`}
      />
    </div>
  </section>

  <section class="skills-section" aria-label="Skills by area">
    <div class="container skill-groups" data-reveal-stagger>
      {groups.map((g) => (
        <article class="skill-group" aria-labelledby={`grp-${g.category.replace(/\W+/g, "-")}`} data-reveal data-tilt>
          <header class="skill-group__head">
            <span class="skill-group__icon"><Icon name={ICON[g.category] ?? "wrench"} size={22} /></span>
            <div>
              <h2 class="skill-group__title" id={`grp-${g.category.replace(/\W+/g, "-")}`}>{g.label}</h2>
              {BLURB[g.category] && <p class="skill-group__blurb">{BLURB[g.category]}</p>}
            </div>
            <span class="skill-group__count">{g.skills.length}<span class="sr-only"> skills</span></span>
          </header>
          <ul class="skill-tiles" role="list">
            {g.skills.map(({ skill }) => (
              <li class="skill-tile">
                <SkillLogo logo={skill.data.logo} mark={skill.data.mark} name={skill.data.name} size={34} />
                <span class="skill-tile__name">{skill.data.name}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="container skills-cta" data-reveal>
      <p>See these tools at work in real boards.</p>
      <a href={pageUrl("/projects/")} class="btn btn--primary">Browse projects</a>
    </div>
  </section>
</BaseLayout>

<style>
  .skills-section {
    padding-bottom: var(--space-24);
  }

  .skill-groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: var(--space-6);
  }

  .skill-group {
    position: relative;
    padding: var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .skill-group::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--gradient-accent);
  }

  .skill-group:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Lift only with a real mouse, and only when the tilt isn't running. */
  @media (hover: hover) and (pointer: fine) {
    :global(:root:not(.tilt-on)) .skill-group:hover {
      transform: translateY(-2px);
    }
  }

  .skill-group__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-4);
  }

  .skill-group__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--accent-glow);
    color: var(--accent);
  }

  .skill-group__title {
    margin: 0;
    font-size: var(--fs-18, 1.125rem);
    font-weight: 600;
  }

  .skill-group__blurb {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .skill-group__count {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 700;
    color: var(--text-muted);
  }

  /* Logo tiles: official logo (or badge) + name, in an even grid */
  .skill-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-tiles > li + li {
    margin-top: 0;
  }

  .skill-tile {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .skill-tile__name {
    min-width: 0;
    font-size: var(--fs-14);
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-tile:hover {
      border-color: var(--accent);
    }
  }

  .skills-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding: var(--space-6) var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .skills-cta p {
    margin: 0;
    font-weight: 500;
  }
</style>
