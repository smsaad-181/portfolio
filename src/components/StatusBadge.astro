---
/**
 * StatusBadge.astro
 * Renders a color-coded status badge for a project.
 * Each status value maps to a distinct visual treatment.
 */
export interface Props {
  status: "completed" | "in-progress" | "prototype";
}

const { status } = Astro.props;

const labels: Record<typeof status, string> = {
  completed: "Completed",
  "in-progress": "In Progress",
  prototype: "Prototype",
};

const label = labels[status];
---

<span class:list={["status-badge", `status-badge--${status}`]}>
  <span class="status-badge__dot" aria-hidden="true"></span>
  <span class="sr-only">Project status: </span>
  {label}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 10px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    white-space: nowrap;
  }

  .status-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .status-badge--completed {
    color: var(--status-completed);
    background: var(--status-completed-bg);
    border-color: color-mix(in srgb, var(--status-completed) 30%, transparent);
  }

  .status-badge--in-progress {
    color: var(--status-in-progress);
    background: var(--status-in-progress-bg);
    border-color: color-mix(in srgb, var(--status-in-progress) 30%, transparent);
  }

  .status-badge--prototype {
    color: var(--status-prototype);
    background: var(--status-prototype-bg);
    border-color: color-mix(in srgb, var(--status-prototype) 30%, transparent);
  }
</style>
