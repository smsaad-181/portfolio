---
/**
 * Project detail page — /projects/[slug]/
 * Header: breadcrumb (eyebrow) → H1 → summary → meta-row (role · N board
 * versions · EDA, only values the content states) → tags / links, beside the
 * key-specs card. Then: Versions (only with 2+ revisions) → the MDX write-up
 * (Overview → Features; at ≥ 1024 px with a sticky "On this page" aside) →
 * interactive 3D board(s) → board renders (3D renders only) → Outcome
 * (dashboard screenshots, only when the project has one) → previous/next.
 * Section headings use SectionHeading (mono label + H2). No status text.
 * Drafts never get a page.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import TagChip from "@components/TagChip.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BoardViewer from "@components/BoardViewer.astro";
import PublicImage from "@components/PublicImage.astro";
import { render } from "astro:content";
import { getPublishedProjects } from "../../lib/projects";
import { publicImageSize } from "../../lib/images";
import { toJsonLd } from "../../lib/jsonld";
import { getProfile } from "../../lib/profile";
import { formatTag } from "../../lib/tags";
import { absoluteUrl, assetUrl, pageUrl, projectSlug, projectUrl, publicFileExists } from "../../lib/urls";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const projects = await getPublishedProjects();
  return projects.map((project, i) => ({
    params: { slug: projectSlug(project) },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;
const siteUrl = absoluteUrl(pageUrl("/"));
const canonicalProjectUrl = absoluteUrl(projectUrl(project));

// Only images that exist are rendered — never a 404 or a placeholder.
const cover = publicFileExists(data.coverImage.src) ? data.coverImage : null;
const coverAbsoluteUrl = cover ? absoluteUrl(assetUrl(cover.src)) : undefined;
// Per-project social preview (src/pages/images/og/[slug].png.ts)
const ogImageUrl = absoluteUrl(assetUrl(`/images/og/${projectSlug(project)}.png`));
const gallery = (
  await Promise.all(
    data.gallery.map(async (img) => {
      const size = await publicImageSize(img.src);
      return size ? { ...img, ...size } : null;
    })
  )
).filter((g): g is NonNullable<typeof g> => g !== null);
// Board revisions (e.g. Home Automation V1 / V2.1 / V2.2): only images that exist.
const versions = await Promise.all(
  data.versions.map(async (v) => {
    const size = v.image ? await publicImageSize(v.image.src) : null;
    return { ...v, img: v.image && size ? { ...v.image, ...size } : null, has3d: !!v.model && data.models.some((m) => m.label === v.model && publicFileExists(m.src)) };
  })
);
// Board renders not already on the page (header cover, version cards), so
// the same board picture never shows twice.
const shownAbove = new Set([cover?.src, ...(versions.length > 1 ? versions.map((v) => v.img?.src) : [])]);
const renders = gallery.filter((g) => g.kind === "render" && !shownAbove.has(g.src));
const dashboards = gallery.filter((g) => g.kind === "dashboard");

// Mono meta-row above the H1: role · N board versions · EDA tool — only
// values the project's own content states.
const eda = data.specs.find((s) => s.label.trim().toLowerCase() === "eda")?.value;
const metaItems = [
  data.role,
  data.versions.length > 1 ? `${data.versions.length} board versions` : undefined,
  eda,
].filter((m): m is string => !!m);

// "On this page": only the sections this page renders, in page order
// (the write-up's H2 ids come from Astro's heading slugs).
const hasModels = data.models.length > 0;
const toc = [
  ...(versions.length > 1 ? [{ id: "versions-heading", text: "Versions" }] : []),
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  ...(hasModels ? [{ id: "bv-heading", text: "Interactive 3D board" }] : []),
  ...(renders.length > 0 ? [{ id: "renders-heading", text: "Board renders" }] : []),
  ...(dashboards.length > 0 ? [{ id: "outcome-heading", text: "Outcome" }] : []),
];
const hasLinks = !!(data.links.oshwlab || data.links.liveDemo);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: data.title,
  description: data.summary,
  url: canonicalProjectUrl,
  keywords: data.tags.map(formatTag).join(", "),
  creator: { "@type": "Person", name: (await getProfile()).data.name, url: siteUrl },
  ...(coverAbsoluteUrl && { image: coverAbsoluteUrl }),
};
---

<BaseLayout title={data.title} description={data.summary} ogImage={ogImageUrl} ogImageAlt={`${data.title} — PCB project by Sultan Mahmud Saad`} ogType="article">
  <script is:inline slot="head" type="application/ld+json" set:html={toJsonLd(jsonLd)} />

  <article class="project" aria-labelledby="project-title">
    <!-- Header -->
    <header class="project-head container">
      <div class="project-head__main">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol role="list">
            <li><a href={pageUrl("/")}>Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={pageUrl("/projects/")}>Projects</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{data.title}</li>
          </ol>
        </nav>
        <h1 class="page-title project-head__title" id="project-title">{data.title}</h1>
        <p class="project-head__summary">{data.summary}</p>
        {metaItems.length > 0 && (
          <ul class="meta-row project-head__meta" role="list" aria-label="Project facts">
            {metaItems.map((m) => <li>{m}</li>)}
          </ul>
        )}
        {data.tags.length > 0 && (
          <div class="project-head__tags" role="group" aria-label="Technologies">
            {data.tags.map((tag) => <TagChip tag={tag} />)}
          </div>
        )}
        {hasLinks && (
          <div class="project-head__links">
            {data.links.oshwlab && (
              <a href={data.links.oshwlab} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">OSHWLab<span class="sr-only"> (opens in new tab)</span></a>
            )}
            {data.links.liveDemo && (
              <a href={data.links.liveDemo} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">Live demo<span class="sr-only"> (opens in new tab)</span></a>
            )}
          </div>
        )}
      </div>

      {(data.specs.length > 0 || cover) && (
        <aside class="spec-card" aria-label="Key specifications">
          {cover && (
            <a href={assetUrl(cover.src)} target="_blank" rel="noopener" class="spec-card__img-link" aria-label={`Open full-size image: ${cover.alt} (opens in new tab)`}>
              <PublicImage
                src={cover.src}
                alt={cover.alt}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) calc(100vw - 2rem), 460px"
                class="spec-card__img"
                loading="eager"
                fetchpriority="high"
              />
            </a>
          )}
          {data.specs.length > 0 && (
            <dl class="spec-card__list">
              {data.specs.map((s) => (
                <div class="spec-card__row">
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </aside>
      )}
    </header>

    <!-- Versions: one card per board revision -->
    {versions.length > 1 && (
      <section class="container project-section" aria-labelledby="versions-heading">
        <SectionHeading
          label="// versions"
          title="Versions"
          id="versions-heading"
          description={`This project has ${versions.length} board versions. Each card shows what is different; open one in the 3D viewer below.`}
        />
        <ol class="versions" role="list">
          {versions.map((v, i) => (
            <li class="version">
              {v.img && (
                <div class="version__img">
                  <PublicImage src={v.img.src} alt={v.img.alt} widths={[360, 540, 720]} sizes="(max-width: 700px) calc(100vw - 4rem), 360px" />
                </div>
              )}
              <div class="version__body">
                <p class="version__num">Version {i + 1}</p>
                <h3 class="version__title">{v.label}</h3>
                <p class="version__summary">{v.summary}</p>
                {v.highlights.length > 0 && (
                  <ul class="version__list">
                    {v.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
                {v.has3d && (
                  <button type="button" class="btn btn--secondary version__btn" data-select-board={v.model}>View in 3D <span aria-hidden="true">↓</span></button>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Write-up -->
    <div class="container project-section project-body">
      <div class="prose project-prose">
        <Content />
      </div>
      {toc.length > 1 && (
        <aside class="project-aside" aria-label="On this page">
          <p class="project-aside__label">On this page</p>
          <ol class="project-aside__list" role="list">
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
          </ol>
          {hasLinks && (
            <ul class="project-aside__links" role="list">
              {data.links.oshwlab && (
                <li><a href={data.links.oshwlab} class="link-arrow" target="_blank" rel="noopener noreferrer">OSHWLab <span class="link-arrow__icon" aria-hidden="true">↗</span><span class="sr-only"> (opens in new tab)</span></a></li>
              )}
              {data.links.liveDemo && (
                <li><a href={data.links.liveDemo} class="link-arrow" target="_blank" rel="noopener noreferrer">Live demo <span class="link-arrow__icon" aria-hidden="true">↗</span><span class="sr-only"> (opens in new tab)</span></a></li>
              )}
            </ul>
          )}
        </aside>
      )}
    </div>

    <!-- Interactive 3D board(s) -->
    {hasModels && (
      <div class="container project-section">
        <BoardViewer models={data.models} title={data.title} />
      </div>
    )}

    <!-- Board renders: the 3D renders exported from EasyEDA -->
    {renders.length > 0 && (
      <section class="container project-section" aria-labelledby="renders-heading">
        <SectionHeading label="// renders" title="Board renders" id="renders-heading" />
        <div class:list={["gallery", { "gallery--single": renders.length === 1 }]}>
          {renders.map((img) => (
            <figure class="gallery__item">
              <a href={assetUrl(img.src)} target="_blank" rel="noopener" class="gallery__link" aria-label={`Open full-size image: ${img.caption ?? img.alt} (opens in new tab)`}>
                <PublicImage src={img.src} alt={img.alt} widths={[400, 760, 1140, 1520]} sizes={renders.length === 1 ? "(max-width: 800px) calc(100vw - 2rem), 768px" : "(max-width: 700px) calc(100vw - 2rem), 380px"} class="gallery__img" />
              </a>
              {img.caption && <figcaption class="gallery__caption">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Outcome: dashboard screenshots, only when the project has one -->
    {dashboards.length > 0 && (
      <section class="container project-section" aria-labelledby="outcome-heading">
        <SectionHeading label="// outcome" title="Outcome" id="outcome-heading" description="How the project's dashboard looks." />
        <div class:list={["dashboards", { "dashboards--phone": dashboards.every((d) => d.height > d.width * 1.6) }]}>
          {dashboards.map((img) => (
            <figure class="dashboard">
              <a href={assetUrl(img.src)} target="_blank" rel="noopener" class="dashboard__link" aria-label={`Open full-size image: ${img.caption ?? img.alt} (opens in new tab)`}>
                <PublicImage src={img.src} alt={img.alt} widths={[390, 800, 1200, 1600]} sizes={dashboards.length > 1 ? "320px" : "(max-width: 960px) calc(100vw - 3rem), 896px"} class="dashboard__img" />
              </a>
              {img.caption && <figcaption class="gallery__caption">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Previous / next -->
    <div class="container">
    <nav class="project-nav" aria-label="More projects">
      <div class="project-nav__head">
        <p class="section-label project-nav__label">// more projects</p>
        <a href={pageUrl("/projects/")} class="link-arrow">All projects <span class="link-arrow__icon" aria-hidden="true">→</span></a>
      </div>
      <div class="project-nav__cards">
        {prev ? (
          <a href={projectUrl(prev)} class="project-nav__link">
            <span class="project-nav__dir"><span aria-hidden="true">←</span> Previous</span>
            <span class="project-nav__name">{prev.data.title}</span>
          </a>
        ) : <span aria-hidden="true" />}
        {next ? (
          <a href={projectUrl(next)} class="project-nav__link project-nav__link--next">
            <span class="project-nav__dir">Next <span aria-hidden="true">→</span></span>
            <span class="project-nav__name">{next.data.title}</span>
          </a>
        ) : <span aria-hidden="true" />}
      </div>
    </nav>
    </div>
  </article>
</BaseLayout>

<style>
  /* ── Breadcrumb (the head's eyebrow) ────────────────────────────────── */
  .breadcrumb {
    margin-bottom: var(--space-4);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0;
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    line-height: 1.25rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .breadcrumb li + li {
    margin-top: 0;
  }

  /* 20 px line + 2 × 12 px padding = 44 px tap height; the negative margin
     keeps the line where it was. */
  .breadcrumb a {
    display: inline-block;
    padding-block: var(--space-3);
    margin-block: calc(-1 * var(--space-3));
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .breadcrumb [aria-current="page"] {
    color: var(--text-muted);
  }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .project-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
    padding-block: var(--space-12) var(--space-16);
  }

  .project-head__meta {
    margin-bottom: var(--space-6);
  }

  .project-head__meta li + li {
    margin-top: 0;
  }

  .project-head__title {
    margin-bottom: var(--space-4);
  }

  .project-head__summary {
    max-width: 38rem;
    margin: 0 0 var(--space-4);
    font-size: var(--fs-18);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .project-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-head__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* Key specs card: render on a plate + spec list, thin gradient rule on top */
  .spec-card {
    position: relative;
    padding: var(--space-2);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden; /* clips the top rule to the rounded corners */
  }

  .spec-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 2px;
    background: var(--gradient-accent);
  }

  .spec-card__img-link {
    display: block;
    border-radius: calc(var(--radius-lg) - var(--space-2));
    overflow: hidden;
  }

  .spec-card__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    box-sizing: border-box;
    padding: var(--space-6);
    background:
      radial-gradient(ellipse 65% 65% at 50% 50%, var(--accent-glow), transparent 72%),
      var(--bg-elevated);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .spec-card__img-link:hover .spec-card__img {
      transform: scale(1.02);
    }
  }

  .spec-card__list {
    display: grid;
    padding: var(--space-2) var(--space-4) var(--space-1);
  }

  .spec-card__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    align-items: baseline;
  }

  .spec-card__row:last-child {
    border-bottom: 0;
  }

  .spec-card__row dt {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .spec-card__row dd {
    font-size: var(--fs-14);
    line-height: 1.5;
    font-weight: 500;
    color: var(--text-primary);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* ── Sections ───────────────────────────────────────────────────────── */
  .project-section {
    margin-bottom: var(--space-24);
  }

  /* Write-up: one reading column (≤ 38rem, global .prose); at ≥ 1024 px a
     sticky "On this page" aside fills the right side. */
  .project-prose {
    max-width: 38rem;
  }

  .project-aside {
    display: none;
  }

  @media (min-width: 1024px) {
    .project-body {
      display: grid;
      grid-template-columns: minmax(0, 38rem) minmax(12rem, 16rem);
      justify-content: space-between;
      gap: var(--space-16);
      align-items: start;
    }

    .project-aside {
      display: block;
      position: sticky;
      top: calc(var(--nav-height) + var(--space-8));
      padding-left: var(--space-6);
      border-left: 1px solid var(--border-subtle);
    }
  }

  .project-aside__label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .project-aside__list,
  .project-aside__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-aside__list li + li,
  .project-aside__links li + li {
    margin-top: 0;
  }

  .project-aside__list a {
    display: block;
    padding-block: var(--space-1);
    font-size: var(--fs-14);
    line-height: 1.5;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .project-aside__list a:hover {
    color: var(--accent);
  }

  .project-aside__links {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  /* Versions */
  .versions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .versions > li + li {
    margin-top: 0;
  }

  .version {
    display: flex;
    flex-direction: column;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    box-shadow: var(--shadow-sm);
  }

  .version__img {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - var(--space-2));
    background:
      radial-gradient(ellipse 65% 65% at 50% 50%, var(--accent-glow), transparent 72%),
      var(--bg-elevated);
  }

  /* Fixed box: tall boards (e.g. the L-shaped V1.2) scale down instead of stretching the card */
  .version__img :global(img) {
    position: absolute;
    inset: var(--space-6);
    width: calc(100% - 2 * var(--space-6));
    height: calc(100% - 2 * var(--space-6));
    object-fit: contain;
  }

  .version__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4) var(--space-4);
  }

  .version__num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }

  .version__title {
    margin: 0;
    font-size: var(--fs-18);
    font-weight: 600;
  }

  .version__summary {
    margin: 0;
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .version__list {
    margin: var(--space-2) 0 var(--space-6);
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--border-subtle);
    list-style: none;
    font-size: var(--fs-14);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .version__list li {
    position: relative;
    padding-left: var(--space-4);
  }

  .version__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--text-muted);
  }

  .version__list li + li {
    margin-top: var(--space-2);
  }

  .version__btn {
    margin-top: auto;
    align-self: flex-start;
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-14);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-6);
  }

  /* One render: large and centred, never a lone half-width card */
  .gallery--single {
    grid-template-columns: minmax(0, 48rem);
    justify-content: center;
  }

  .gallery__item,
  .dashboard {
    margin: 0;
    padding: var(--space-2);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .gallery__link,
  .dashboard__link {
    display: block;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - var(--space-2));
    background: var(--bg-elevated);
  }

  .gallery__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: var(--space-4);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery__link:hover .gallery__img {
      transform: scale(1.025);
    }
  }

  .gallery__caption {
    padding: var(--space-3) var(--space-2) var(--space-1);
    font-family: var(--font-body);
    font-size: var(--fs-14);
    line-height: 1.5;
