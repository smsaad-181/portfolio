---
/**
 * Resume page — /resume/
 * Saad's CV, laid out like his own PDF (LaTeX, Charter, A4, black on white):
 * centred small-caps name with contact line and framed photo, then
 * Professional Summary, Education, Work Experience, Projects, Ongoing
 * Projects, Technical Skills, Training Courses, Extracurricular Activities
 * and References. The text comes word for word from the resume singleton
 * (src/content/resume/cv.json); email, LinkedIn, GitHub and location from
 * the profile. "Download PDF" serves his exact PDF (npm run cv:import).
 * Saad chose to publish the phone number and referees as in the PDF.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import CvText from "@components/CvText.astro";
import { Image } from "astro:assets";
import "../styles/charter.css";
import photo from "../assets/profile/cv-photo.jpg";
import { getProfile, getResume, getResumeUrl, resumeFileName } from "../lib/profile";
import { getAllProjectIds, getPublishedProjects } from "../lib/projects";
import { projectUrl } from "../lib/urls";
import resumeMeta from "../data/resume.json";

const profile = await getProfile();
const { data } = profile;
const cv = (await getResume()).data;
const resumeUrl = getResumeUrl(profile);

// Project titles may link to their project page (shown as plain text, like
// the PDF's hidden links). An unknown slug fails the build (a typo in
// cv.json); a draft project is listed without a link.
const projectIds = await getAllProjectIds();
const published = await getPublishedProjects();
const cvProjects = cv.projects.map((p) => {
  const slug = p.project?.trim();
  if (slug && !projectIds.has(slug)) {
    throw new Error(`src/content/resume/cv.json: project "${p.title}" links to unknown project "${slug}"`);
  }
  const entry = slug ? published.find((e) => e.id === slug) : undefined;
  return { ...p, href: entry ? projectUrl(entry) : undefined };
});
const projectSections = [
  { heading: "Projects", items: cvProjects.filter((p) => !p.ongoing) },
  { heading: "Ongoing Projects", items: cvProjects.filter((p) => p.ongoing) },
].filter((s) => s.items.length > 0);

const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const tel = (n: string) => `tel:${n.replace(/[^+\d]/g, "")}`;
const updated = new Date(resumeMeta.updated).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<BaseLayout title="Resume" description={`CV of ${cv.name}, ${data.title} in ${data.location}: experience, projects, skills and education.`}>
  <section class="resume" aria-labelledby="resume-heading">
    <div class="container">
      <div class="resume-bar">
        <div>
          <p class="section-label">// cv</p>
          <h1 class="resume-bar__title" id="resume-heading">Resume</h1>
          <p class="resume-bar__updated">Last updated: <time datetime={resumeMeta.updated}>{updated}</time></p>
        </div>
        <div class="resume-bar__actions">
          {resumeUrl && (
            <a href={resumeUrl} download={resumeFileName(cv.name)} class="btn btn--primary"><Icon name="download" />Download PDF</a>
          )}
          <button type="button" class="btn btn--secondary" data-print><Icon name="print" />Print</button>
        </div>
      </div>

      <article class="cv" aria-label={`CV of ${cv.name}`}>
        <header class="cv__head">
          <div class="cv__id">
            <h2 class="cv__name" aria-label={cv.name}>{cv.name.split(" ").map((w, i) => <Fragment>{i > 0 && " "}{w.charAt(0)}<span class="cv__sc">{w.slice(1)}</span></Fragment>)}</h2>
            <p class="cv__loc">{data.location}</p>
            <p class="cv__contact">
              {cv.phone && (
                <span class="cv__ci"><Icon name="phone" size={12} class="cv__ico cv__ico--phone" /><span class="sr-only">Phone: </span><a href={tel(cv.phone)}>{cv.phone}</a></span>
              )}
              <span class="cv__ci"><Icon name="envelope" size={12} class="cv__ico cv__ico--envelope" /><span class="sr-only">Email: </span><a href={`mailto:${data.email}`}>{data.email}</a></span>
            </p>
            <p class="cv__contact cv__contact--2">
              {data.socialLinks.linkedin && (
                <span class="cv__ci"><Icon name="linkedin-box" size={12} class="cv__ico cv__ico--linkedin" /><span class="sr-only">LinkedIn: </span><a href={data.socialLinks.linkedin}>{host(data.socialLinks.linkedin)}</a></span>
              )}
              {data.socialLinks.github && (
                <span class="cv__ci"><Icon name="github" size={12} class="cv__ico" /><span class="sr-only">GitHub: </span><a href={data.socialLinks.github}>{host(data.socialLinks.github)}</a></span>
              )}
            </p>
          </div>
          <Image src={photo} alt={`Photo of ${cv.name}`} widths={[95, 190, 285]} sizes="95px" class="cv__photo" loading="eager" />
        </header>

        <section class="cv__section">
          <h3 class="cv__h">Professional Summary</h3>
          <p><CvText text={cv.summary} /></p>
        </section>

        {cv.education.length > 0 && (
          <section class="cv__section">
            <h3 class="cv__h">Education</h3>
            {cv.education.map((e) => (
              <div class="cv__entry">
                <p class="cv__row"><span class="cv__b">{e.school}</span><span class="cv__b">{e.dates}</span></p>
                <p class="cv__row"><span class="cv__i">{e.degree}</span>{e.location && <span class="cv__i cv__sm">{e.location}</span>}</p>
              </div>
            ))}
          </section>
        )}

        {cv.experience.length > 0 && (
          <section class="cv__section">
            <h3 class="cv__h">Work Experience</h3>
            {cv.experience.map((e) => (
              <div class="cv__entry cv__entry--job">
                <p class="cv__row"><span class="cv__b">{e.org}</span><span class="cv__b">{e.dates}</span></p>
                <p class="cv__row"><span class="cv__i">{e.role}</span>{e.location && <span class="cv__i cv__sm">{e.location}</span>}</p>
                {e.responsibilities.length > 0 && (
                  <Fragment>
                    <p class="cv__sub">Responsibilities</p>
                    <ul class="cv__list">{e.responsibilities.map((b) => <li><CvText text={b} /></li>)}</ul>
                  </Fragment>
                )}
                {e.achievements.length > 0 && (
                  <Fragment>
                    <p class="cv__sub">Achievements</p>
                    <ul class="cv__list">{e.achievements.map((b) => <li><CvText text={b} /></li>)}</ul>
                  </Fragment>
                )}
              </div>
            ))}
          </section>
        )}

        {projectSections.map((s) => (
          <section class="cv__section">
            <h3 class="cv__h">{s.heading}</h3>
            {s.items.map((p) => (
              <div class="cv__entry cv__entry--project">
                <p class="cv__row">
                  <span class="cv__b">{p.href ? <a class="cv__plain" href={p.href}>{p.title}</a> : p.title}</span>
                  {p.note && <span class="cv__i cv__sm">{p.note}</span>}
                </p>
                {p.tech && <p class="cv__tech">Technologies: {p.tech}</p>}
                {p.bullets.length > 0 && (
                  <ul class="cv__list">{p.bullets.map((b) => <li><CvText text={b} /></li>)}</ul>
                )}
              </div>
            ))}
          </section>
        ))}

        {cv.skills.length > 0 && (
          <section class="cv__section">
            <h3 class="cv__h">Technical Skills</h3>
            <dl class="cv__skills">
              {cv.skills.map((r) => (
                <div class="cv__skillrow">
                  <dt>{r.label}</dt>
                  <dd>{r.items}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {cv.training.length > 0 && (
          <section class="cv__section">
            <h3 class="cv__h">Training Courses</h3>
            <ul class="cv__list">{cv.training.map((t) => <li><CvText text={t} /></li>)}</ul>
          </section>
        )}

        {cv.activities.length > 0 && (
          <section class="cv__section">
            <h3 class="cv__h">Extracurricular Activities</h3>
            <ul class="cv__list">{cv.activities.map((a) => <li><CvText text={a} /></li>)}</ul>
          </section>
        )}

        {cv.references.length > 0 && (
          <section class="cv__section">
            <h3 class="cv__h">References</h3>
            <div class="cv__refs">
              {cv.references.map((r) => (
                <div class="cv__ref">
                  <p class="cv__b">{r.name}</p>
                  {r.title && <p class="cv__i">{r.title}</p>}
                  {r.org && <p>{r.org}</p>}
                  {r.email && (
                    <p><span class="cv__refico"><Icon name="envelope" size={12} class="cv__ico cv__ico--ref-envelope" /></span><span class="sr-only">Email: </span><a class="cv__plain" href={`mailto:${r.email}`}>{r.email}</a></p>
                  )}
                  {r.phone && (
                    <p><span class="cv__refico"><Icon name="phone" size={12} class="cv__ico cv__ico--ref-phone" /></span><span class="sr-only">Phone: </span>{r.phone}</p>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>

<style>
  .resume {
    padding-block: var(--space-16);
  }

  .resume-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .resume-bar__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: var(--space-2) 0 var(--space-1);
  }

  .resume-bar__updated {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .resume-bar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .resume-bar__actions .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* ── The CV sheet: Saad's LaTeX CV (article 10pt, charter, A4,
        margins 1.6 cm × 1.1 cm, \linespread{1.05}) ─────────────────────── */
  .cv {
    max-width: 210mm;
    margin-inline: auto;
    padding: 1.1cm 1.6cm;
    background: var(--paper-bg);
    color: var(--paper-ink);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-family: "Charter", "Bitstream Charter", Georgia, serif;
    font-size: 10pt;
    line-height: 12.6pt;
    font-kerning: normal;
    /* LaTeX justifies text and its word spaces may shrink: justify + slightly
       tighter word spacing gives the PDF's line breaks (measured: all 970 words
       break on the same line as in the PDF) */
    text-align: justify;
    word-spacing: -0.07em;
    hyphens: manual;
  }

  .cv p {
    margin: 0;
  }

  .cv a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.5pt;
    text-underline-offset: 1.5pt;
  }

  /* \href without \ulink: a link that looks like plain text (hidelinks) */
  .cv a.cv__plain {
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .cv a.cv__plain:hover {
      text-decoration: underline;
    }
  }

  .cv__b {
    font-weight: 700;
  }

  .cv__i {
    font-style: italic;
  }

  .cv__sm {
    font-size: 9pt;
  }

  /* Header: text centred on the full width, photo overlaid at the right margin */
  .cv__head {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(3.1cm + 1pt);
  }

  /* Room for the photo on both sides keeps the text centred and clear of it */
  .cv__id {
    text-align: center;
    padding-inline: calc(2.5cm + 4mm);
  }

  /* \scshape in LaTeX: capitals + small capitals at 80% (Charter has no real
     small caps; the browser's fake ones would be only 70%) */
  .cv__name {
    margin: 0;
    font-family: inherit;
    font-size: 26pt;
    line-height: 30pt;
    font-weight: 400;
    letter-spacing: 0;
    word-spacing: 0.048em;
    color: var(--paper-ink);
    text-box: trim-start cap alphabetic;
  }

  @supports not (text-box: trim-start cap alphabetic) {
    .cv__name {
      margin-top: -8pt;
    }
  }

  /* LaTeX's scaled capitals sit a little apart and are set a little wider;
     word spaces in the name are wider too (all measured on the PDF) */
  .cv__sc {
    margin-left: 0.06em;
    font-size: 0.8em;
    line-height: 1;
    letter-spacing: 0.047em;
    text-transform: uppercase;
  }

  .cv__loc {
    margin-top: 1.3pt !important;
    font-size: 9pt;
    line-height: 11.5pt;
  }

  .cv__contact {
    margin-top: 4pt !important;
    font-size: 9pt;
    line-height: 11.5pt;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 1.75em;
  }

  .cv__contact--2 {
    margin-top: 3pt !important;
  }

  /* \underline: a thin rule below the descenders (a CSS underline rounds up
     to 1 px and breaks around descenders) */
  .cv__contact a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 1.6px) / 100% 0.4pt no-repeat;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .cv__ci {
    white-space: nowrap;
  }

  /* The <svg> is rendered by Icon.astro, outside this page's style scope.
     Sizes and the phone's direction match the PDF's Font Awesome icons. */
  .cv :global(.cv__ico) {
    width: 1em;
    height: 1em;
    margin-right: 0.28em;
    vertical-align: -0.12em;
  }

  .cv :global(.cv__ico--phone) {
    scale: -1.33 1.33;
  }

  .cv :global(.cv__ico--envelope) {
    scale: 1.2;
  }

  .cv :global(.cv__ico--linkedin) {
    scale: 0.875;
  }

  .cv :global(.cv__ico--ref-envelope) {
    scale: 1.18;
  }

  .cv :global(.cv__ico--ref-phone) {
    scale: -1.3 1.3;
  }

  /* \fcolorbox 0.5pt around a full 2.5 × 3.1 cm photo */
  .cv__photo {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    box-sizing: content-box;
    width: 2.5cm;
    height: 3.1cm;
    object-fit: cover;
    border: 0.5pt solid var(--paper-ink);
  }

  /* \section: \large\bfseries, uppercase, 0.5pt rule (drawn as a background
     so it stays 0.5pt on high-density screens); spacing measured on the PDF */
  .cv__section {
    margin-top: 10.5pt;
  }

  .cv__h {
    margin: 0 0 3.3pt;
    padding-bottom: 2pt;
    background: linear-gradient(var(--paper-ink), var(--paper-ink)) left bottom / 100% 0.5pt no-repeat;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    font-family: inherit;
    font-size: 12pt;
    line-height: 14.5pt;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--paper-ink);
    break-after: avoid;
  }

  /* \entry / \project: bold line + italic line, right-aligned dates/notes */
  .cv__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1em;
  }

  .cv__row > :last-child:not(:first-child) {
    text-align: right;
    white-space: nowrap;
  }

  /* \entry adds 2pt after the italic line */
  .cv__entry > .cv__row + .cv__row {
    padding-bottom: 1.5pt;
  }

  .cv__entry + .cv__entry {
    margin-top: 6pt;
  }

  .cv__entry {
    break-inside: avoid;
  }

  .cv__entry--job {
    break-inside: auto;
  }

  .cv__sub {
    margin-top: 3.5pt !important;
    font-size: 9pt;
    line-height: 11.5pt;
    font-weight: 700;
    font-style: italic;
    break-after: avoid;
  }

  .cv__tech {
    font-size: 9pt;
    line-height: 11.5pt;
    font-style: italic;
    color: var(--paper-subtle);
  }

  /* itemize: leftmargin 1.3em, \textbullet, topsep 2pt, itemsep 1pt; the
     space after a list is padding (a margin would collapse away) */
  .cv__list {
    margin: 2pt 0 0;
    padding: 0 0 2pt 1.3em;
    list-style: none;
  }

  .cv__list li {
    position: relative;
  }

  .cv__list li::before {
    content: "•";
    position: absolute;
    left: -0.95em;
    scale: 1.3;
  }

  .cv__list li + li {
    margin-top: 1pt;
  }

  /* Skills: tabularx, bold first column 3.6 cm (+12pt column padding),
     \arraystretch 1.25 */
  .cv__skills {
    margin: 0;
    padding-top: 2pt;
  }

  .cv__skillrow {
    display: grid;
    grid-template-columns: calc(3.6cm + 12pt) 1fr;
    padding-block: 1.6pt;
  }

  .cv__skillrow dt {
    font-weight: 700;
  }

  .cv__skillrow dd {
    margin: 0;
  }

  /* References: two equal columns, icons in a 1.4em slot */
  .cv__refs {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .cv__refico {
    display: inline-block;
    width: 1.4em;
  }

  .cv__refico :global(.cv__ico) {
    margin-right: 0;
  }

  /* Phones: photo on top, dates under titles, single columns */
  @media screen and (max-width: 720px) {
    /* Justified text leaves wide gaps on a narrow screen */
    .cv {
      padding: var(--space-6) var(--space-4);
      text-align: left;
      word-spacing: normal;
    }

    .cv__head {
      flex-direction: column;
      gap: var(--space-4);
    }

    .cv__id {
      padding-inline: 0;
    }

    .cv__photo {
      position: static;
      translate: none;
      order: -1;
    }

    .cv__name {
      margin-top: 0;
      font-size: 20pt;
      line-height: 24pt;
    }

    .cv__row {
      flex-direction: column;
      gap: 0;
    }

    .cv__row > :last-child:not(:first-child) {
      text-align: left;
      white-space: normal;
    }

    .cv__ci {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .cv__skillrow,
    .cv__refs {
      grid-template-columns: 1fr;
    }

    .cv__ref + .cv__ref {
      margin-top: var(--space-4);
    }
  }

  /* ── Print: only the CV sheet, A4 with the PDF's margins ─────────────── */
  @page {
    size: A4;
    margin: 1.1cm 1.6cm;
  }

  @media print {
    :global(.nav-wrapper),
    :global(.footer),
    :global(.skip-link),
    .resume-bar {
      display: none !important;
    }

    :global(html),
    :global(body) {
      background: var(--paper-bg) !important;
    }

    .resume {
      padding: 0;
    }

    .resume :global(.container) {
      max-width: none;
      padding: 0;
    }

    .cv {
      max-width: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0;
    }

    .cv a.cv__plain {
      text-decoration: none;
    }
  }
</style>
