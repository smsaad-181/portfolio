---
/**
 * Homepage — /
 * Hero in Saad's chosen style: "Hello, I'm", gradient name, role pill, bio
 * with underlined highlights, flowing line-art and glows, and his cut-out
 * portrait on the right fading into the page, professional links and real
 * counts (published projects, boards in 3D). Then "About me" (profile.about,
 * from Saad's GitHub profile, plus his current role), featured projects
 * (CMS-controlled via `featured` + `order`), skills + tools and the CV CTA.
 *
 * Portrait: src/assets/profile/portrait.{png,webp,jpg} — a transparent-
 * background cut-out looks best. Optimised by Astro's <Image />.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatTag } from "../lib/tags";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SkillBar from "@components/SkillBar.astro";
import ResumeButton from "@components/ResumeButton.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getFeaturedProjects, getPublishedProjects } from "../lib/projects";
import { getProfile } from "../lib/profile";
import { pageUrl, projectUrl } from "../lib/urls";

const profile = await getProfile();
const featured = await getFeaturedProjects();
const allSkills = await getCollection("skills");
const currentJob = (await getCollection("experience")).find((e) => e.data.current);
const published = await getPublishedProjects();
const boardCount = published.reduce((n, p) => n + p.data.models.length, 0);
// Real counts from the content unless Saad has entered his own stats.
const stats = profile.data.stats?.length
  ? profile.data.stats
  : [
      { value: String(published.length), label: "PCB projects" },
      { value: String(boardCount), label: "boards in interactive 3D" },
    ];
const about = profile.data.about ?? [];
const tools = profile.data.tools ?? [];
const sinceYear = currentJob ? new Date(currentJob.data.startDate).getFullYear() : null;
const social = [
  profile.data.socialLinks.linkedin && { label: "LinkedIn", href: profile.data.socialLinks.linkedin, icon: "linkedin" },
  profile.data.socialLinks.github && { label: "GitHub", href: profile.data.socialLinks.github, icon: "github" },
  profile.data.socialLinks.oshwlab && { label: "OSHWLab", href: profile.data.socialLinks.oshwlab, icon: "oshwlab" },
  { label: "Email", href: `mailto:${profile.data.email}`, icon: "email" },
].filter((l): l is { label: string; href: string; icon: string } => Boolean(l));
const ICONS: Record<string, string> = {
  linkedin: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.6 4.77 6v5.46h-4v-4.84c0-1.15-.02-2.64-1.6-2.64-1.62 0-1.86 1.26-1.86 2.56v4.92h-4v-11Z",
  github: "M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z",
  oshwlab: "M7 3h10v2h2v2h2v2h-2v2h2v2h-2v2h2v2h-2v2h-2v2H7v-2H5v-2H3v-2h2v-2H3v-2h2V9H3V7h2V5h2V3Zm2 4v10h6V7H9Z",
  email: "M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.3-8-5.3ZM5.2 7 12 11.5 18.8 7H5.2Z",
};

// Portrait — first match wins.
const portraitFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/profile/portrait.{png,webp,avif,jpg,jpeg}",
  { eager: true }
);
const portrait = Object.values(portraitFiles)[0]?.default;

const initials = profile.data.name
  .split(" ")
  .map((w) => w.charAt(0))
  .join("")
  .slice(0, 2)
  .toUpperCase();

// Group skills by category (lowercase stored, title-case at render)
const skillsByCategory = allSkills.reduce<Record<string, typeof allSkills>>(
  (acc, skill) => {
    const cat = skill.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat]!.push(skill);
    return acc;
  },
  {}
);


// Flowing line-art for the hero background: a family of cubic curves whose
// four points each drift by a fixed step per line, which reads as silk/waves.
type Pt = [x: number, y: number, dx: number, dy: number];
function wavePaths(count: number, p0: Pt, c1: Pt, c2: Pt, p3: Pt): string[] {
  const at = (p: Pt, i: number) => `${(p[0] + p[2] * i).toFixed(1)} ${(p[1] + p[3] * i).toFixed(1)}`;
  return Array.from({ length: count }, (_, i) =>
    `M${at(p0, i)} C${at(c1, i)} ${at(c2, i)} ${at(p3, i)}`
  );
}
const wavesTop = wavePaths(42, [120, -40, 7, 0], [100, 280, 5, -4], [540, 400, -3, -7], [680, 60, 0, 6]);
const wavesBottom = wavePaths(42, [-60, 140, 0, 6], [260, 20, 3, 5], [160, 560, 7, -3], [560, 620, 5, 0]);
const city = profile.data.location.split(",")[0];
---

<BaseLayout
  title="Sultan Mahmud — Hardware Engineer"
  fullTitle
  description={profile.data.summary}
>
  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero__bg" aria-hidden="true">
      <svg class="hero__waves hero__waves--top" viewBox="0 0 600 500" preserveAspectRatio="none">
        <defs>
          <linearGradient id="wave-top" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" style="stop-color: var(--hero-wave-a)" />
            <stop offset="100%" style="stop-color: var(--hero-wave-b)" />
          </linearGradient>
        </defs>
        <g fill="none" stroke="url(#wave-top)" stroke-width="0.8">
          {wavesTop.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
        </g>
      </svg>
      <svg class="hero__waves hero__waves--bottom" viewBox="0 0 600 500" preserveAspectRatio="none">
        <defs>
          <linearGradient id="wave-bottom" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" style="stop-color: var(--hero-wave-c)" />
            <stop offset="100%" style="stop-color: var(--hero-wave-d)" />
          </linearGradient>
        </defs>
        <g fill="none" stroke="url(#wave-bottom)" stroke-width="0.8">
          {wavesBottom.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
        </g>
      </svg>
    </div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="hero__greeting">Hello, I'm</p>
        <h1 class="hero__name" id="hero-name">{profile.data.name}</h1>

        <p class="hero__badge">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="hero__badge-icon">
            <rect x="6" y="6" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="9.5" y="9.5" width="5" height="5" rx="0.8" fill="currentColor" />
            <path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          {profile.data.title}
        </p>

        <p class="hero__bio">
          I design PCBs, write embedded firmware and build IoT products, taking
          an idea from the <span class="u">first schematic</span> to a
          <span class="u">working board</span>.
        </p>

        {currentJob && (
          <p class="hero__now">
            <span class="hero__now-dot" aria-hidden="true"></span>
            <span>{currentJob.data.role} at <strong>{currentJob.data.company}</strong> · {city}</span>
          </p>
        )}

        <div class="hero__actions">
          <a href={pageUrl("/projects/")} class="btn btn--primary">View projects</a>
          <ResumeButton variant="secondary" />
        </div>

        <ul class="hero__social" role="list" aria-label="Contact and profiles">
          {social.map((l) => (
            <li>
              <a
                href={l.href}
                class="hero__social-link"
                aria-label={l.href.startsWith("mailto") ? `Email ${profile.data.email}` : `${l.label} (opens in new tab)`}
                target={l.href.startsWith("mailto") ? undefined : "_blank"}
                rel={l.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={ICONS[l.icon]} /></svg>
              </a>
            </li>
          ))}
        </ul>

        {stats.length > 0 && (
          <dl class="hero__stats">
            {stats.map((s) => (
              <div class="hero__stat">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="hero__portrait">
        <div class="hero__portrait-glow" aria-hidden="true"></div>
        {portrait ? (
          <Image
            src={portrait}
            alt={`${profile.data.name}, ${profile.data.title}`}
            widths={[400, 600, 800, 1000, 1200]}
            sizes="(max-width: 900px) 340px, 560px"
            quality={90}
            loading="eager"
            fetchpriority="high"
            class="hero__photo"
          />
        ) : (
          <div class="hero__monogram" role="img" aria-label={profile.data.name}>
            <span>{initials}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ── About me (from Saad's GitHub profile) ────────────────────────────── -->
  {about.length > 0 && (
    <section class="section" aria-labelledby="about-heading">
      <div class="container about">
        <div class="about__intro">
          <SectionHeading label="// about me" title="Hardware, end to end" id="about-heading" />
          <p class="about__text">{profile.data.summary}</p>
          {currentJob && (
            <div class="about__role">
              <p class="about__role-label">Current role{sinceYear && ` · since ${sinceYear}`}</p>
              <p class="about__role-title">{currentJob.data.role}</p>
              <p class="about__role-company">{currentJob.data.company}</p>
            </div>
          )}
          <a href={pageUrl("/about/")} class="about__more">More about me <span aria-hidden="true">→</span></a>
        </div>
        <ul class="about__cards" role="list">
          {about.map((a, i) => (
            <li class="about__card">
              <span class="about__card-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="about__card-title">{a.label}</h3>
              <p class="about__card-text">{a.value}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ── Featured projects ───────────────────────────────────────────────── -->
  {featured.length > 0 && (
    <section class="section" aria-labelledby="featured-heading">
      <div class="container">
        <SectionHeading
          label="// selected work"
          title="Featured Projects"
          id="featured-heading"
          description="Boards I designed in EasyEDA Pro. Open any project to turn the PCB around in 3D and identify every part."
        />
        <div class="projects-grid">
          {featured.map((project) => (
            <ProjectCard
              title={project.data.title}
              href={projectUrl(project)}
              summary={project.data.summary}
              coverImage={project.data.coverImage}
              tags={project.data.tags}
              status={project.data.status}
            />
          ))}
        </div>
        <div class="projects-cta">
          <a href={pageUrl("/projects/")} class="btn btn--secondary">
            All projects →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── Skills ─────────────────────────────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="skills-heading">
    <div class="container">
      <SectionHeading
        label="// toolbox"
        title="Skills & Technologies"
        id="skills-heading"
        description="The hardware and software toolkit I reach for on every project."
      />
      <div class="skills-grid">
        {Object.entries(skillsByCategory).map(([category, skills]) => (
          <div class="skills-group">
            <h3 class="skills-group__title">{formatTag(category)}</h3>
            <div class="skills-group__list">
              {skills
                .sort((a, b) => (b.data.proficiency ?? 0) - (a.data.proficiency ?? 0))
                .map((skill) => (
                  <SkillBar name={skill.data.name} proficiency={skill.data.proficiency} />
                ))}
            </div>
          </div>
        ))}
      </div>
      {tools.length > 0 && (
        <div class="tools">
          <h3 class="skills-group__title">Also in my toolbox</h3>
          <ul class="tools__list" role="list">
            {tools.map((t) => <li class="tools__chip">{t}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- ── Resume CTA ─────────────────────────────────────────────────────── -->
  <section class="section cta-section" aria-label="Resume download">
    <div class="container cta-inner">
      <div>
        <p class="section-label">// work with me</p>
        <h2 class="cta-title">Looking to collaborate or hire?</h2>
        <p class="cta-body">
          I'm open to hardware engineering roles and IoT product development projects.
          Grab my CV or reach out directly.
        </p>
      </div>
      <div class="cta-actions">
        <ResumeButton variant="primary" />
        <a href={pageUrl("/contact/")} class="btn btn--secondary">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Sections ────────────────────────────────────────────────────────── */
  .section {
    padding-block: var(--space-24);
  }

  .section--alt {
    background: var(--bg-surface);
    border-block: 1px solid var(--border-subtle);
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Slide under the transparent sticky nav so the art fills the top edge */
    margin-top: calc(-1 * var(--nav-height));
    padding-top: var(--nav-height);
    min-height: min(100dvh, 820px);
    display: flex;
    align-items: stretch;
    background:
      radial-gradient(ellipse 60% 70% at 0% 100%, var(--hero-glow-pink), transparent 70%),
      radial-gradient(ellipse 55% 60% at 100% 0%, var(--hero-glow-blue), transparent 70%),
      var(--bg-base);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__waves {
    position: absolute;
    opacity: var(--hero-wave-opacity);
  }

  .hero__waves--top {
    top: -6%;
    right: -4%;
    width: 58%;
    height: 80%;
    animation: drift 18s ease-in-out infinite alternate;
  }

  .hero__waves--bottom {
    bottom: -14%;
    left: -6%;
    width: 50%;
    height: 75%;
    opacity: calc(var(--hero-wave-opacity) * 0.8);
    animation: drift 22s ease-in-out infinite alternate-reverse;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__waves--top,
    .hero__waves--bottom {
      animation: none;
    }
  }

  @keyframes drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to   { transform: translate3d(-14px, 10px, 0) rotate(-1.5deg); }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  .hero__content {
    padding-block: var(--space-12);
  }

  .hero__greeting {
    font-size: clamp(var(--fs-22), 3vw, 2rem);
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 0;
  }

  .hero__name {
    font-size: clamp(var(--fs-40), 5.5vw, 4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-6);
    background: var(--gradient-name);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.9rem 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--accent-2) 45%, transparent);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    font-size: var(--fs-16);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }

  .hero__badge-icon {
    width: 16px;
    height: 16px;
    color: var(--accent);
  }

  .hero__bio {
    font-size: var(--fs-18);
    line-height: 1.85;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    max-width: 56ch;
    margin-bottom: var(--space-8);
  }

  /* Gradient underline on highlighted words */
  .u {
    color: var(--text-primary);
    background-image: var(--gradient-accent);
    background-size: 100% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 2px;
  }

  .hero__now {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: calc(-1 * var(--space-4)) 0 var(--space-8);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .hero__now strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  .hero__now-dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero__social {
    display: flex;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__social li + li {
    margin-top: 0;
  }

  .hero__social-link {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-surface) 70%, transparent);
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .hero__social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }

  .hero__stat dd {
    font-size: var(--fs-28);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .hero__stat dt {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  /* Portrait — sits on the bottom edge and fades into the background */
  .hero__portrait {
    position: relative;
    align-self: end;
    display: flex;
    justify-content: center;
  }

  .hero__portrait-glow {
    position: absolute;
    bottom: 12%;
    left: 50%;
    width: 85%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 30%, transparent), transparent 65%);
    filter: blur(24px);
    z-index: -1;
  }

  .hero__photo {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
    /* any opaque token works here — a mask only reads alpha */
    -webkit-mask-image: linear-gradient(to bottom, var(--text-primary) 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, var(--text-primary) 80%, transparent 100%);
  }

  .hero__monogram {
    align-self: center;
    margin-bottom: 18vh;
    width: min(340px, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 3px;
    background: var(--gradient-accent);
    display: grid;
  }

  .hero__monogram span {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, var(--bg-elevated), var(--bg-base) 70%);
    font-family: var(--font-script);
    font-size: clamp(5rem, 12vw, 8rem);
    line-height: 1;
    color: var(--text-primary);
  }

  /* About me */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .about__text {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-6);
    max-width: 52ch;
  }

  .about__role {
    padding: var(--space-4) var(--space-6);
    border-left: 3px solid var(--accent);
    background: var(--bg-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: var(--space-6);
  }

  .about__role p {
    margin: 0;
  }

  .about__role-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .about__role .about__role-title {
    font-weight: 600;
    margin-top: var(--space-1);
  }

  .about__role-company {
    color: var(--text-secondary);
    font-size: var(--fs-14);
  }

  .about__more {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 600;
  }

  .about__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

