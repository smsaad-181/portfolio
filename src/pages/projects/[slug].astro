---
/**
 * Project detail page — /projects/[slug]/
 * getStaticPaths() over the projects collection, excluding draft entries.
 * Renders the full MDX write-up: problem → components → challenges → outcome.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import TagChip from "@components/TagChip.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getPublishedProjects } from "../../lib/projects";
import { absoluteUrl, assetUrl, pageUrl, projectSlug, projectUrl, publicFileExists } from "../../lib/urls";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: projectSlug(project) },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const siteUrl = absoluteUrl(pageUrl("/"));
const canonicalProjectUrl = absoluteUrl(projectUrl(project));

// Only render images that have actually been uploaded — never ship a 404
// or a public "upload via /admin" placeholder.
const cover = publicFileExists(project.data.coverImage.src) ? project.data.coverImage : null;
const gallery = project.data.gallery.filter((img) => publicFileExists(img.src));
const coverAbsoluteUrl = cover ? absoluteUrl(assetUrl(cover.src)) : undefined;

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });
}

// JSON-LD for this project (TechArticle helps search engines understand
// the engineering write-up structure)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": project.data.title,
  "description": project.data.summary,
  "author": {
    "@type": "Person",
    "name": "Sultan Mahmud",
    "url": siteUrl
  },
  "url": canonicalProjectUrl,
  "keywords": project.data.tags.join(", "),
  ...(project.data.dateCompleted && { "datePublished": project.data.dateCompleted }),
  ...(cover && {
    "image": {
      "@type": "ImageObject",
      "url": coverAbsoluteUrl,
      "description": cover.alt
    }
  })
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  ogImage={coverAbsoluteUrl}
>
  <!-- Per-page JSON-LD for this project -->
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Breadcrumb -->
  <nav class="breadcrumb container" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href={pageUrl("/")}>Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={pageUrl("/projects/")}>Projects</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{project.data.title}</li>
    </ol>
  </nav>

  <article class="project-detail" aria-label={project.data.title}>
    <!-- Hero -->
    <header class="project-header container">
      <div class="project-header__meta">
        <StatusBadge status={project.data.status} />
        {project.data.role && (
          <span class="project-header__role">{project.data.role}</span>
        )}
        {project.data.dateCompleted && (
          <time class="project-header__date">
            {formatDate(project.data.dateCompleted)}
          </time>
        )}
      </div>

      <h1 class="project-header__title">{project.data.title}</h1>
      <p class="project-header__summary">{project.data.summary}</p>

      <div class="project-header__tags" aria-label="Project tags">
        {project.data.tags.map((tag) => (
          <TagChip
            tag={tag}
            href={pageUrl(`/projects/?tag=${encodeURIComponent(tag.toLowerCase())}`)}
          />
        ))}
      </div>

      <!-- External links -->
      {(project.data.links.github || project.data.links.oshwlab || project.data.links.liveDemo) && (
        <div class="project-header__links" aria-label="Project links">
          {project.data.links.github && (
            <a href={project.data.links.github} target="_blank" rel="noopener noreferrer" class="ext-link">
              GitHub →
            </a>
          )}
          {project.data.links.oshwlab && (
            <a href={project.data.links.oshwlab} target="_blank" rel="noopener noreferrer" class="ext-link">
              OSHWLab →
            </a>
          )}
          {project.data.links.liveDemo && (
            <a href={project.data.links.liveDemo} target="_blank" rel="noopener noreferrer" class="ext-link">
              Live Demo →
            </a>
          )}
        </div>
      )}
    </header>

    <!-- Cover image -->
    {cover && (
      <div class="project-cover">
        <Image
          src={assetUrl(cover.src)}
          alt={cover.alt}
          width={1280}
          height={720}
          class="project-cover__img"
          loading="eager"
        />
      </div>
    )}

    <!-- Two-column: BOM highlights + MDX content -->
    <div class="project-body container">
      <!-- BOM sidebar (if present) -->
      {project.data.bomHighlights && project.data.bomHighlights.length > 0 && (
        <aside class="bom-sidebar" aria-label="Key components">
          <h2 class="bom-sidebar__title">
            <span aria-hidden="true">⚙</span> Key Components
          </h2>
          <ul class="bom-list" role="list">
            {project.data.bomHighlights.map((item) => (
              <li class="bom-item">
                <span class="bom-item__component">{item.component}</span>
                {item.notes && <p class="bom-item__notes">{item.notes}</p>}
              </li>
            ))}
          </ul>
        </aside>
      )}

      <!-- MDX write-up -->
      <div class:list={["prose", "project-prose", { "project-prose--full": !project.data.bomHighlights?.length }]}>
        <Content />
      </div>
    </div>

    <!-- Gallery -->
    {gallery.length > 0 && (
      <section class="gallery container" aria-label="Project gallery">
        <h2 class="gallery__title">Gallery</h2>
        <div class="gallery__grid">
          {gallery.map((img) => (
            <figure class="gallery__item">
              <Image
                src={assetUrl(img.src)}
                alt={img.alt}
                width={800}
                height={600}
                class="gallery__img"
                loading="lazy"
              />
              <figcaption class="gallery__caption">{img.alt}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Back link -->
    <div class="project-footer container">
      <a href={pageUrl("/projects/")} class="back-link">
        ← Back to Projects
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    padding-block: var(--space-4);
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb [aria-current="page"] { color: var(--text-primary); }

  /* Header */
  .project-header {
    padding-block: var(--space-8) var(--space-6);
  }

  .project-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .project-header__role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--bg-elevated);
  }

  .project-header__date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .project-header__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  .project-header__summary {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 65ch;
    margin-bottom: var(--space-4);
  }

  .project-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .project-header__links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .ext-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    transition: background 0.15s, border-color 0.15s;
  }

  .ext-link:hover {
    background: var(--accent-glow);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Cover image */
  .project-cover {
    width: 100%;
    max-height: 520px;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .project-cover__img {
    width: 100%;
    height: 520px;
    object-fit: cover;
  }

  /* Body: BOM sidebar + prose */
  .project-body {
    padding-block: var(--space-10);
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  .bom-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-4));
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-6);
  }

  .bom-sidebar__title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .bom-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bom-item__component {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-1);
  }

  .bom-item__notes {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .project-prose--full {
    grid-column: 1 / -1;
  }

  /* Gallery */
  .gallery {
    padding-bottom: var(--space-12);
  }

  .gallery__title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .gallery__item {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .gallery__img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .gallery__caption {
    font-size: 0.78rem;
    color: var(--text-muted);
    padding: var(--space-2) var(--space-3);
    font-style: italic;
  }

  .project-footer {
    padding-bottom: var(--space-16);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .back-link:hover { color: var(--accent); }

  /* Responsive */
  @media (max-width: 900px) {
    .project-body {
      grid-template-columns: 1fr;
    }

    .bom-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .project-cover__img {
      height: 240px;
    }
  }
</style>
