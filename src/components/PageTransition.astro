---
/**
 * PageTransition.astro — branded page-to-page transition (Saad, 24 Nov 2026:
 * "when I move from one page to another it needs animation").
 *
 * Clicking an internal page link: three panels (pink, violet, page colour)
 * sweep up over the page with the < Sultan Mahmud /> mark and a loading bar,
 * then the browser navigates. The next page opens by sweeping the panels
 * away upward. Works in every browser.
 *
 * Safe by design:
 *  • The entry sweep is pure CSS (forwards animation), so the page is never
 *    left covered even if JS fails; the cover only exists while the class
 *    set by BaseLayout's head script (pt-enter) or by a click (pt-leave) is on.
 *  • Skipped for reduced motion, new-tab / modifier clicks, downloads, files
 *    (PDF), external links and same-page (#hash) links.
 *  • Back/forward cache: the cover is removed when a page is restored.
 */
import Wordmark from "@components/Wordmark.astro";
---

<div class="pt" aria-hidden="true">
  <span class="pt__panel pt__panel--1"></span>
  <span class="pt__panel pt__panel--2"></span>
  <span class="pt__panel pt__panel--3">
    <span class="pt__mark"><Wordmark compact={false} /></span>
    <span class="pt__bar"><span class="pt__bar-fill"></span></span>
  </span>
</div>

<script>
  const root = document.documentElement;
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");
  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  const panel1 = document.querySelector<HTMLElement>(".pt__panel--1");
  const panel3 = document.querySelector<HTMLElement>(".pt__panel--3");

  // Entry sweep finished (last panel gone): drop the class so a later leave
  // starts clean. Timer = fallback if animationend never fires.
  if (root.classList.contains("pt-enter")) {
    const done = () => root.classList.remove("pt-enter");
    panel1?.addEventListener("animationend", done, { once: true });
    setTimeout(done, 1000);
  }

  /** Same-site page link that should get the transition, else null. */
  const pageLink = (target: EventTarget | null): URL | null => {
    const a = (target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
    if (!a || (a.target && a.target !== "_self") || a.hasAttribute("download")) return null;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin || !url.pathname.startsWith(base)) return null;
    if (/\.[a-z0-9]+$/i.test(url.pathname)) return null;
    if (url.pathname === location.pathname && url.search === location.search) return null;
    return url;
  };

  // Warm the next page while the pointer is on its link (and during the cover).
  const warmed = new Set<string>();
  const prefetch = (url: URL) => {
    if (warmed.has(url.pathname)) return;
    warmed.add(url.pathname);
    const l = document.createElement("link");
    l.rel = "prefetch"; l.href = url.pathname;
    document.head.append(l);
  };
  document.addEventListener("pointerover", (e) => { const u = pageLink(e.target); if (u) prefetch(u); }, { passive: true });
  document.addEventListener("focusin", (e) => { const u = pageLink(e.target); if (u) prefetch(u); });

  document.addEventListener("click", (e) => {
    if (still.matches || root.classList.contains("motion-paused") || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    // A page with unsaved input (contact form) may show "Leave page?": let the
    // browser navigate plainly so that dialog appears over the visible page.
    if (root.hasAttribute("data-unsaved")) return;
    const url = pageLink(e.target);
    if (!url) return;
    e.preventDefault();
    prefetch(url);
    try { sessionStorage.setItem("pt", "1"); } catch {}
    // Clicked while this page is still uncovering: go now, no restart jump.
    if (root.classList.contains("pt-enter") || root.classList.contains("pt-leave")) {
      location.assign(url.href);
      return;
    }
    root.classList.add("pt-leave");
    let gone = false;
    const go = () => {
      if (gone) return;
      gone = true;
      location.assign(url.href);
      // Still here long after (navigation cancelled / stopped): lift the cover.
      setTimeout(lift, 8000);
    };
    // Only panel 3's own sweep (its children's animations bubble up earlier).
    panel3?.addEventListener("animationend", (ev) => { if (ev.target === panel3) go(); });
    setTimeout(go, 600); // fallback
  });

  /** Remove any cover and the one-shot flag; the page is usable again. */
  const lift = () => {
    root.classList.remove("pt-leave", "pt-enter");
    try { sessionStorage.removeItem("pt"); } catch {}
  };

  // Visitor pressed Esc (stops loading in most browsers) while covered.
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && root.classList.contains("pt-leave")) lift(); });

  // Restored from the back/forward cache with the cover still up: lift it.
  window.addEventListener("pageshow", (e) => {
    if (e.persisted) lift();
  });
</script>

<style is:global>
  .pt {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    visibility: hidden;
  }

  :root.pt-leave .pt,
  :root.pt-enter .pt {
    visibility: visible;
  }

  :root.pt-leave .pt {
    pointer-events: auto; /* no double clicks while leaving */
  }

  .pt__panel {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }

  .pt__panel--1 { background: var(--accent); }
  .pt__panel--2 { background: var(--circuit-pulse-2); }

  .pt__panel--3 {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-6);
    background: var(--bg-base);
  }

  .pt__mark {
    opacity: 0;
    transform: translateY(12px) scale(0.96);
  }

  .pt__mark .wordmark__name {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    background: var(--gradient-name);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pt__mark .wordmark__bracket {
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    color: var(--text-secondary);
  }

  .pt__bar {
    width: min(220px, 50vw);
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    background: var(--border);
    opacity: 0;
  }

  .pt__bar-fill {
    display: block;
    height: 100%;
    background: var(--gradient-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ── Leaving: panels sweep up over the page, mark + bar appear ── */
  /* Timings per Emil Kowalski's standards: drawer curve, 30–80 ms stagger,
     the mark is fully in before the browser navigates (no pop). */
  :root.pt-leave .pt__panel {
    animation: pt-cover 400ms var(--ease-drawer) forwards;
  }
  :root.pt-leave .pt__panel--2 { animation-delay: 40ms; }
  :root.pt-leave .pt__panel--3 { animation-delay: 80ms; }

  :root.pt-leave .pt__mark {
    animation: pt-mark-in 200ms var(--ease-out) 250ms forwards;
  }

  :root.pt-leave .pt__bar {
    animation: pt-fade-in 150ms linear 300ms forwards;
  }

  :root.pt-leave .pt__bar-fill {
    animation: pt-load 1.6s var(--ease-out) 300ms forwards;
  }

  /* ── Entering: page starts covered, panels sweep away upward ── */
  :root.pt-enter .pt__panel {
    transform: none;
    animation: pt-uncover 450ms var(--ease-out) forwards;
  }
  :root.pt-enter .pt__panel--2 { animation-delay: 50ms; }
  :root.pt-enter .pt__panel--1 { animation-delay: 90ms; }

  :root.pt-enter .pt__mark {
    opacity: 1;
    transform: none;
    animation: pt-mark-out 150ms var(--ease-out) forwards;
  }

  :root.pt-enter .pt__bar { opacity: 0; }

  @keyframes pt-cover {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  @keyframes pt-uncover {
    from { transform: translateY(0); }
    to { transform: translateY(-100%); }
  }

  @keyframes pt-mark-in {
    to { opacity: 1; transform: none; }
  }

  @keyframes pt-mark-out {
    to { opacity: 0; transform: translateY(-14px) scale(0.98); }
  }

  @keyframes pt-fade-in {
    to { opacity: 1; }
  }

  @keyframes pt-load {
    to { transform: scaleX(0.9); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt { display: none; }
  }

  @media print {
    .pt { display: none; }
  }
</style>
