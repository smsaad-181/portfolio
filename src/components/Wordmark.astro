---
/**
 * Wordmark.astro — the one brand mark, used in the nav and footer:
 * a signature-style name between code brackets, < Sultan Mahmud Saad />.
 * The visible text is decorative; the parent link carries the accessible name.
 */
export interface Props {
  /** Slightly smaller on phones (nav only). */
  compact?: boolean;
}
const { compact = true } = Astro.props;
---

<span class:list={["wordmark", { "wordmark--compact": compact }]} aria-hidden="true">
  <span class="wordmark__bracket">&lt;</span>
  <span class="wordmark__name" translate="no">Sultan Mahmud Saad</span>
  <span class="wordmark__bracket">/&gt;</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .wordmark__bracket {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--fs-18);
  }

  .wordmark__name {
    font-family: var(--font-script);
    font-size: 1.9rem;
    line-height: 1;
    padding-inline: 0.1rem;
    transform: translateY(2px);
  }

  @media (max-width: 420px) {
    .wordmark--compact .wordmark__name {
      font-size: 1.55rem;
    }

    .wordmark--compact .wordmark__bracket {
      font-size: var(--fs-16);
    }
  }
</style>
