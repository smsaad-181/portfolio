---
/**
 * Project detail page — /projects/[slug]/
 * Header (status, role, title, summary, tags, GitHub) + key-specs card,
 * interactive 3D board(s), the MDX write-up (Objective → Key Components →
 * Features → Hardware Design → Outcome), board renders and schematics,
 * and previous/next navigation. Drafts never get a page.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import TagChip from "@components/TagChip.astro";
import ModelViewer from "@components/ModelViewer.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getPublishedProjects } from "../../lib/projects";
import { publicImageSize } from "../../lib/images";
import { absoluteUrl, assetUrl, pageUrl, projectSlug, projectUrl, publicFileExists } from "../../lib/urls";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const projects = await getPublishedProjects();
  return projects.map((project, i) => ({
    params: { slug: projectSlug(project) },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const siteUrl = absoluteUrl(pageUrl("/"));
const canonicalProjectUrl = absoluteUrl(projectUrl(project));

// Only images that exist are rendered — never a 404 or a placeholder.
const cover = publicFileExists(data.coverImage.src) ? data.coverImage : null;
const coverAbsoluteUrl = cover ? absoluteUrl(assetUrl(cover.src)) : undefined;
const gallery = (
  await Promise.all(
    data.gallery.map(async (img) => {
      const size = await publicImageSize(img.src);
      return size ? { ...img, ...size } : null;
    })
  )
).filter((g): g is NonNullable<typeof g> => g !== null);
const boardImages = gallery.filter((g) => g.kind !== "schematic");
const schematics = gallery.filter((g) => g.kind === "schematic");

const statusLabel = { completed: "Completed", "in-progress": "In progress", prototype: "Prototype" } as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: data.title,
  description: data.summary,
  url: canonicalProjectUrl,
  keywords: data.tags.join(", "),
  creator: { "@type": "Person", name: "Sultan Mahmud", url: siteUrl },
  ...(data.links.github && { sameAs: data.links.github }),
  ...(coverAbsoluteUrl && { image: coverAbsoluteUrl }),
};
---

<BaseLayout title={data.title} description={data.summary} ogImage={coverAbsoluteUrl}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="breadcrumb container" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href={pageUrl("/")}>Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={pageUrl("/projects/")}>Projects</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{data.title}</li>
    </ol>
  </nav>

  <article class="project" aria-labelledby="project-title">
    <!-- Header -->
    <header class="project-head container">
      <div class="project-head__main">
        <div class="project-head__meta">
          <StatusBadge status={data.status} />
          {data.role && <span class="project-head__role">{data.role}</span>}
        </div>
        <h1 class="project-head__title" id="project-title">{data.title}</h1>
        <p class="project-head__summary">{data.summary}</p>
        {data.tags.length > 0 && (
          <div class="project-head__tags" aria-label="Technologies">
            {data.tags.map((tag) => <TagChip tag={tag} />)}
          </div>
        )}
        {(data.links.github || data.links.oshwlab || data.links.liveDemo) && (
          <div class="project-head__links">
            {data.links.github && (
              <a href={data.links.github} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
                View on GitHub
              </a>
            )}
            {data.links.oshwlab && (
              <a href={data.links.oshwlab} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">OSHWLab</a>
            )}
            {data.links.liveDemo && (
              <a href={data.links.liveDemo} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">Live demo</a>
            )}
          </div>
        )}
      </div>

      {(data.specs.length > 0 || cover) && (
        <aside class="spec-card" aria-label="Key specifications">
          {cover && (
            <Image
              src={assetUrl(cover.src)}
              alt={cover.alt}
              width={720}
              height={480}
              class="spec-card__img"
              loading="eager"
            />
          )}
          {data.specs.length > 0 && (
            <dl class="spec-card__list">
              <div class="spec-card__row">
                <dt>Status</dt>
                <dd>{statusLabel[data.status]}</dd>
              </div>
              {data.specs.map((s) => (
                <div class="spec-card__row">
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </aside>
      )}
    </header>

    <!-- Interactive 3D board(s) -->
    {data.models.length > 0 && (
      <div class="container project-section">
        <ModelViewer models={data.models} title={data.title} />
      </div>
    )}

    <!-- Write-up -->
    <div class="container project-section">
      <div class="prose project-prose">
        <Content />
      </div>
    </div>

    <!-- Board renders -->
    {boardImages.length > 0 && (
      <section class="container project-section" aria-labelledby="renders-heading">
        <h2 class="gallery-title" id="renders-heading">Board renders</h2>
        <div class="gallery">
          {boardImages.map((img) => (
            <figure class="gallery__item">
              <a href={assetUrl(img.src)} target="_blank" rel="noopener" class="gallery__link" aria-label={`Open full-size image: ${img.caption ?? img.alt}`}>
                <Image src={assetUrl(img.src)} alt={img.alt} width={img.width} height={img.height} class="gallery__img" loading="lazy" />
              </a>
              {img.caption && <figcaption class="gallery__caption">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Schematics -->
    {schematics.length > 0 && (
      <section class="container project-section" aria-labelledby="schematics-heading">
        <h2 class="gallery-title" id="schematics-heading">Schematics</h2>
        <div class="schematics">
          {schematics.map((img) => (
            <figure class="schematic">
              <a href={assetUrl(img.src)} target="_blank" rel="noopener" class="gallery__link" aria-label={`Open full-size schematic: ${img.caption ?? img.alt}`}>
                <Image src={assetUrl(img.src)} alt={img.alt} width={img.width} height={img.height} class="schematic__img" loading="lazy" />
              </a>
              {img.caption && <figcaption class="gallery__caption">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Previous / next -->
    <nav class="container project-nav" aria-label="More projects">
      {prev ? (
        <a href={projectUrl(prev)} class="project-nav__link">
          <span class="project-nav__dir">← Previous</span>
          <span class="project-nav__name">{prev.data.title}</span>
        </a>
      ) : <span />}
      <a href={pageUrl("/projects/")} class="project-nav__all">All projects</a>
      {next ? (
        <a href={projectUrl(next)} class="project-nav__link project-nav__link--next">
          <span class="project-nav__dir">Next →</span>
          <span class="project-nav__name">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    padding-block: var(--space-4);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .breadcrumb li + li {
    margin-top: 0;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb [aria-current="page"] {
    color: var(--text-primary);
  }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .project-head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
    padding-block: var(--space-8) var(--space-12);
  }

  .project-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .project-head__role {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .project-head__title {
    font-size: clamp(var(--fs-28), 4.5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: var(--space-4);
    background: var(--gradient-name);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .project-head__summary {
    font-size: var(--fs-18);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }

  .project-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .project-head__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Key specs card */
  .spec-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .spec-card__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    background:
      radial-gradient(ellipse 70% 70% at 50% 45%, var(--accent-glow), transparent 70%),
      var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .spec-card__list {
    display: grid;
  }

  .spec-card__row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    align-items: baseline;
  }

  .spec-card__row:last-child {
    border-bottom: 0;
  }

  .spec-card__row dt {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .spec-card__row dd {
    font-size: var(--fs-14);
    font-weight: 500;
    color: var(--text-primary);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* ── Sections ───────────────────────────────────────────────────────── */
  .project-section {
    margin-bottom: var(--space-16);
  }

  .project-prose {
    max-width: 78ch;
  }

  .gallery-title {
    font-family: var(--font-mono);
    font-size: var(--fs-18);
    color: var(--accent);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-6);
  }

  .gallery__item,
  .schematic {
    margin: 0;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .gallery__link {
    display: block;
    background: var(--bg-elevated);
  }

  .gallery__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    transition: transform var(--dur-slow) var(--ease);
  }

  .gallery__link:hover .gallery__img {
    transform: scale(1.03);
  }

  .gallery__caption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .schematics {
    display: grid;
    gap: var(--space-6);
  }

  .schematic__img {
    display: block;
    width: 100%;
    height: auto;
    /* schematics are drawn on white — keep them on white in both themes */
    background: var(--text-inverse);
  }

  :global(:root:not([data-theme="light"])) .schematic__img {
    background: var(--text-primary);
  }

  /* ── Prev / next ────────────────────────────────────────────────────── */
  .project-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-8) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .project-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    color: var(--text-primary);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .project-nav__link:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .project-nav__link--next {
    text-align: right;
  }

  .project-nav__dir {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--accent);
  }

  .project-nav__name {
    font-weight: 500;
  }

  .project-nav__all {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
  }

  @media (max-width: 900px) {
    .project-head {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .project-nav {
      grid-template-columns: 1fr;
    }

    .project-nav__link--next {
      text-align: left;
    }

    .project-nav__all {
      order: 3;
      text-align: center;
    }

    .spec-card__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding-inline: var(--space-4);
    }
  }
</style>
