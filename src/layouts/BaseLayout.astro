---
/**
 * BaseLayout.astro
 * Wraps every page. Handles <head> meta, nav, footer, and global styles.
 * Per-page SEO is supplied via props; sensible defaults fall back to the
 * site-wide profile data.
 */
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import CircuitField from "@components/CircuitField.astro";
// Self-hosted fonts: Rubik Variable (text), JetBrains Mono (labels), Mr Dafoe (logo only).
import "@fontsource-variable/rubik";
import "@fontsource/mr-dafoe";
// One variable file covers every JetBrains Mono weight (was three files → three re-layouts).
import "@fontsource-variable/jetbrains-mono";
// Body text font, preloaded so the first text paints in its final font (fewer re-layouts).
import rubikLatin from "@fontsource-variable/rubik/files/rubik-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import "@styles/tokens.css";
import "@styles/global.css";
import { absoluteUrl, assetUrl } from "../lib/urls";

export interface Props {
  title: string;
  /** Use `title` as-is instead of appending " · Sultan Mahmud" (Home). */
  fullTitle?: boolean;
  description?: string;
  /** Absolute URL to an OG image (should be 1200×630). Falls back to a default. */
  ogImage?: string | undefined;
  /** Text alternative for the OG image. */
  ogImageAlt?: string;
  /** og:type — "article" for project pages. */
  ogType?: "website" | "article";
  /** Canonical URL for this page. Defaults to the production URL of this path. */
  canonicalUrl?: string;
  /** If true, adds noindex (e.g. for the 404 page). */
  noindex?: boolean;
}

const {
  title,
  fullTitle: titleIsFull = false,
  description = "Hardware Engineer specialising in PCB design, embedded systems, and IoT product development.",
  ogImage,
  ogImageAlt = "Sultan Mahmud — Hardware Engineer portfolio",
  ogType = "website",
  canonicalUrl,
  noindex = false,
} = Astro.props;

// Canonical is built from `site` + path, never from the request host
// (otherwise local builds would publish localhost URLs).
const canonical = canonicalUrl ?? absoluteUrl(Astro.url.pathname);
// Generated at build time by src/pages/images/og-default.png.ts (PNG —
// social crawlers don't accept SVG OG images).
const ogImageUrl = ogImage ?? absoluteUrl(assetUrl("/images/og-default.png"));
const fullTitle = titleIsFull ? title : `${title} · Sultan Mahmud`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme, before first paint (no flash): the visitor's saved choice,
         else their system setting, else dark. -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
        // Scroll-reveal animations only with JS + IntersectionObserver and
        // when the visitor has not asked for reduced motion. Without this
        // class every [data-reveal] element is simply visible.
        var still = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!still && "IntersectionObserver" in window) document.documentElement.classList.add("reveal-on");
      })();
    </script>

    <link rel="preload" href={rubikLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Per-page extra head content (e.g. project JSON-LD) -->
    <slot name="head" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={assetUrl("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={assetUrl("/icons/32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={assetUrl("/icons/180.png")} />
    <link rel="manifest" href={assetUrl("/site.webmanifest")} />
    <!-- Browser UI colour = page background per theme (mirrors --bg-base in tokens.css) -->
    <meta name="theme-color" content="#0b0614" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf7fd" media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <CircuitField />
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal: [data-reveal] fades/slides in once it enters the viewport.
      // A parent with [data-reveal-stagger] staggers its [data-reveal] children.
      // [data-count] numbers count up from 0 when they appear.
      const root = document.documentElement;
      if (root.classList.contains("reveal-on")) {
        document.querySelectorAll<HTMLElement>("[data-reveal-stagger]").forEach((group) => {
          group.querySelectorAll<HTMLElement>(":scope > [data-reveal], :scope > * > [data-reveal]").forEach((el, i) => {
            el.style.setProperty("--reveal-delay", `${Math.min(i, 8) * 70}ms`);
          });
        });
        const countUp = (el: HTMLElement) => {
          const target = Number(el.dataset["count"]);
          if (!Number.isFinite(target)) return;
          const start = performance.now(), dur = 900;
          const tick = (t: number) => {
            const p = Math.min(1, (t - start) / dur);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              io.unobserve(el);
              if (el.dataset["count"] !== undefined) countUp(el);
              if (!el.hasAttribute("data-reveal")) continue;
              el.classList.add("is-visible");
              // Hand the element back to its own CSS once it has arrived.
              const delay = parseInt(el.style.getPropertyValue("--reveal-delay")) || 0;
              setTimeout(() => {
                el.removeAttribute("data-reveal");
                el.classList.remove("is-visible");
                el.style.removeProperty("--reveal-delay");
              }, 650 + delay);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
        );
        document.querySelectorAll<HTMLElement>("[data-reveal], [data-count]").forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 9999;
    padding: var(--space-2) var(--space-4);
    background: var(--accent);
    color: var(--text-inverse);
    border-radius: var(--radius-md);
    font-weight: 600;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
