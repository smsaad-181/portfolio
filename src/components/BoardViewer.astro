---
/**
 * BoardViewer.astro — interactive 3D PCB, modelled on the viewer in Saad's
 * own project documentation (D:\SAAD\PCB\Clock\Documentation).
 *
 * The GLB is converted from the project's STEP file at import time: every
 * placed part is a node named by its reference designator with its BOM line
 * in `extras`, and the bare board carries the real top/bottom 2D layout as a
 * texture. The viewer adds: camera presets (3D / Top / Bottom / Front),
 * zoom buttons (+ Ctrl/⌘ + wheel, pinch on touch), an explode slider that
 * separates top- and bottom-side parts, a "Find part" list, hover tooltips,
 * click-to-select and an info line for the selected part.
 *
 * three.js is self-hosted (npm) and loaded only when the viewer scrolls near.
 * Until then (and if WebGL is unavailable) the board's 3D render is shown.
 */
import { statSync } from "node:fs";
import path from "node:path";
import { Image } from "astro:assets";
import { assetUrl, publicFileExists } from "../lib/urls";
import { publicImageSize } from "../lib/images";

export interface Props {
  models: { label: string; src: string; poster?: string | undefined }[];
  title: string;
}

const { models, title } = Astro.props;
// Resolve like publicFileExists(): from the project root, so it also works
// when this code runs from the bundled build output.
const mb = (src: string) => {
  try {
    return (statSync(path.join(process.cwd(), "public", src.replace(/^\/+/, ""))).size / 1048576).toFixed(1);
  } catch {
    return null;
  }
};
const boards = await Promise.all(
  models
    .filter((m) => publicFileExists(m.src))
    .map(async (m) => {
      const size = m.poster ? await publicImageSize(m.poster) : null;
      return {
        label: m.label,
        src: assetUrl(m.src),
        size: mb(m.src),
        poster: m.poster && size ? { src: assetUrl(m.poster), ...size } : null,
      };
    }),
);
const first = boards[0];
---

{first && (
  <section class="bv" aria-labelledby="bv-heading" data-bv data-title={title}>
    <div class="bv__head">
      <h2 class="bv__title" id="bv-heading">Interactive 3D board</h2>
      {boards.length > 1 && (
        <div class="bv__tabs" role="group" aria-label="Choose a board">
          {boards.map((b, i) => (
            <button type="button" class="bv__tab" aria-pressed={i === 0 ? "true" : "false"} data-src={b.src} data-size={b.size} data-label={b.label}>
              {b.label}
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="bv__frame">
      <div class="bv__bar">
        <div class="bv__group" role="group" aria-label="Camera view">
          <button type="button" class="bv__btn" data-view="iso" disabled>3D</button>
          <button type="button" class="bv__btn" data-view="top" disabled>Top</button>
          <button type="button" class="bv__btn" data-view="bottom" disabled>Bottom</button>
          <button type="button" class="bv__btn" data-view="front" disabled>Front</button>
        </div>
        <div class="bv__group" role="group" aria-label="Zoom">
          <button type="button" class="bv__btn bv__btn--icon" data-zoom="in" aria-label="Zoom in" disabled>+</button>
          <button type="button" class="bv__btn bv__btn--icon" data-zoom="out" aria-label="Zoom out" disabled>−</button>
        </div>
        <label class="bv__explode">
          <span>Explode</span>
          <input type="range" min="0" max="1" step="0.01" value="0" data-explode disabled />
        </label>
        <label class="bv__find">
          <span>Find part</span>
          <select data-find disabled>
            <option value="">Select a component…</option>
          </select>
        </label>
      </div>

      <div class="bv__stage" data-stage data-src={first.src} data-size={first.size}>
        {boards.map((b, i) => b.poster && (
          <Image
            src={b.poster.src}
            alt=""
            width={b.poster.width}
            height={b.poster.height}
            class="bv__poster"
            data-poster-for={b.src}
            hidden={i !== 0}
            loading="lazy"
          />
        ))}
        <div class="bv__tip" data-tip aria-hidden="true"></div>
        <p class="bv__load" data-load>
          The 3D model loads when you scroll here{first.size && ` (${first.size} MB)`}.
        </p>
        <p class="bv__hint" aria-hidden="true">Drag: rotate · Ctrl + wheel / pinch: zoom · Right-drag: pan · Click: select</p>
      </div>

      <p class="sr-only" data-live aria-live="polite"></p>
      <p class="bv__info" data-info>
        Hover or click a component to identify it. Use <em>Bottom</em> or the explode slider to see the parts on the back.
      </p>
    </div>
    <p class="bv__cap" data-cap></p>
  </section>
)}

<script>
  type Bom = { name?: string; value?: string; footprint?: string; mpn?: string; maker?: string };
  type PartData = { ref: string; side: "top" | "bottom"; h: number; bom?: Bom };

  const host = document.querySelector<HTMLElement>("[data-bv]");
  if (host) initViewer(host);

  function initViewer(host: HTMLElement) {
    const stage = host.querySelector<HTMLElement>("[data-stage]")!;
    const load = host.querySelector<HTMLElement>("[data-load]")!;
    const tip = host.querySelector<HTMLElement>("[data-tip]")!;
    const info = host.querySelector<HTMLElement>("[data-info]")!;
    const cap = host.querySelector<HTMLElement>("[data-cap]")!;
    const find = host.querySelector<HTMLSelectElement>("[data-find]")!;
    const explode = host.querySelector<HTMLInputElement>("[data-explode]")!;
    const live = host.querySelector<HTMLElement>("[data-live]")!;
    const ctrlEls = host.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLSelectElement>("[data-view], [data-zoom], [data-explode], [data-find]");
    const enable = (on: boolean) => ctrlEls.forEach((c) => { c.disabled = !on; });
    const showPoster = (src: string | null) =>
      host.querySelectorAll<HTMLElement>("[data-poster-for]").forEach((p) => { p.hidden = p.dataset.posterFor !== src; });
    const DEFAULT_INFO = info.innerHTML;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let api: Awaited<ReturnType<typeof start>> | null = null;
    let current = stage.dataset.src!;

    const io = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          io.disconnect();
          start()
            .then((a) => { api = a; a?.load(current); })
            .catch(() => { load.textContent = "The 3D model could not be loaded."; });
        }
      },
      { rootMargin: "400px" },
    );
    io.observe(stage);

    host.querySelectorAll<HTMLButtonElement>(".bv__tab").forEach((tab) =>
      tab.addEventListener("click", () => {
        host.querySelectorAll(".bv__tab").forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
        current = tab.dataset.src!;
        explode.value = "0";
        if (!api) showPoster(current);
        if (api) api.load(current);
      }),
    );

    async function start() {
      load.textContent = "Loading 3D model…";
      const [THREE, { GLTFLoader }, { OrbitControls }, { RoomEnvironment }, { MeshoptDecoder }] = await Promise.all([
        import("three"),
        import("three/addons/loaders/GLTFLoader.js"),
        import("three/addons/controls/OrbitControls.js"),
        import("three/addons/environments/RoomEnvironment.js"),
        import("three/addons/libs/meshopt_decoder.module.js"), // models use EXT_meshopt_compression
      ]);

      let renderer: InstanceType<typeof THREE.WebGLRenderer>;
      try {
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      } catch {
        load.textContent = "This browser cannot show WebGL 3D.";
        return null;
      }
      renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
      renderer.toneMapping = THREE.NeutralToneMapping;
      renderer.toneMappingExposure = 1.05;
      renderer.domElement.setAttribute("role", "img");
      renderer.domElement.setAttribute("aria-label", `Interactive 3D model of the ${host.dataset.title} PCB`);
      stage.prepend(renderer.domElement);

      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      scene.environmentIntensity = 0.55;
      const css = (name: string) => getComputedStyle(host).getPropertyValue(name).trim();
      const key = new THREE.DirectionalLight(css("--viewer-light"), 1.6);
      key.position.set(1, 2, 1.4);
      scene.add(key, new THREE.HemisphereLight(css("--viewer-light"), css("--viewer-ground"), 0.6));

      const cam = new THREE.PerspectiveCamera(35, 1, 0.001, 50);
      const controls = new OrbitControls(cam, renderer.domElement);
      controls.enableDamping = !reduce;
      controls.dampingFactor = 0.08;
      controls.zoomSpeed = 0.8;
      // OrbitControls sets touch-action: none; keep vertical swipes scrolling
      // the page on phones (horizontal drag still turns the board).
      renderer.domElement.style.touchAction = "pan-y";
      // Plain wheel scrolls the page; Ctrl/⌘ + wheel zooms the board.
      stage.addEventListener("wheel", (e) => { if (!e.ctrlKey && !e.metaKey) e.stopPropagation(); }, { capture: true });

      const accent = new THREE.Color();
      const loader = new GLTFLoader().setMeshoptDecoder(MeshoptDecoder);
      let clockTimer = 0;
      let model: InstanceType<typeof THREE.Object3D> | null = null;
      let parts = new Map<string, { obj: InstanceType<typeof THREE.Object3D>; data: PartData; base: number; mats: any[] }>();
      let pickables: InstanceType<typeof THREE.Object3D>[] = [];
      let D = 0.15;
      let diagMm = 100;
      let selected = new Set<string>();
      let hovered: string | null = null;
      let fly: { from: any; to: any; t0: number; tgt: any } | null = null;
      // Board frame: +Y = up from the top side, −Z = top edge of the 2D layout.
      const VIEWS = {
        iso: [0.38, 0.62, 0.72],
        top: [0, 0.985, 0.02],
        bottom: [0, -0.985, -0.02],
        front: [0, 0.16, 1],
      } satisfies Record<string, [number, number, number]>;
      type View = keyof typeof VIEWS;

      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
      const partName = (d: PartData) => { const b = clean(d.bom); return b.mpn || b.name || b.value || ""; };
      const label = (d: PartData) => [d.ref, partName(d), d.side === "bottom" ? "bottom side" : ""].filter(Boolean).join(" · ");
      // BOM manufacturer names are often Chinese-only (LCSC); show Latin names only.
      const latin = (s?: string | null) => (s && !/^(null|undefined|-)$/i.test(s.trim()) && /[A-Za-z0-9]/.test(s) ? s.replace(/[-]?[　-鿿（）]+/g, "").replace(/\(\s*\)/g, "").trim() : "");
      const clean = (b?: Bom): Bom => ({ name: latin(b?.name), value: latin(b?.value), footprint: b?.footprint ?? "", mpn: latin(b?.mpn), maker: latin(b?.maker) });
      const describe = (d: PartData) => {
        const b = clean(d.bom);
        const bits = [
          b.name && b.name !== b.mpn ? esc(b.name) : "",
          b.value && b.value !== b.name ? `value ${esc(b.value)}` : "",
          b.mpn ? `part <code>${esc(b.mpn)}</code>${b.maker ? ` (${esc(b.maker)})` : ""}` : "",
          b.footprint ? `footprint <code>${esc(b.footprint)}</code>` : "",
          `${d.side} side`,
          (d as any).synthetic ? "shown at datasheet size (the STEP export has no 3D model for this part)" : "",
          (d as any).note ? esc((d as any).note) : "",
        ].filter(Boolean);
        return `<b>${esc(d.ref)}</b> — ${bits.join(" · ")}`;
      };
      const category = (ref: string) => {
        const p = ref.replace(/[^A-Za-z].*$/, "").toUpperCase();
        if (/^(U|IC|MOD|M|GPS|ESP|OLED|LCD|TFT)$/.test(p)) return "ICs and modules";
        if (/^(R|RN|C|L|FB)$/.test(p)) return "Resistors, capacitors, inductors";
        if (/^(D|LED|Q|ZD|TVS|F)$/.test(p)) return "Diodes, LEDs, transistors";
        if (/^(J|CN|P|USB|H|HDR|CON|JP|BAT|B)$/.test(p)) return "Connectors and battery";
        if (/^(SW|K|KEY|BTN|S|BUZ|BZ)$/.test(p)) return "Switches and buzzers";
        if (/^(X|Y|XTAL)$/.test(p)) return "Crystals";
        return "Other parts";
      };

      function dispose(o: InstanceType<typeof THREE.Object3D>) {
        o.traverse((c: any) => {
          c.geometry?.dispose();
          [].concat(c.material ?? []).forEach((m: any) => { m.map?.dispose(); m.dispose(); });
        });
      }

      function frame() {
        const box = new THREE.Box3().setFromObject(model!);
        const size = box.getSize(new THREE.Vector3());
        // Step back further on narrow (phone) stages so the whole board fits.
        D = (Math.hypot(size.x, size.z) * 0.95 + size.y * 0.6) * Math.max(1, 1.7 / (cam.aspect || 1.7));
        cam.near = D / 200; cam.far = D * 20; cam.updateProjectionMatrix();
        controls.target.set(0, 0, 0);
        controls.minDistance = D * 0.15; controls.maxDistance = D * 3;
        cam.position.set(...(VIEWS.iso.map((v) => v * D) as [number, number, number]));
        controls.update();
      }

      async function loadModel(src: string) {
        load.hidden = false;
        load.textContent = "Loading 3D model…";
        enable(false);
        showPoster(src);
        let gltf;
        try {
          gltf = await loader.loadAsync(src);
        } catch {
          load.textContent = "The 3D model could not be loaded.";
          return;
        }
        if (src !== current) return; // a different tab was chosen meanwhile
        if (model) { scene.remove(model); dispose(model); }
        model = gltf.scene;
        // Centre the board on the origin (the STEP keeps EasyEDA's coordinates).
        const pcb = model.getObjectByName("Board") ?? model;
        const c = new THREE.Box3().setFromObject(pcb).getCenter(new THREE.Vector3());
        model.position.sub(c);
        scene.add(model);

        parts = new Map(); pickables = []; selected = new Set(); hovered = null;
        const seen = new Set<unknown>();
        model.traverse((o: any) => {
          if (o.userData?.ref && !parts.has(o.userData.ref)) {
            const mats: any[] = [];
            o.traverse((m: any) => {
              if (m.isMesh) {
                m.material = m.material.clone();   // own material so highlight is per part
                if (m.material.emissive) m.material.userData.baseEmissive = m.material.emissive.clone(); // LED glow, display segments
                mats.push(m.material);
                pickables.push(m);
                seen.add(m);
              }
            });
            parts.set(o.userData.ref, { obj: o, data: o.userData as PartData, base: o.position.z, mats });
          } else if (o.isMesh && !seen.has(o)) {
            // bare-board meshes are pickable too, for the "Bare PCB" tooltip
            pickables.push(o);
            seen.add(o);
          }
        });

        // Find-part list grouped by kind, natural order.
        find.innerHTML = '<option value="">Select a component…</option>';
        const groups = new Map<string, string[]>();
        [...parts.keys()].sort((a, b) => a.localeCompare(b, undefined, { numeric: true })).forEach((r) => {
          const g = category(r);
          groups.set(g, [...(groups.get(g) ?? []), r]);
        });
        [...groups.entries()].sort().forEach(([g, refs]) => {
          const og = document.createElement("optgroup");
          og.label = g;
          refs.forEach((r) => {
            const op = document.createElement("option");
            op.value = r;
            op.textContent = label(parts.get(r)!.data);
            og.append(op);
          });
          find.append(og);
        });

        const mm = model.userData?.boardMm ?? model.children[0]?.userData?.boardMm;
        diagMm = mm ? Math.hypot(mm[0], mm[1]) : 100;
        cap.textContent = `Converted from the project's STEP file: ${parts.size} placed parts.`;
        info.innerHTML = DEFAULT_INFO;
        frame();
        setExplode(0);
        startClock();
        load.hidden = true;
        showPoster(null);
        enable(true);
        find.disabled = parts.size === 0;
      }

      function paint() {
        accent.set(css("--accent")); // re-read: the theme may have changed
        parts.forEach((p, r) => {
          const on = selected.has(r), hov = r === hovered;
          p.mats.forEach((m) => {
            if (!m.emissive) return;
            const base = m.userData.baseEmissive;
            if (m.emissiveMap) return;                       // display faces keep their own glow
            m.emissive.copy(accent).multiplyScalar(on ? 0.55 : hov ? 0.22 : 0);
            if (base) m.emissive.add(base);
          });
        });
      }

      // A board with exactly four single-digit 7-segment displays (the Clock)
      // shows the current time on them, like Saad's own documentation model.
      function startClock() {
        clearInterval(clockTimer);
        const faces = [...parts.values()]
          .filter((p) => (p.data as any).kind === "display7")
          .map((p) => {
            let mesh: any = null;
            p.obj.traverse((o: any) => { if (o.isMesh && o.material?.name?.startsWith("display-face-1")) mesh = o; });
            return mesh ? { mesh, x: new THREE.Box3().setFromObject(p.obj).getCenter(new THREE.Vector3()).x } : null;
          })
          .filter(Boolean) as { mesh: any; x: number }[];
        if (faces.length !== 4) return;
        faces.sort((a, b) => a.x - b.x);
        const SEG: Record<string, string> = { "0": "abcdef", "1": "bc", "2": "abged", "3": "abgcd", "4": "fgbc", "5": "afgcd", "6": "afgedc", "7": "abc", "8": "abcdefg", "9": "abfgcd" };
        const canvases = faces.map(({ mesh }) => {
          const c = document.createElement("canvas");
          c.width = 240; c.height = 340;
          const tex = new THREE.CanvasTexture(c);
          tex.flipY = false;                                   // glTF UVs: v = 0 is the image top
          tex.colorSpace = THREE.SRGBColorSpace;
          mesh.material.map = tex;
          mesh.material.emissiveMap = tex;
          mesh.material.needsUpdate = true;
          return { c, tex };
        });
        const ON = css("--viewer-seg-on"), OFF = css("--viewer-seg-off"), FACE = css("--viewer-seg-face");
        const draw = (ctx: CanvasRenderingContext2D, digit: string, dp: boolean) => {
          const t = 26, L = 120, x0 = 40, y0 = 40, mid = 170, bot = 300;
          const rects: Record<string, [number, number, number, number]> = {
            a: [x0 + t, y0, L, t], g: [x0 + t, mid - t / 2, L, t], d: [x0 + t, bot - t, L, t],
            f: [x0, y0 + t, t, mid - y0 - t * 1.5], b: [x0 + L + t, y0 + t, t, mid - y0 - t * 1.5],
            e: [x0, mid + t / 2, t, bot - mid - t * 1.5], c: [x0 + L + t, mid + t / 2, t, bot - mid - t * 1.5],
          };
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.fillStyle = FACE;
          ctx.fillRect(0, 0, 240, 340);
          ctx.setTransform(1, 0, Math.tan((-6 * Math.PI) / 180), 1, 14, 0);
          const lit = SEG[digit] ?? "";
          for (const [k, [x, y, w, h]] of Object.entries(rects)) {
            ctx.fillStyle = lit.includes(k) ? ON : OFF;
            ctx.beginPath(); ctx.roundRect(x, y, w, h, Math.min(w, h) / 2); ctx.fill();
          }
          ctx.fillStyle = dp ? ON : OFF;
          ctx.beginPath(); ctx.arc(x0 + L + t * 2.6, bot - t / 2, t / 1.6, 0, Math.PI * 2); ctx.fill();
        };
        const tick = () => {
          const now = new Date();
          const s = String(now.getHours()).padStart(2, "0") + String(now.getMinutes()).padStart(2, "0");
          canvases.forEach(({ c, tex }, i) => { draw(c.getContext("2d")!, s[i]!, i === 1 && now.getSeconds() % 2 === 0); tex.needsUpdate = true; });
        };
        tick();
        clockTimer = window.setInterval(() => { if (visible) tick(); }, 1000);
      }

      function showInfo(r?: string | null) {
        const list = r ? [r] : [...selected];
        info.innerHTML = list.length ? list.map((x) => describe(parts.get(x)!.data)).join("<br>") : DEFAULT_INFO;
      }

      function setExplode(k: number) {
        // Part nodes live in the board's own frame (mm, Z = up from the top side).
        parts.forEach((p) => {
          const lift = diagMm * 0.14 + (p.data.h ?? 2) * 0.9;
          p.obj.position.z = p.base + (p.data.side === "bottom" ? -1 : 1) * k * lift;
        });
      }

      function goTo(view: View) {
        const to = new THREE.Vector3(...VIEWS[view]).multiplyScalar(D);
        if (reduce) { cam.position.copy(to); controls.target.set(0, 0, 0); controls.update(); return; }
        fly = { from: cam.position.clone(), to, t0: performance.now(), tgt: controls.target.clone() };
      }

      function select(r: string | null) {
        selected = r ? new Set([r]) : new Set();
        find.value = r ?? "";
        const p = r ? parts.get(r) : null;
        if (p && p.data.side === "bottom") goTo("bottom");
        paint();
        showInfo();
        live.textContent = p ? info.textContent ?? "" : "Selection cleared.";
      }

      // Toolbar
      host.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((b) => b.addEventListener("click", () => goTo(b.dataset.view as View)));
      const zoom = (f: number) => {
        const d = cam.position.clone().sub(controls.target);
        d.setLength(Math.min(controls.maxDistance, Math.max(controls.minDistance, d.length() * f)));
        cam.position.copy(controls.target).add(d);
        controls.update();
      };
      host.querySelector("[data-zoom=in]")!.addEventListener("click", () => zoom(1 / 1.25));
      host.querySelector("[data-zoom=out]")!.addEventListener("click", () => zoom(1.25));
      explode.addEventListener("input", () => setExplode(+explode.value));
      find.addEventListener("change", () => select(find.value || null));

      // Picking
      const ray = new THREE.Raycaster();
      const ptr = new THREE.Vector2();
      let pending: PointerEvent | null = null;
      let down: { x: number; y: number } | null = null;
      const refOf = (o: any): string | null => { while (o) { if (o.userData?.ref) return o.userData.ref; o = o.parent; } return null; };
      const pick = (e: PointerEvent) => {
        const r = renderer.domElement.getBoundingClientRect();
        ptr.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
        ray.setFromCamera(ptr, cam);
        const hit = ray.intersectObjects(pickables, false)[0];
        return hit ? refOf(hit.object) ?? "Board" : null;
      };
      renderer.domElement.addEventListener("pointermove", (e) => { if (e.pointerType !== "touch") pending = e; });
      renderer.domElement.addEventListener("pointerleave", () => { pending = null; hovered = null; tip.style.opacity = "0"; paint(); showInfo(); });
      renderer.domElement.addEventListener("pointerdown", (e) => { down = { x: e.clientX, y: e.clientY }; });
      renderer.domElement.addEventListener("pointerup", (e) => {
        if (!down || Math.hypot(e.clientX - down.x, e.clientY - down.y) > 5) return;
        const r = pick(e);
        if (r && r !== "Board") select(selected.has(r) && selected.size === 1 ? null : r);
        else if (!r) select(null);
      });
      function hover() {
        if (!pending) return;
        const e = pending; pending = null;
        const r = pick(e);
        const part = r && r !== "Board" ? r : null;
        if (part !== hovered) { hovered = part; paint(); showInfo(part); }
        if (r) {
          const b = stage.getBoundingClientRect();
          tip.textContent = part ? label(parts.get(part)!.data) : "Bare PCB";
          tip.style.opacity = "1";
          tip.style.left = `${Math.max(4, Math.min(b.width - 260, e.clientX - b.left + 14))}px`;
          tip.style.top = `${Math.min(b.height - 44, e.clientY - b.top + 14)}px`;
        } else tip.style.opacity = "0";
      }

      // Size + render loop (paused while off-screen)
      function size() {
        const w = stage.clientWidth, h = stage.clientHeight;
        if (!w) return;
        renderer.setSize(w, h, false);
        cam.aspect = w / h; cam.updateProjectionMatrix();
      }
      size();
      new ResizeObserver(size).observe(stage);
      let visible = true;
      new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); }).observe(stage);
      renderer.setAnimationLoop((now: number) => {
        if (!visible || !model) return;
        if (fly) {
          const k = Math.min(1, (now - fly.t0) / 450), s = k * k * (3 - 2 * k);
          cam.position.lerpVectors(fly.from, fly.to, s);
          controls.target.lerpVectors(fly.tgt, new THREE.Vector3(), s);
          if (k >= 1) fly = null;
        }
        hover();
        controls.update();
        renderer.render(scene, cam);
      });

      return { load: loadModel };
    }
  }
</script>

