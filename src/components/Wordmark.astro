---
/**
 * Wordmark.astro — the one brand mark, used in the nav and footer:
 * a signature-style name between code brackets, < Sultan Mahmud Saad />.
 * The visible text is decorative; the parent link carries the accessible name.
 */
export interface Props {
  /** Scales with the viewport so the nav fits 320 px phones (nav only). */
  compact?: boolean;
}
const { compact = true } = Astro.props;
---

<span class:list={["wordmark", { "wordmark--compact": compact }]} aria-hidden="true">
  <span class="wordmark__bracket">&lt;</span>
  <span class="wordmark__name" translate="no">Sultan Mahmud Saad</span>
  <span class="wordmark__bracket">/&gt;</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--text-primary);
    white-space: nowrap;
    font-size: min(var(--fs-18), 5vw); /* fits 320 px phones, also at 125 % text */
  }

  .wordmark__bracket {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1em;
    line-height: 1;
  }

  .wordmark__name {
    font-family: var(--font-script);
    font-size: 1.7em;
    line-height: 1;
    padding-inline: 0.05em;
    transform: translateY(0.08em); /* script baseline sits high; optical centring */
  }

  /* Nav: rem-capped, vw-scaled — whole mark shrinks together on narrow
     phones, also with 125 % browser text (vw does not grow with text size). */
  .wordmark--compact {
    font-size: min(var(--fs-18), 3.5vw);
  }

  .wordmark--compact .wordmark__name {
    font-size: 1.62em;
  }
</style>
