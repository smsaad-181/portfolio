# Copy this file to .env (project root) and fill in the values.
# Every .env* file except this template is git-ignored — never commit real
# credentials. Astro and the Tina CLI both read the root .env natively.
#
# Local dev works without these: Tina runs in local mode and edits files
# directly. Fill them in only to test Tina Cloud login end-to-end.
# In CI the same names come from GitHub Actions secrets instead
# (see .github/workflows/deploy.yml).

# Tina Cloud → app.tina.io → your project → Overview → Client ID
TINA_PUBLIC_CLIENT_ID=

# Tina Cloud → your project → Tokens → read-only token
TINA_TOKEN=

# Web3Forms (contact form) → web3forms.com: enter your email, the access key is
# emailed to you. Public by design (it is visible in the page); still kept here so
# it can be rotated. Empty = the Contact page shows email only, no form.
PUBLIC_WEB3FORMS_KEY=
