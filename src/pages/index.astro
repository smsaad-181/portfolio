---
/**
 * Homepage — /
 * Hero: title + employer, plain name, one positioning line, CTAs, optional
 * proof stats (profile.stats — hidden until Saad supplies real numbers),
 * and on the right either his headshot or a datasheet-style spec panel
 * built from CMS data (profile, current job, skills by category).
 * Then featured projects (CMS-controlled via `featured` + `order`), skills,
 * and the CV call-to-action.
 *
 * Headshot: put a photo at src/assets/profile/portrait.{jpg,png,webp} and it
 * replaces the spec panel automatically (optimised by Astro's <Image />).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SkillBar from "@components/SkillBar.astro";
import ResumeButton from "@components/ResumeButton.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getFeaturedProjects } from "../lib/projects";
import { getProfile } from "../lib/profile";
import { pageUrl, projectUrl } from "../lib/urls";

const profile = await getProfile();
const featured = await getFeaturedProjects();
const allSkills = await getCollection("skills");
const currentJob = (await getCollection("experience")).find((e) => e.data.current);
const stats = profile.data.stats ?? [];

// Optional headshot — first match wins.
const portraitFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/profile/portrait.{png,webp,avif,jpg,jpeg}",
  { eager: true }
);
const portrait = Object.values(portraitFiles)[0]?.default;

// Group skills by category (lowercase stored, title-case at render)
const skillsByCategory = allSkills.reduce<Record<string, typeof allSkills>>(
  (acc, skill) => {
    const cat = skill.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat]!.push(skill);
    return acc;
  },
  {}
);

function titleCase(s: string): string {
  return s
    .split(" ")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

/** Skill names in one category, strongest first (for the spec panel). */
function skillNames(category: string): string[] {
  return (skillsByCategory[category] ?? [])
    .slice()
    .sort((a, b) => (b.data.proficiency ?? 0) - (a.data.proficiency ?? 0))
    .map((s) => s.data.name);
}

const sinceYear = currentJob ? new Date(currentJob.data.startDate).getFullYear() : null;
const specRows = [
  { label: "Role", value: profile.data.title },
  ...(currentJob ? [{ label: "Company", value: `${currentJob.data.company}${sinceYear ? ` · since ${sinceYear}` : ""}` }] : []),
  { label: "Based in", value: profile.data.location },
];
const specLists = [
  { label: "Platforms", items: skillNames("iot & communication") },
  { label: "Protocols", items: skillNames("protocols") },
  { label: "EDA & CAD", items: skillNames("pcb & eda") },
].filter((l) => l.items.length > 0);

const eyebrow = currentJob ? `${profile.data.title} · ${currentJob.data.company}` : profile.data.title;
---

<BaseLayout
  title="Sultan Mahmud — Hardware Engineer"
  fullTitle
  description={profile.data.summary}
>
  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero__grid bg-grid" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="hero__eyebrow">{eyebrow}</p>
        <h1 class="hero__name" id="hero-name">{profile.data.name}</h1>
        <p class="hero__pitch">
          I design PCBs and embedded firmware for IoT products, with ESP32,
          LoRaWAN and Modbus, from schematic to working board.
        </p>

        <div class="hero__actions">
          <a href={pageUrl("/projects/")} class="btn btn--primary">View projects</a>
          <ResumeButton variant="secondary" />
        </div>

        {stats.length > 0 && (
          <dl class="hero__stats">
            {stats.map((s) => (
              <div class="hero__stat">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="hero__aside">
        {portrait ? (
          <figure class="hero__portrait">
            <Image
              src={portrait}
              alt={`${profile.data.name}, ${profile.data.title}`}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 900px) 320px, 420px"
              loading="eager"
              fetchpriority="high"
              class="hero__photo"
            />
          </figure>
        ) : (
          <aside class="spec" aria-label="Quick spec">
            <header class="spec__head">
              <span class="spec__title">Quick spec</span>
              <span class="spec__ref" aria-hidden="true">SM-01</span>
            </header>
            <dl class="spec__rows">
              {specRows.map((r) => (
                <div class="spec__row">
                  <dt>{r.label}</dt>
                  <dd>{r.value}</dd>
                </div>
              ))}
              {specLists.map((l) => (
                <div class="spec__row spec__row--list">
                  <dt>{l.label}</dt>
                  <dd>
                    <ul class="spec__chips" role="list">
                      {l.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </dd>
                </div>
              ))}
            </dl>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- ── Featured projects ───────────────────────────────────────────────── -->
  {featured.length > 0 && (
    <section class="section" aria-labelledby="featured-heading">
      <div class="container">
        <SectionHeading
          label="// selected work"
          title="Featured Projects"
          id="featured-heading"
          description="Hardware builds, firmware deep-dives, and IoT systems — each one a real debugging story."
        />
        <div class="projects-grid">
          {featured.map((project) => (
            <ProjectCard
              title={project.data.title}
              href={projectUrl(project)}
              summary={project.data.summary}
              coverImage={project.data.coverImage}
              tags={project.data.tags}
              status={project.data.status}
            />
          ))}
        </div>
        <div class="projects-cta">
          <a href={pageUrl("/projects/")} class="btn btn--secondary">
            All projects →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── Skills ─────────────────────────────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="skills-heading">
    <div class="container">
      <SectionHeading
        label="// toolbox"
        title="Skills & Technologies"
        id="skills-heading"
        description="The hardware and software toolkit I reach for on every project."
      />
      <div class="skills-grid">
        {Object.entries(skillsByCategory).map(([category, skills]) => (
          <div class="skills-group">
            <h3 class="skills-group__title">{titleCase(category)}</h3>
            <div class="skills-group__list">
              {skills
                .sort((a, b) => (b.data.proficiency ?? 0) - (a.data.proficiency ?? 0))
                .map((skill) => (
                  <SkillBar name={skill.data.name} proficiency={skill.data.proficiency} />
                ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Resume CTA ─────────────────────────────────────────────────────── -->
  <section class="section cta-section" aria-label="Resume download">
    <div class="container cta-inner">
      <div>
        <p class="section-label">// work with me</p>
        <h2 class="cta-title">Looking to collaborate or hire?</h2>
        <p class="cta-body">
          I'm open to hardware engineering roles and IoT product development projects.
          Grab my CV or reach out directly.
        </p>
      </div>
      <div class="cta-actions">
        <ResumeButton variant="primary" />
        <a href={pageUrl("/contact/")} class="btn btn--secondary">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Sections ────────────────────────────────────────────────────────── */
  .section {
    padding-block: var(--space-24);
  }

  .section--alt {
    background: var(--bg-surface);
    border-block: 1px solid var(--border-subtle);
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    /* Slide under the transparent sticky nav so the grid reaches the top */
    margin-top: calc(-1 * var(--nav-height));
    padding-top: calc(var(--nav-height) + var(--space-16));
    padding-bottom: var(--space-16);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Grid fades out toward the bottom so sections below sit on a plain ground */
    -webkit-mask-image: linear-gradient(to bottom, var(--text-primary) 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, var(--text-primary) 55%, transparent 100%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .hero__name {
    font-size: clamp(var(--fs-40), 6vw, var(--fs-56));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: var(--space-6);
  }

  .hero__pitch {
    font-size: clamp(var(--fs-18), 2vw, var(--fs-22));
    line-height: 1.45;
    color: var(--text-secondary);
    max-width: 34ch;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }

  .hero__stat dd {
    font-size: var(--fs-28);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .hero__stat dt {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  /* Headshot: cropped rectangle with a thin copper border */
  .hero__portrait {
    justify-self: end;
    max-width: 420px;
    padding: var(--space-2);
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .hero__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  /* Spec panel — reads like the key-specs box on a component datasheet */
  .spec {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .spec__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
  }

  .spec__title {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .spec__ref {
    color: var(--accent);
    font-weight: 600;
  }

  .spec__rows {
    display: grid;
  }

  .spec__row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    align-items: baseline;
  }

  .spec__row:last-child {
    border-bottom: 0;
  }

  .spec__row dt {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .spec__row dd {
    font-size: var(--fs-14);
    font-weight: 500;
    color: var(--text-primary);
    min-width: 0;
  }

  .spec__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .spec__chips li {
    margin: 0;
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 400;
    color: var(--text-secondary);
    background: var(--bg-base);
  }

  /* Projects grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: var(--space-6);
  }

  .projects-cta {
    margin-top: var(--space-8);
    text-align: center;
  }

  /* Skills grid */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: var(--space-8);
  }

  .skills-group__title {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  .skills-group__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* CTA section */
  .cta-section {
    padding-block: var(--space-16);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-12);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    flex-wrap: wrap;
  }

  .cta-title {
    font-size: var(--fs-22);
    font-weight: 700;
    margin-block: var(--space-2);
  }

  .cta-body {
    color: var(--text-secondary);
    max-width: 50ch;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-3);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  /* Responsive — on narrow screens the name and pitch come first */
  @media (max-width: 900px) {
    .hero {
      padding-top: calc(var(--nav-height) + var(--space-8));
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .hero__portrait {
      justify-self: start;
      max-width: 320px;
    }
  }

  @media (max-width: 480px) {
    .hero__portrait {
      display: none;
    }

    .spec__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding-inline: var(--space-4);
    }

    .spec__head {
      padding-inline: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .cta-inner {
      padding: var(--space-6);
    }

    .section {
      padding-block: var(--space-16);
    }
  }
</style>
