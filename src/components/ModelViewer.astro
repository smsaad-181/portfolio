---
/**
 * ModelViewer.astro — interactive 3D board (drag to rotate, scroll/pinch to
 * zoom) using Google's <model-viewer>, self-hosted via npm (no CDN).
 * GLBs come from the project's STEP file (converted at import time) and live
 * in public/models/<slug>/. Several boards → tabs that swap the model.
 * The poster (the board's 3D render) shows until the model has loaded.
 */
import { assetUrl, publicFileExists } from "../lib/urls";

export interface Props {
  models: { label: string; src: string; poster?: string | undefined }[];
  title: string;
}

const { models, title } = Astro.props;
const available = models
  .filter((m) => publicFileExists(m.src))
  .map((m) => ({
    label: m.label,
    src: assetUrl(m.src),
    poster: m.poster && publicFileExists(m.poster) ? assetUrl(m.poster) : undefined,
  }));
const first = available[0];
---

{first && (
  <section class="viewer" aria-labelledby="viewer-heading" data-viewer>
    <div class="viewer__head">
      <h2 class="viewer__title" id="viewer-heading">Interactive 3D board</h2>
      {available.length > 1 && (
        <div class="viewer__tabs" role="tablist" aria-label="Choose a board">
          {available.map((m, i) => (
            <button
              type="button"
              role="tab"
              class="viewer__tab"
              aria-selected={i === 0 ? "true" : "false"}
              data-src={m.src}
              data-poster={m.poster}
              data-label={m.label}
            >
              {m.label}
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="viewer__stage">
      <model-viewer
        class="viewer__model"
        src={first.src}
        poster={first.poster}
        alt={`Interactive 3D model of the ${title} PCB${available.length > 1 ? ` — ${first.label}` : ""}`}
        camera-controls
        auto-rotate
        auto-rotate-delay="2500"
        rotation-per-second="18deg"
        interaction-prompt="auto"
        shadow-intensity="0.9"
        shadow-softness="0.8"
        exposure="1.05"
        tone-mapping="neutral"
        camera-orbit="35deg 62deg auto"
        loading="lazy"
        reveal="auto"
        touch-action="pan-y"
      ></model-viewer>
      <p class="viewer__hint" aria-hidden="true">Drag to rotate · Scroll or pinch to zoom</p>
    </div>
  </section>
)}

<script>
  // Load the web component only on pages that show a model.
  if (document.querySelector("[data-viewer]")) {
    import("@google/model-viewer");
  }

  // Board tabs: swap the model and its poster.
  for (const viewer of document.querySelectorAll<HTMLElement>("[data-viewer]")) {
    const model = viewer.querySelector<HTMLElement & { src: string; poster: string; alt: string }>("model-viewer");
    const tabs = viewer.querySelectorAll<HTMLButtonElement>(".viewer__tab");
    const baseAlt = model?.getAttribute("alt")?.split(" — ")[0] ?? "";
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        if (!model) return;
        tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
        if (tab.dataset["poster"]) model.setAttribute("poster", tab.dataset["poster"]);
        model.setAttribute("src", tab.dataset["src"] ?? "");
        model.setAttribute("alt", `${baseAlt} — ${tab.dataset["label"] ?? ""}`);
      })
    );
  }
</script>

<style>
  .viewer {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
  }

  .viewer__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .viewer__title {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  .viewer__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .viewer__tab {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    font: 500 var(--fs-14) var(--font-body);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }

  .viewer__tab:hover {
    color: var(--text-primary);
    border-color: var(--accent);
  }

  .viewer__tab[aria-selected="true"] {
    color: var(--text-primary);
    border-color: var(--accent);
    background: var(--accent-glow);
  }

  .viewer__stage {
    position: relative;
    background:
      radial-gradient(ellipse 70% 70% at 50% 40%, var(--accent-glow), transparent 70%),
      var(--bg-elevated);
  }

  .viewer__model {
    display: block;
    width: 100%;
    height: clamp(320px, 52vw, 540px);
    --poster-color: transparent;
    background: transparent;
  }

  .viewer__hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    transform: translateX(-50%);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg-base) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-secondary);
    pointer-events: none;
    white-space: nowrap;
  }
</style>
