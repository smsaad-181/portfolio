---
/**
 * Nav.astro
 * Top navigation: < Sultan Mahmud Saad /> signature wordmark (same mark as the
 * footer), the page links grouped in a quiet pill with a short gradient
 * marker under the active page, and a round light/dark theme toggle.
 * Transparent until the page scrolls, then gains a blurred backdrop and a
 * hairline. Below 60em (960 px at default text size, wider with larger
 * browser text) it collapses into a <details> menu (works without JS).
 */
import Wordmark from "@components/Wordmark.astro";
import { pageUrl } from "../lib/urls";
import { getPublishedPosts } from "../lib/blog";

const home = pageUrl("/"); // "/portfolio/"
// Blog appears once a post is published (drafts count only in local dev).
const hasPosts = (await getPublishedPosts()).length > 0;

const navLinks = [
  { href: home, label: "Home" },
  { href: pageUrl("/about/"), label: "About" },
  { href: pageUrl("/skills/"), label: "Skills" },
  { href: pageUrl("/projects/"), label: "Projects" },
  ...(hasPosts ? [{ href: pageUrl("/blog/"), label: "Blog" }] : []),
  { href: pageUrl("/resume/"), label: "Resume" },
  { href: pageUrl("/contact/"), label: "Contact" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === home) {
    return currentPath === home || currentPath === home.slice(0, -1);
  }
  return currentPath.startsWith(href);
}
---

<header class="nav-wrapper" role="banner" data-nav>
  <nav class="nav container" aria-label="Primary navigation">
    <a href={home} class="nav__logo" aria-label="Sultan Mahmud Saad — Home">
      <Wordmark />
    </a>

    <div class="nav__right">
      <ul class="nav__links" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={["nav__link", { "nav__link--active": isActive(link.href) }]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <button type="button" class="nav__icon-btn theme-toggle" data-theme-toggle aria-label="Switch to light theme">
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" fill="currentColor" />
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" />
          </g>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" />
        </svg>
      </button>

      <details class="nav__mobile-menu">
        <summary class="nav__icon-btn nav__hamburger" aria-label="Toggle navigation menu">
          <span class="nav__hamburger-bar"></span>
          <span class="nav__hamburger-bar"></span>
          <span class="nav__hamburger-bar"></span>
        </summary>
        <ul class="nav__mobile-links" role="list">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={["nav__mobile-link", { "nav__mobile-link--active": isActive(link.href) }]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // Theme toggle — the initial theme is set inline in BaseLayout's <head>.
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function syncLabel() {
    const isLight = root.getAttribute("data-theme") === "light";
    toggle?.setAttribute("aria-label", isLight ? "Switch to dark theme" : "Switch to light theme");
  }

  toggle?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage unavailable (private mode) — theme still applies for this page */
    }
    syncLabel();
  });
  syncLabel();

  // Mobile menu (<details>): keep keyboard focus inside while open, close on
  // Esc / outside click / choosing a link, and return focus to the button.
  const menu = document.querySelector<HTMLDetailsElement>(".nav__mobile-menu");
  if (menu) {
    const summary = menu.querySelector<HTMLElement>("summary")!;
    const links = () => [...menu.querySelectorAll<HTMLAnchorElement>(".nav__mobile-link")];
    const close = (refocus = true) => {
      if (!menu.open) return;
      menu.open = false;
      if (refocus) summary.focus();
    };
    menu.addEventListener("toggle", () => {
      if (menu.open) links()[0]?.focus();
    });
    menu.addEventListener("keydown", (e) => {
      if (!menu.open) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== "Tab") return;
      const items = [summary, ...links()];
      const first = items[0]!, last = items[items.length - 1]!;
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close(false);
    });
    links().forEach((a) => a.addEventListener("click", () => close(false)));
  }

  // Nav backdrop appears once the page scrolls.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const onScroll = () => nav?.classList.toggle("is-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  /* ── Bar ─────────────────────────────────────────────────────────────── */
  .nav-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
  }

  .nav-wrapper.is-scrolled {
    background: color-mix(in srgb, var(--bg-base) 82%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--border-subtle);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .nav__logo {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-primary);
    text-decoration: none;
  }

  .nav__logo:hover {
    color: var(--text-primary);
  }

  .nav__right {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--space-3);
  }

  /* ── Desktop links: one quiet pill, short gradient marker on the active page ── */
  .nav__links {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: var(--space-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg-surface) 70%, transparent);
  }

  .nav__links li + li {
    margin-top: 0;
  }

  .nav__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--fs-14);
    font-weight: 500;
    line-height: 1;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .nav__link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 1rem;
    height: 2px;
    margin-left: -0.5rem;
    border-radius: var(--radius-pill);
    background: var(--gradient-accent);
    transform: scaleX(0);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .nav__link:focus-visible {
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }

  .nav__link--active,
  .nav__link--active:hover {
    color: var(--text-primary);
  }

  .nav__link--active::after {
    transform: scaleX(1);
  }

  /* ── Round icon buttons (theme toggle, menu button) ──────────────────── */
  .nav__icon-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-surface) 70%, transparent);
    color: var(--text-secondary);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .nav__icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border);
    background: var(--bg-elevated);
  }

  .nav__icon-btn:focus-visible {
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }

  .theme-toggle__icon {
    width: 18px;
    height: 18px;
  }

  .theme-toggle__icon--moon {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-toggle__icon--sun {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-toggle__icon--moon {
    display: block;
  }

  /* ── Mobile menu ─────────────────────────────────────────────────────── */
  .nav__mobile-menu {
    display: none;
    position: relative;
  }

  .nav__hamburger {
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }

  .nav__hamburger::-webkit-details-marker { display: none; }
  .nav__hamburger::marker { display: none; content: ""; }

  .nav__hamburger-bar {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: var(--radius-pill);
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-fast) var(--ease);
  }

  /* Open: bars fold into an ×. */
  .nav__mobile-menu[open] .nav__hamburger {
    color: var(--text-primary);
    border-color: var(--border);
    background: var(--bg-elevated);
  }

  .nav__mobile-menu[open] .nav__hamburger-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__mobile-menu[open] .nav__hamburger-bar:nth-child(2) { opacity: 0; }
  .nav__mobile-menu[open] .nav__hamburger-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav__mobile-links {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    width: min(15rem, calc(100vw - 2 * var(--space-4)));
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transform-origin: top right;
  }

  .nav__mobile-menu[open] .nav__mobile-links {
    animation: nav-menu-in var(--dur-base) var(--ease-out);
  }

  @keyframes nav-menu-in {
    from { opacity: 0; transform: translateY(-4px) scale(0.97); }
  }

  :global(:root.motion-paused) .nav__mobile-menu[open] .nav__mobile-links {
    animation: none;
  }

  .nav__mobile-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--fs-16);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .nav__mobile-link:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .nav__mobile-link:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius-md);
  }

  .nav__mobile-link--active,
  .nav__mobile-link--active:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  /* Active marker in the menu: the same short gradient bar, upright. */
  .nav__mobile-link--active::before {
    content: "";
    width: 3px;
    height: 1rem;
    margin-right: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--gradient-accent);
  }

  /* em, not px: with 125 % browser text the links collapse sooner instead of
     colliding with the logo. */
  @media (max-width: 60em) {
    .nav__links {
      display: none;
    }

    .nav__mobile-menu {
      display: block;
    }

    .nav,
    .nav__right {
      gap: var(--space-2);
    }

    /* 44 px touch targets */
    .nav__icon-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__mobile-menu[open] .nav__mobile-links { animation: none; }
  }
</style>
