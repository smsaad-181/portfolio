---
/**
 * ProjectCard.astro
 * Grid card for a project. Shows: cover image, status, tags, title, the
 * summary, the board versions (when there are several) and a link.
 *
 * Its 6 direct children are the 6 rows of the shared .projects-grid subgrid
 * (global.css), so every card in a row lines up. A project with several
 * board versions is drawn as a small stack of cards with its version names.
 *
 * Cover images live in public/ as plain paths and render through Astro's
 * <Image />, base-prefixed. If the file hasn't been added yet, the image area is omitted (no 404, no
 * placeholder text shown to the public).
 */
import PublicImage from "@components/PublicImage.astro";
import StatusBadge from "@components/StatusBadge.astro";
import TagChip from "@components/TagChip.astro";
import { publicFileExists } from "../lib/urls";

export interface Props {
  title: string;
  /** Base-aware URL from projectUrl(entry). */
  href: string;
  summary: string;
  coverImage: {
    src: string;
    alt: string;
  };
  tags: string[];
  status: "completed" | "in-progress" | "prototype";
  /** Board version names; 2+ shows the stacked look and the version list. */
  versions?: string[];
  /** Above-the-fold cards: load the image immediately (it is often the LCP). */
  priority?: boolean;
  /** 2 on the Projects page (cards follow the h1), 3 under a section h2. */
  headingLevel?: 2 | 3;
}

const { title, href, summary, coverImage, tags, status, versions = [], priority = false, headingLevel = 3 } = Astro.props;
const multi = versions.length > 1;
const Heading = headingLevel === 2 ? "h2" : "h3";
const hasCover = publicFileExists(coverImage.src);
const displayTags = tags.slice(0, 3);
---

<article class:list={["project-card", { "project-card--stack": multi }]} aria-label={title} data-reveal={priority ? undefined : ""} data-tilt>
  {hasCover ? (
    <a href={href} class="project-card__image-link" tabindex="-1" aria-hidden="true">
      <div class="project-card__image-wrap">
        {multi && (
          <span class="project-card__ribbon">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2 1.5 7.5 12 13l10.5-5.5L12 2Zm-8.2 9.6L1.5 12.8 12 18.3l10.5-5.5-2.3-1.2L12 15.9l-8.2-4.3Zm0 5L1.5 17.8 12 23.3l10.5-5.5-2.3-1.2L12 20.9l-8.2-4.3Z" /></svg>
            {versions.length} versions
          </span>
        )}
        <PublicImage
          src={coverImage.src}
          alt={coverImage.alt}
          widths={[360, 540, 720, 960]}
          sizes="(max-width: 700px) calc(100vw - 4rem), (max-width: 1100px) calc(50vw - 4rem), 360px"
          class="project-card__image"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
        />
      </div>
    </a>
  ) : <div aria-hidden="true"></div>}

    <div class="project-card__meta">
      <StatusBadge status={status} />
      <div class="project-card__tags">
        {displayTags.map((tag) => <TagChip tag={tag} />)}
        {tags.length > 3 && (
          <span class="project-card__tags-more">
            +{tags.length - 3}<span class="sr-only"> more tags</span>
          </span>
        )}
      </div>
    </div>

    <Heading class="project-card__title">
      <a href={href} class="project-card__title-link">{title}{multi && <span class="sr-only">, {versions.length} board versions</span>}</a>
    </Heading>

    <p class="project-card__summary">{summary}</p>

    {multi ? (
      <div class="project-card__versions">
        <p class="project-card__versions-label">{versions.length} board versions</p>
        <ul class="project-card__version-list" role="list">
          {versions.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    ) : <div aria-hidden="true"></div>}

    <a href={href} class="project-card__cta" tabindex="-1" aria-hidden="true">
      View project <span class="project-card__cta-arrow" aria-hidden="true">→</span>
    </a>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--dur-base) ease,
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: var(--shadow-md);
  }

  /* Movement only with a real mouse (a tap would leave the card stuck). With
     tilt on, the tilt is the one hover motion — no extra lift or image zoom. */
  @media (hover: hover) and (pointer: fine) {
    :global(:root:not(.tilt-on)) .project-card:hover {
      transform: translateY(-2px);
    }

    :global(:root:not(.tilt-on)) .project-card:hover .project-card__image {
      transform: scale(1.03);
    }
  }

  /* Several board versions: two cards peek out behind this one. */
  .project-card--stack {
    --stack:
      7px 7px 0 -1px var(--bg-surface), 7px 7px 0 0 var(--border),
      14px 14px 0 -2px var(--bg-surface), 14px 14px 0 -1px var(--border);
    box-shadow: var(--stack); /* fits in the grid gap (24 px) */
  }

  .project-card--stack:hover {
    box-shadow: var(--stack), var(--shadow-md);
  }

  .project-card__ribbon {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--gradient-accent);
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 4px 12px var(--accent-glow);
  }

  .project-card__meta,
  .project-card__title,
  .project-card__versions,
  .project-card__summary,
  .project-card__cta {
    padding-inline: var(--space-6);
  }

  .project-card__meta { padding-top: var(--space-4); }
  .project-card__title { padding-top: var(--space-3); }
  .project-card__versions { padding-top: var(--space-3); }
  .project-card__summary { padding-top: var(--space-3); }
  .project-card__cta { padding-block: var(--space-4) var(--space-6); }

  /* In the shared grid: 6 subgrid rows, so cards in a row line up
     (scoped here so it outranks the display: flex above). */
  @supports (grid-template-rows: subgrid) {
    :global(.projects-grid) .project-card {
      display: grid;
      grid-row: span 6;
      grid-template-rows: subgrid;
      row-gap: 0;
    }

    :global(.projects-grid) .project-card__cta {
      align-self: end;
      justify-self: start;
    }
  }

  .project-card__image-link {
    display: block;
  }

  .project-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    padding: var(--space-4);
    /* Whole board visible on a soft glow — PCB renders shouldn't be cropped */
    background:
      radial-gradient(ellipse 70% 70% at 50% 45%, var(--accent-glow), transparent 70%),
      var(--bg-elevated);
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* no CSS drop-shadow: it is costly to paint on phones (16 cards on /projects/) */
    transition: transform var(--dur-slow) var(--ease);
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    align-content: flex-start;
    align-self: start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .project-card__versions-label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .project-card__version-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card__version-list li {
    margin: 0;
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--accent-2) 45%, transparent);
    border-left: 3px solid var(--accent-2);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }

  .project-card__tags-more {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--text-muted);
    padding: 2px 6px;
  }

  .project-card__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .project-card__title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .project-card__title-link:hover {
    color: var(--accent);
  }

  .project-card__summary {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    flex: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0;
  }

  .project-card__cta {
    font-size: var(--fs-14);
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--accent);
    text-decoration: none;
    margin-top: auto;
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    transition: color var(--dur-fast) ease;
  }

  .project-card__cta-arrow {
    display: inline-block;
    transition: transform 160ms var(--ease-out);
  }

  .project-card__cta:hover {
    color: var(--accent-dim);
  }

  .project-card__cta:hover .project-card__cta-arrow {
    transform: translateX(4px);
  }
</style>
