---
/**
 * Contact page — /contact/
 * Availability, email with a copy-to-clipboard button, profile links with real
 * icons, and a Web3Forms message form (labelled fields, honeypot, success and
 * error states). The form only renders when PUBLIC_WEB3FORMS_KEY is set
 * (.env locally, GitHub secret WEB3FORMS_KEY in CI); without it visitors see
 * the email option only — never a broken form.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import { getProfile } from "../lib/profile";

const profile = await getProfile();
const { data } = profile;
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY?.trim() || "";
// Username = last path segment of the profile URL (stays right if the URL changes in the CMS).
const handle = (url: string) => new URL(url).pathname.split("/").filter(Boolean).pop() ?? url;
const links = [
  data.socialLinks.linkedin && { name: "linkedin" as const, title: "LinkedIn", value: handle(data.socialLinks.linkedin), hint: "Professional profile and work history", href: data.socialLinks.linkedin },
  data.socialLinks.github && { name: "github" as const, title: "GitHub", value: handle(data.socialLinks.github), hint: "Profile and public repositories", href: data.socialLinks.github },
  data.socialLinks.oshwlab && { name: "oshwlab" as const, title: "OSHWLab", value: handle(data.socialLinks.oshwlab), hint: "Open-source PCB projects", href: data.socialLinks.oshwlab },
].filter((l): l is { name: "linkedin" | "github" | "oshwlab"; title: string; value: string; hint: string; href: string } => Boolean(l));
---

<BaseLayout title="Contact" description={`Contact ${data.name}, ${data.title} in ${data.location}: email, LinkedIn, GitHub, OSHWLab${formKey ? " or the message form" : ""}.`}>
  <section class="contact" aria-labelledby="contact-title">
    <div class="container contact__inner">
      <header class="contact__head">
        <p class="section-label">// reach out</p>
        <h1 class="contact__title" id="contact-title">Get in touch</h1>
        <p class="contact__lead">
          Hiring for a hardware or embedded role, or have a PCB or IoT project in mind?
          {formKey ? "Send me a message or email me directly." : "Email me directly or reach me on LinkedIn."}
        </p>
        {data.availability && (
          <p class="availability"><span class="availability__dot" aria-hidden="true"></span>{data.availability}</p>
        )}
      </header>

      <div class:list={["contact__grid", { "contact__grid--single": !formKey }]}>
        <div class="contact__ways">
          <!-- Email + copy -->
          <div class="way way--email">
            <span class="way__icon"><Icon name="email" size={22} /></span>
            <div class="way__body">
              <h2 class="way__title">Email</h2>
              <a href={`mailto:${data.email}`} class="way__value" data-email>{data.email}</a>
            </div>
            <button type="button" class="copy" data-copy={data.email} aria-label={`Copy email address ${data.email}`}>
              <span class="copy__idle"><Icon name="copy" size={16} />Copy</span>
              <span class="copy__done" hidden><Icon name="check" size={16} />Copied</span>
            </button>
            <p class="sr-only" aria-live="polite" data-copy-status></p>
          </div>

          {links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="way way--link">
              <span class="way__icon"><Icon name={l.name} size={22} /></span>
              <span class="way__body">
                <span class="way__title">{l.title}<span class="sr-only"> (opens in new tab)</span></span>
                <span class="way__value">{l.value}</span>
                <span class="way__hint">{l.hint}</span>
              </span>
              <span class="way__arrow" aria-hidden="true">→</span>
            </a>
          ))}

          <p class="contact__where"><Icon name="pin" size={16} />Based in {data.location}</p>
        </div>

        {formKey && (
          <form class="form" action="https://api.web3forms.com/submit" method="POST" data-form novalidate>
            <h2 class="form__title">Send a message</h2>
            <input type="hidden" name="access_key" value={formKey} />
            <input type="hidden" name="subject" value={`Portfolio message for ${data.name}`} />
            <input type="hidden" name="from_name" value="Portfolio contact form" />
            <!-- Honeypot: real people never see or fill this -->
            <input type="checkbox" name="botcheck" class="form__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" />
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" />
            </div>
            <div class="field">
              <label for="cf-message">Message</label>
              <textarea id="cf-message" name="message" rows="6" required maxlength="4000"></textarea>
            </div>
            <button type="submit" class="btn btn--primary form__submit"><Icon name="send" size={16} /><span data-submit-label>Send message</span></button>
            <p class="form__status" role="status" aria-live="polite" data-status></p>
          </form>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Copy email to clipboard
  const btn = document.querySelector<HTMLButtonElement>("[data-copy]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  btn?.addEventListener("click", async () => {
    const text = btn.dataset.copy ?? "";
    try {
      await navigator.clipboard.writeText(text);
      btn.querySelector<HTMLElement>(".copy__idle")!.hidden = true;
      btn.querySelector<HTMLElement>(".copy__done")!.hidden = false;
      if (status) status.textContent = "Email address copied";
      setTimeout(() => {
        btn.querySelector<HTMLElement>(".copy__idle")!.hidden = false;
        btn.querySelector<HTMLElement>(".copy__done")!.hidden = true;
      }, 2200);
    } catch {
      if (status) status.textContent = "Copy failed — select the address instead";
    }
  });

  // Contact form: validate, send with fetch, show success / error
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  if (form) {
    const out = form.querySelector<HTMLElement>("[data-status]")!;
    const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const setState = (kind: "" | "ok" | "error", msg: string) => {
      out.textContent = msg;
      out.dataset.state = kind;
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        setState("error", "Please fill in your name, a valid email and a message.");
        return;
      }
      submit.disabled = true;
      label.textContent = "Sending…";
      setState("", "");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          form.reset();
          setState("ok", "Thanks — your message was sent. I'll reply by email.");
        } else {
          setState("error", "The message couldn't be sent. Please try again or email me directly.");
        }
      } catch {
        setState("error", "The message couldn't be sent (network error). Please try again or email me directly.");
      } finally {
        submit.disabled = false;
        label.textContent = "Send message";
      }
    });
  }
</script>

<style>
  .contact {
    padding-block: var(--space-16) var(--space-24);
  }

  .contact__head {
    max-width: 640px;
    margin-bottom: var(--space-10);
  }

  .contact__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: var(--space-2) 0 var(--space-4);
  }

  .contact__lead {
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-6);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-surface);
    font-size: var(--fs-14);
    font-weight: 500;
  }

  .availability__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-completed);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-completed) 20%, transparent);
  }

  .contact__grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .contact__grid--single {
    grid-template-columns: minmax(0, 640px);
  }

  .contact__ways {
    display: grid;
    gap: var(--space-3);
  }

  .way {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    color: inherit;
  }

  .way--link {
    transition: border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
  }

  .way--link:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(-1px);
    color: inherit;
  }

  .way__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: var(--radius-md);
    background: var(--accent-glow);
    color: var(--accent);
  }

  .way__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .way__title {
    font-size: var(--fs-16);
    font-weight: 600;
    margin: 0;
  }

  .way__value {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .way__hint {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .way__arrow {
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .way--link:hover .way__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .copy {
    flex: none;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font: 500 var(--fs-14) var(--font-body);
    cursor: pointer;
  }

  .copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .copy span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .copy span[hidden] {
    display: none;
  }

  .contact__where {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  /* Form */
  .form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .form__title {
    font-size: var(--fs-18);
    font-weight: 600;
    margin: 0;
  }

  .form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-size: var(--fs-14);
    font-weight: 500;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-base);
    color: var(--text-primary);
    font: inherit;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .form__submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .form__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .form__status {
    margin: 0;
    min-height: 1.5em;
    font-size: var(--fs-14);
  }

  .form__status[data-state="ok"] {
    color: var(--status-completed);
  }

  .form__status[data-state="error"] {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .way {
      padding: var(--space-4);
      flex-wrap: wrap;
    }

    .form {
      padding: var(--space-4);
    }
  }
</style>
