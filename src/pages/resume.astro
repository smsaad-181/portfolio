---
/**
 * Resume page — /resume/
 * An HTML CV in the section order of Saad's own CV: summary, education,
 * experience, projects, ongoing projects, skills, training, activities,
 * references. Built from the content collections: profile, experience,
 * education, certifications, plus the resume singleton (CV-only parts).
 * On screen it sits on a paper-like sheet with Download / Print buttons;
 * when printed (or exported by `npm run cv:pdf`) it becomes a clean A4 CV
 * without the site chrome. The PDF in public/resume/ is generated from this
 * page, so both always match. No phone number or referees' contact details
 * (public site).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import { getCollection } from "astro:content";
import { getProfile, getResume, getResumeUrl } from "../lib/profile";
import { getAllProjectIds, getPublishedProjects } from "../lib/projects";
import { getSkillGroups } from "../lib/skills";
import { formatRange } from "../lib/dates";
import { absoluteUrl, pageUrl, projectUrl } from "../lib/urls";
import resumeMeta from "../data/resume.json";

const profile = await getProfile();
const { data } = profile;
const cv = (await getResume()).data;
const resumeUrl = getResumeUrl(profile);
const experiences = (await getCollection("experience")).sort((a, b) => {
  if (a.data.current !== b.data.current) return a.data.current ? -1 : 1;
  return new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();
});
const educations = (await getCollection("education")).sort((a, b) => b.data.year - a.data.year);
const certs = await getCollection("certifications");

// CV projects may link to their project page. An unknown slug fails the build
// (a typo in /admin); a draft project is listed without a link. Links are
// absolute: in the exported PDF a relative link would point at the local
// server that printed it.
const projectIds = await getAllProjectIds();
const published = await getPublishedProjects();
const cvProjects = cv.projects.map((p) => {
  const slug = p.project?.trim();
  if (slug && !projectIds.has(slug)) {
    throw new Error(`src/content/resume/cv.json: project "${p.title}" links to unknown project "${slug}"`);
  }
  const entry = slug ? published.find((e) => e.id === slug) : undefined;
  return { ...p, href: entry ? absoluteUrl(projectUrl(entry)) : undefined };
});
const workProjects = cvProjects.filter((p) => !p.ongoing);
const ongoingProjects = cvProjects.filter((p) => p.ongoing);

// Skills as on the CV; falls back to the site's skill groups if left empty.
const skillRows = cv.skills.length
  ? cv.skills
  : (await getSkillGroups()).map((g) => ({ label: g.label, items: g.skills.map((s) => s.skill.data.name).join(", ") }));

const portfolio = absoluteUrl(pageUrl("/"));
const projectsPage = absoluteUrl(pageUrl("/projects/"));
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const years = (e: (typeof educations)[number]) => (e.data.startYear ? `${e.data.startYear} – ${e.data.year}` : String(e.data.year));
const updated = new Date(resumeMeta.updated).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<BaseLayout title="Resume" description={`CV of ${cv.name}, ${data.title} in ${data.location}: experience, projects, skills and education.`}>
  <section class="resume" aria-labelledby="resume-heading">
    <div class="container">
      <div class="resume-bar">
        <div>
          <p class="section-label">// cv</p>
          <h1 class="resume-bar__title" id="resume-heading">Resume</h1>
          <p class="resume-bar__updated">Last updated: <time datetime={resumeMeta.updated}>{updated}</time></p>
        </div>
        <div class="resume-bar__actions">
          {resumeUrl && (
            <a href={resumeUrl} download class="btn btn--primary"><Icon name="download" />Download PDF</a>
          )}
          <button type="button" class="btn btn--secondary" data-print><Icon name="print" />Print</button>
        </div>
      </div>

      <article class="cv" aria-label={`CV of ${cv.name}`}>
        <header class="cv__head">
          <div>
            <h2 class="cv__name">{cv.name}</h2>
            <p class="cv__title">{data.title}</p>
          </div>
          <ul class="cv__contact" role="list">
            <li>{data.location}</li>
            <li><a href={`mailto:${data.email}`}>{data.email}</a></li>
            {data.socialLinks.linkedin && <li><a href={data.socialLinks.linkedin}>{host(data.socialLinks.linkedin)}</a></li>}
            {data.socialLinks.github && <li><a href={data.socialLinks.github}>{host(data.socialLinks.github)}</a></li>}
            {data.socialLinks.oshwlab && <li><a href={data.socialLinks.oshwlab}>{host(data.socialLinks.oshwlab)}</a></li>}
            <li><a href={portfolio}>{host(portfolio)}</a></li>
          </ul>
        </header>

        <section class="cv__section">
          <h3 class="cv__h">Professional summary</h3>
          <p>{cv.summary}</p>
          {data.availability && <p class="cv__avail">{data.availability}</p>}
        </section>

        <section class="cv__section">
          <h3 class="cv__h">Education</h3>
          {educations.map((e) => (
            <div class="cv__item cv__item--tight">
              <div class="cv__row">
                <p class="cv__strong">{e.data.institute}</p>
                <p class="cv__date">{years(e)}</p>
              </div>
              <p class="cv__muted">{e.data.degree}{e.data.group && ` in ${e.data.group}`}{e.data.result && ` · ${e.data.result}`}</p>
            </div>
          ))}
        </section>

        <section class="cv__section">
          <h3 class="cv__h">Work experience</h3>
          {experiences.map((e) => (
            <div class="cv__item">
              <div class="cv__row">
                <p class="cv__strong">{e.data.company}</p>
                <p class="cv__date">{formatRange(e.data.startDate, e.data.endDate, e.data.current)}</p>
              </div>
              <p class="cv__role">{e.data.role}</p>
              {e.data.achievements.length > 0 && <p class="cv__sub">Responsibilities</p>}
              <ul class="cv__bullets">
                {e.data.bullets.map((b) => <li>{b}</li>)}
              </ul>
              {e.data.achievements.length > 0 && (
                <Fragment>
                  <p class="cv__sub">Achievements</p>
                  <ul class="cv__bullets">
                    {e.data.achievements.map((b) => <li>{b}</li>)}
                  </ul>
                </Fragment>
              )}
            </div>
          ))}
        </section>

        {[
          { heading: "Projects", items: workProjects },
          { heading: "Ongoing projects", items: ongoingProjects },
        ].filter((s) => s.items.length > 0).map((s) => (
          <section class="cv__section">
            <h3 class="cv__h">{s.heading}</h3>
            {s.items.map((p) => (
              <div class="cv__item">
                <div class="cv__row">
                  <p class="cv__strong">{p.href ? <a href={p.href}>{p.title}</a> : p.title}</p>
                  {p.note && <p class="cv__note">{p.note}</p>}
                </div>
                {p.tech && <p class="cv__tech">Technologies: {p.tech}</p>}
                <ul class="cv__bullets">
                  {p.bullets.map((b) => <li>{b}</li>)}
                  {p.objective && <li><b>Objective:</b> {p.objective}</li>}
                  {p.use && <li><b>Real-world use:</b> {p.use}</li>}
                </ul>
              </div>
            ))}
            {s.items === ongoingProjects && (
              <p class="cv__muted cv__small">Interactive 3D boards and full write-ups: <a href={projectsPage}>{host(projectsPage)}/</a></p>
            )}
          </section>
        ))}

        <section class="cv__section">
          <h3 class="cv__h">Technical skills</h3>
          <dl class="cv__skills">
            {skillRows.map((r) => (
              <div class="cv__skillrow">
                <dt>{r.label}</dt>
                <dd>{r.items}</dd>
              </div>
            ))}
          </dl>
        </section>

        {(certs.length > 0 || cv.activities.length > 0) && (
          <section class="cv__section cv__two">
            {certs.length > 0 && (
              <div>
                <h3 class="cv__h">Training courses</h3>
                <ul class="cv__bullets">
                  {certs.map((c) => <li>{c.data.name}{c.data.issuer && <span class="cv__muted"> — {c.data.issuer}</span>}</li>)}
                </ul>
              </div>
            )}
            {(cv.activities.length > 0 || cv.references) && (
              <div>
                {cv.activities.length > 0 && (
                  <Fragment>
                    <h3 class="cv__h">Extracurricular activities</h3>
                    <ul class="cv__bullets">
                      {cv.activities.map((a) => <li>{a}</li>)}
                    </ul>
                  </Fragment>
                )}
                {cv.references && (
                  <Fragment>
                    <h3 class="cv__h cv__h--next">References</h3>
                    <p>{cv.references}</p>
                  </Fragment>
                )}
              </div>
            )}
          </section>
        )}
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>

<style>
  .resume {
    padding-block: var(--space-12) var(--space-16);
  }

  .resume-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .resume-bar__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: var(--space-2) 0 var(--space-1);
  }

  .resume-bar__updated {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .resume-bar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .resume-bar__actions .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* ── The CV sheet (paper colours in both themes) ───────────────────────── */
  .cv {
    max-width: 210mm;
    margin-inline: auto;
    padding: 14mm;
    background: var(--paper-bg);
    color: var(--paper-text);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-size: 9.4pt;
    line-height: 1.4;
  }

  .cv p {
    margin: 0;
  }

  .cv a {
    color: var(--paper-text);
    text-decoration: underline;
    text-decoration-color: var(--paper-rule);
    text-underline-offset: 2px;
  }

  /* Wraps the contact block under the name when the sheet is too narrow */
  .cv__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6mm;
    padding-bottom: 4mm;
    border-bottom: 2px solid var(--paper-accent);
    margin-bottom: 4mm;
  }

  .cv__name {
    font-size: 20pt;
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    color: var(--paper-text);
  }

  .cv__title {
    margin-top: 1mm;
    font-size: 11pt;
    font-weight: 500;
    color: var(--paper-accent);
  }

  /* Two columns × three rows, so the header stays as short as the name block */
  .cv__contact {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: end;
    column-gap: 5mm;
    row-gap: 0.5mm;
    text-align: right;
    font-size: 8.5pt;
    color: var(--paper-muted);
  }

  .cv__contact li {
    white-space: nowrap;
  }

  .cv__section {
    margin-top: 3.2mm;
  }

  .cv__h {
    font-family: var(--font-mono);
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-accent);
    margin: 0 0 2mm;
    padding-bottom: 1mm;
    border-bottom: 1px solid var(--paper-rule);
  }

  .cv__h--next {
    margin-top: 3.2mm;
  }

  .cv__avail {
    margin-top: 1.5mm !important;
    font-weight: 600;
  }

  .cv__item {
    margin-bottom: 2.5mm;
    break-inside: avoid;
  }

  .cv__item--tight {
    margin-bottom: 1.8mm;
  }

  .cv__row {
    display: flex;
    justify-content: space-between;
    gap: 4mm;
  }

  .cv__strong {
    font-weight: 600;
  }

  .cv__date {
    font-family: var(--font-mono);
    font-size: 8.5pt;
    color: var(--paper-muted);
    white-space: nowrap;
  }

  .cv__note {
    font-size: 8.5pt;
    font-style: italic;
    color: var(--paper-muted);
    white-space: nowrap;
  }

  .cv__role {
    font-style: italic;
    color: var(--paper-muted);
  }

  .cv__sub {
    margin-top: 1mm !important;
    font-size: 8.5pt;
    font-weight: 600;
    font-style: italic;
  }

  .cv__tech {
    font-size: 8.5pt;
    font-style: italic;
    color: var(--paper-muted);
  }

  .cv__bullets b {
    font-weight: 600;
  }

  .cv__muted {
    color: var(--paper-muted);
  }

  .cv__small {
    margin-top: 1mm !important;
    font-size: 8.5pt;
  }

  .cv__bullets {
    margin: 1mm 0 0;
    padding-left: 4.5mm;
  }

  .cv__bullets li + li {
    margin-top: 0.6mm;
  }

  .cv__skills {
    margin: 0;
    display: grid;
    gap: 1mm;
  }

  .cv__skillrow {
    display: grid;
    grid-template-columns: 42mm 1fr;
    gap: 3mm;
  }

  .cv__skillrow dt {
    font-weight: 600;
  }

  .cv__skillrow dd {
    margin: 0;
    color: var(--paper-muted);
  }

  .cv__two {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 8mm;
  }

  /* Phone layout on screens only — the A4 print area is also under 720 px wide */
  @media screen and (max-width: 720px) {
    .cv {
      padding: var(--space-6) var(--space-4);
    }

    .cv__head,
    .cv__row {
      flex-direction: column;
      gap: var(--space-2);
    }

    .cv__contact {
      grid-template-columns: 1fr;
      justify-content: start;
      text-align: left;
    }

    /* Long labels typed in /admin wrap instead of widening the page */
    .cv__contact li,
    .cv__note {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .cv__skillrow,
    .cv__two {
      grid-template-columns: 1fr;
    }
  }

  /* ── Print: only the CV sheet, A4 ──────────────────────────────────────── */
  @page {
    size: A4;
    margin: 7mm 13mm 6mm;
  }

  @media print {
    :global(.nav-wrapper),
    :global(.footer),
    :global(.skip-link),
    .resume-bar {
      display: none !important;
    }

    :global(html),
    :global(body) {
      background: var(--paper-bg) !important;
    }

    .resume {
      padding: 0;
    }

    .resume :global(.container) {
      max-width: none;
      padding: 0;
    }

    .cv {
      max-width: none;
      border-radius: 0;
      box-shadow: none;
      font-size: 9.2pt;
      line-height: 1.34;
      padding: 0;
    }
  }
</style>
