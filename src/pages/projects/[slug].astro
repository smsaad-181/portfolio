---
/**
 * Project detail page — /projects/[slug]/
 * Header (status, role, title, summary, tags) + key-specs card, the
 * interactive 3D board(s), the MDX write-up (Overview → Features), board
 * renders (3D renders only), Outcome (dashboard screenshots, only when the
 * project has one) and previous/next navigation. Drafts never get a page.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import StatusBadge from "@components/StatusBadge.astro";
import TagChip from "@components/TagChip.astro";
import BoardViewer from "@components/BoardViewer.astro";
import PublicImage from "@components/PublicImage.astro";
import { render } from "astro:content";
import { getPublishedProjects } from "../../lib/projects";
import { publicImageSize } from "../../lib/images";
import { toJsonLd } from "../../lib/jsonld";
import { getProfile } from "../../lib/profile";
import { formatTag } from "../../lib/tags";
import { absoluteUrl, assetUrl, pageUrl, projectSlug, projectUrl, publicFileExists } from "../../lib/urls";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const projects = await getPublishedProjects();
  return projects.map((project, i) => ({
    params: { slug: projectSlug(project) },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const siteUrl = absoluteUrl(pageUrl("/"));
const canonicalProjectUrl = absoluteUrl(projectUrl(project));

// Only images that exist are rendered — never a 404 or a placeholder.
const cover = publicFileExists(data.coverImage.src) ? data.coverImage : null;
const coverAbsoluteUrl = cover ? absoluteUrl(assetUrl(cover.src)) : undefined;
// Per-project social preview (src/pages/images/og/[slug].png.ts)
const ogImageUrl = absoluteUrl(assetUrl(`/images/og/${projectSlug(project)}.png`));
const gallery = (
  await Promise.all(
    data.gallery.map(async (img) => {
      const size = await publicImageSize(img.src);
      return size ? { ...img, ...size } : null;
    })
  )
).filter((g): g is NonNullable<typeof g> => g !== null);
// Board revisions (e.g. Home Automation V1 / V2.1 / V2.2): only images that exist.
const versions = await Promise.all(
  data.versions.map(async (v) => {
    const size = v.image ? await publicImageSize(v.image.src) : null;
    return { ...v, img: v.image && size ? { ...v.image, ...size } : null, has3d: !!v.model && data.models.some((m) => m.label === v.model && publicFileExists(m.src)) };
  })
);
// Board renders not already on the page (header cover, version cards), so
// the same board picture never shows twice.
const shownAbove = new Set([cover?.src, ...(versions.length > 1 ? versions.map((v) => v.img?.src) : [])]);
const renders = gallery.filter((g) => g.kind === "render" && !shownAbove.has(g.src));
const dashboards = gallery.filter((g) => g.kind === "dashboard");

const statusLabel = { completed: "Completed", "in-progress": "In progress", prototype: "Prototype" } as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: data.title,
  description: data.summary,
  url: canonicalProjectUrl,
  keywords: data.tags.map(formatTag).join(", "),
  creator: { "@type": "Person", name: (await getProfile()).data.name, url: siteUrl },
  ...(coverAbsoluteUrl && { image: coverAbsoluteUrl }),
};
---

<BaseLayout title={data.title} description={data.summary} ogImage={ogImageUrl} ogImageAlt={`${data.title} — PCB project by Sultan Mahmud Saad`} ogType="article">
  <script is:inline slot="head" type="application/ld+json" set:html={toJsonLd(jsonLd)} />

  <nav class="breadcrumb container" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href={pageUrl("/")}>Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={pageUrl("/projects/")}>Projects</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{data.title}</li>
    </ol>
  </nav>

  <article class="project" aria-labelledby="project-title">
    <!-- Header -->
    <header class="project-head container">
      <div class="project-head__main">
        <div class="project-head__meta">
          <StatusBadge status={data.status} />
          {data.role && <span class="project-head__role">{data.role}</span>}
        </div>
        <h1 class="project-head__title" id="project-title">{data.title}</h1>
        <p class="project-head__summary">{data.summary}</p>
        {data.tags.length > 0 && (
          <div class="project-head__tags" role="group" aria-label="Technologies">
            {data.tags.map((tag) => <TagChip tag={tag} />)}
          </div>
        )}
        {(data.links.oshwlab || data.links.liveDemo) && (
          <div class="project-head__links">
            {data.links.oshwlab && (
              <a href={data.links.oshwlab} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">OSHWLab<span class="sr-only"> (opens in new tab)</span></a>
            )}
            {data.links.liveDemo && (
              <a href={data.links.liveDemo} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">Live demo<span class="sr-only"> (opens in new tab)</span></a>
            )}
          </div>
        )}
      </div>

      {(data.specs.length > 0 || cover) && (
        <aside class="spec-card" aria-label="Key specifications">
          {cover && (
            <a href={assetUrl(cover.src)} target="_blank" rel="noopener" class="spec-card__img-link" aria-label={`Open full-size image: ${cover.alt} (opens in new tab)`}>
              <PublicImage
                src={cover.src}
                alt={cover.alt}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) calc(100vw - 2rem), 460px"
                class="spec-card__img"
                loading="eager"
                fetchpriority="high"
              />
            </a>
          )}
          {data.specs.length > 0 && (
            <dl class="spec-card__list">
              <div class="spec-card__row">
                <dt>Status</dt>
                <dd>{statusLabel[data.status]}</dd>
              </div>
              {data.specs.map((s) => (
                <div class="spec-card__row">
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </aside>
      )}
    </header>

    <!-- Versions: one card per board revision -->
    {versions.length > 1 && (
      <section class="container project-section" aria-labelledby="versions-heading">
        <h2 class="section-title" id="versions-heading">Versions</h2>
        <p class="section-lead">This project has {versions.length} board versions. Each card shows what is different; open one in the 3D viewer below.</p>
        <ol class="versions" role="list">
          {versions.map((v, i) => (
            <li class="version">
              {v.img && (
                <div class="version__img">
                  <PublicImage src={v.img.src} alt={v.img.alt} widths={[360, 540, 720]} sizes="(max-width: 700px) calc(100vw - 4rem), 360px" />
                </div>
              )}
              <div class="version__body">
                <p class="version__num">Version {i + 1}</p>
                <h3 class="version__title">{v.label}</h3>
                <p class="version__summary">{v.summary}</p>
                {v.highlights.length > 0 && (
                  <ul class="version__list">
                    {v.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
                {v.has3d && (
                  <button type="button" class="btn btn--secondary version__btn" data-select-board={v.model}>View in 3D <span aria-hidden="true">↓</span></button>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Interactive 3D board(s) -->
    {data.models.length > 0 && (
      <div class="container project-section">
        <BoardViewer models={data.models} title={data.title} />
      </div>
    )}

    <!-- Write-up -->
    <div class="container project-section">
      <div class="prose project-prose">
        <Content />
      </div>
    </div>

    <!-- Board renders: the 3D renders exported from EasyEDA -->
    {renders.length > 0 && (
      <section class="container project-section" aria-labelledby="renders-heading">
        <h2 class="section-title" id="renders-heading">Board renders</h2>
        <div class:list={["gallery", { "gallery--single": renders.length === 1 }]}>
          {renders.map((img) => (
            <figure class="gallery__item">
              <a href={assetUrl(img.src)} target="_blank" rel="noopener" class="gallery__link" aria-label={`Open full-size image: ${img.caption ?? img.alt} (opens in new tab)`}>
                <PublicImage src={img.src} alt={img.alt} widths={[400, 760, 1140, 1520]} sizes={renders.length === 1 ? "(max-width: 800px) calc(100vw - 2rem), 608px" : "(max-width: 700px) calc(100vw - 2rem), 380px"} class="gallery__img" />
              </a>
              {img.caption && <figcaption class="gallery__caption">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Outcome: dashboard screenshots, only when the project has one -->
    {dashboards.length > 0 && (
      <section class="container project-section" aria-labelledby="outcome-heading">
        <h2 class="section-title" id="outcome-heading">Outcome</h2>
        <p class="section-lead">How the project's dashboard looks.</p>
        <div class:list={["dashboards", { "dashboards--phone": dashboards.every((d) => d.height > d.width * 1.6) }]}>
          {dashboards.map((img) => (
            <figure class="dashboard">
              <a href={assetUrl(img.src)} target="_blank" rel="noopener" class="dashboard__link" aria-label={`Open full-size image: ${img.caption ?? img.alt} (opens in new tab)`}>
                <PublicImage src={img.src} alt={img.alt} widths={[390, 800, 1200, 1600]} sizes={dashboards.length > 1 ? "320px" : "(max-width: 900px) calc(100vw - 2rem), 560px"} class="dashboard__img" />
              </a>
              {img.caption && <figcaption class="gallery__caption">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Previous / next -->
    <div class="container">
    <nav class="project-nav" aria-label="More projects">
      {prev ? (
        <a href={projectUrl(prev)} class="project-nav__link">
          <span class="project-nav__dir"><span aria-hidden="true">←</span> Previous</span>
          <span class="project-nav__name">{prev.data.title}</span>
        </a>
      ) : <span />}
      <a href={pageUrl("/projects/")} class="project-nav__all">All projects</a>
      {next ? (
        <a href={projectUrl(next)} class="project-nav__link project-nav__link--next">
          <span class="project-nav__dir">Next <span aria-hidden="true">→</span></span>
          <span class="project-nav__name">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    padding-block: var(--space-4);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .breadcrumb li + li {
    margin-top: 0;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb [aria-current="page"] {
    color: var(--text-primary);
  }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .project-head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
    padding-block: var(--space-8) var(--space-12);
  }

  .project-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .project-head__role {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .project-head__title {
    font-size: clamp(var(--fs-28), 4.5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: var(--space-4);
    background: var(--gradient-name);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .project-head__summary {
    font-size: var(--fs-18);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }

  .project-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .project-head__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Key specs card */
  .spec-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .spec-card__img-link {
    display: block;
  }

  .spec-card__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    box-sizing: border-box;
    padding: var(--space-4);
    background:
      radial-gradient(ellipse 70% 70% at 50% 45%, var(--accent-glow), transparent 70%),
      var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .spec-card__list {
    display: grid;
  }

  .spec-card__row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    align-items: baseline;
  }

  .spec-card__row:last-child {
    border-bottom: 0;
  }

  .spec-card__row dt {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }

  .spec-card__row dd {
    font-size: var(--fs-14);
    font-weight: 500;
    color: var(--text-primary);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* ── Sections ───────────────────────────────────────────────────────── */
  .project-section {
    margin-bottom: var(--space-16);
  }

  .project-prose {
    max-width: 78ch;
  }

  /* Same look as the write-up's h2 headings */
  /* Versions */
  .versions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .versions > li + li {
    margin-top: 0;
  }

  .version {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
  }

  .version__img {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 70% at 50% 45%, var(--accent-glow), transparent 70%),
      var(--bg-elevated);
  }

  /* Fixed box: tall boards (e.g. the L-shaped V1.2) scale down instead of stretching the card */
  .version__img :global(img) {
    position: absolute;
    inset: var(--space-4);
    width: calc(100% - 2 * var(--space-4));
    height: calc(100% - 2 * var(--space-4));
    object-fit: contain;
  }

  .version__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6) var(--space-6);
  }

  .version__num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .version__title {
    margin: 0;
    font-size: var(--fs-18);
    font-weight: 600;
  }

  .version__summary {
    margin: 0;
    color: var(--text-secondary);
  }

  .version__list {
    margin: var(--space-2) 0 var(--space-4);
    padding-left: 1.2em;
    font-size: var(--fs-14);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .version__list li + li {
    margin-top: var(--space-1);
  }

  .version__btn {
    margin-top: auto;
    align-self: flex-start;
  }

  .section-title {
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .section-lead {
    margin: calc(-1 * var(--space-3)) 0 var(--space-6);
    color: var(--text-secondary);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-6);
  }

  /* One render: show it large rather than as a small card */
  .gallery--single {
    grid-template-columns: minmax(0, 38rem); /* same width as the write-up */
  }

  .gallery__item,
  .dashboard {
    margin: 0;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .gallery__link {
    display: block;
    background: var(--bg-elevated);
  }

  .gallery__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    transition: transform var(--dur-slow) var(--ease);
  }

  .gallery__link:hover .gallery__img {
    transform: scale(1.03);
  }

  .gallery__caption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .dashboards {
    display: grid;
    gap: var(--space-6);
  }

  /* Phone-layout screenshots sit side by side at phone width */
  .dashboards--phone {
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 320px));
  }

  .dashboard__link {
    display: block;
    background: var(--bg-elevated);
  }

  .dashboard__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Prev / next ────────────────────────────────────────────────────── */
  .project-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-8) var(--space-4);
    border-top: 1px solid var(--border);
  }

  .project-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    color: var(--text-primary);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .project-nav__link:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .project-nav__link--next {
    text-align: right;
  }

  .project-nav__dir {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--accent);
  }

  .project-nav__name {
    font-weight: 500;
  }

  .project-nav__all {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
  }

  @media (max-width: 900px) {
    .project-head {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .project-nav {
      grid-template-columns: 1fr;
    }

    .project-nav__link--next {
      text-align: left;
    }

    .project-nav__all {
      order: 3;
      text-align: center;
    }

    .spec-card__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding-inline: var(--space-4);
    }
  }
</style>
