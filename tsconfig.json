{
  "extends": "astro/tsconfigs/strictest",
  // dist/ is build output.
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    // No baseUrl: deprecated in TypeScript 6. Paths resolve from this file.
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@content/*": ["./src/content/*"],
      "@styles/*": ["./src/styles/*"]
    }
  }
}
